extends Node
## 苍鸿觉醒终结技「一线天」的镜头（2026-11-25 第三轮，用户：「大招也没有特殊的镜头表现」）。
## 结构照觉醒演出（scripts/awaken_cine.gd）和用户给的参考视频里那段大招：压黑边、贴着剑的近景蓄势 → 出剑那一下一张黑白冲击帧、
## 切到侧后方的大远景看那一线铺出去 → 一线挂着的那半拍镜头缓缓推 → 齐断时再一张反白的冲击帧 + 题字 → 混回跟随机位。
## 画面过的是觉醒演出那个着色器（shaders/manga_frame.gdshader：黑边 / 漫画帧 / 压暗）。只有放招的人自己看得到；
## 普通技能不走这个（规矩没变：平时出招不切镜头、不闪屏）。`--no-awk-cine` 一并关掉。
## 时间点由技能脚本给：建出来 = 开始蓄势，cut() = 横抹那一下，split() = 齐断。故意不写 class_name。

const Combat := preload("res://scripts/combat.gd")
const Sfx := preload("res://scripts/sfx.gd")
const UiStyle := preload("res://scripts/ink_style.gd")
const SHADER := preload("res://shaders/manga_frame.gdshader")

const BAR := 0.085
const CUT_FRAME := 0.1        # 出剑的那张冲击帧停多久
const SPLIT_FRAME := 0.13     # 齐断的那张
const RELEASE := 0.55
const CHARGE_MAX := 1.3       # 等不到 cut() 就自己收
const HOLD_MAX := 1.6

static var played := 0        # 自检用
static var frames := 0        # 自检用：最近一回漫画帧画了几帧

var player: Player
var air: Node
var title := "一线天"
var col := Color(1.0, 0.13, 0.1)

var _phase := 0               # 0 蓄势 · 1 出剑冲击帧 · 2 远景挂线 · 3 齐断冲击帧 · 4 放开
var _pt := 0.0
var _fwd := Vector3.FORWARD
var _right := Vector3.RIGHT
var _layer: CanvasLayer
var _rect: ColorRect
var _mat: ShaderMaterial
var _lab: Label
var _bar := 0.0
var _n := 0


func _ready() -> void:
	process_priority = 20
	_fwd = air._fwd()
	_right = _fwd.cross(Vector3.UP).normalized()
	_layer = CanvasLayer.new()
	_layer.layer = 30
	add_child(_layer)
	_mat = ShaderMaterial.new()
	_mat.shader = SHADER
	_mat.set_shader_parameter("sil", 0.0)
	_rect = ColorRect.new()
	_rect.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_rect.material = _mat
	_layer.add_child(_rect)
	_lab = Label.new()
	_lab.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_lab.visible = false
	_lab.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_lab.add_theme_font_override("font", UiStyle.brush())
	_layer.add_child(_lab)
	played += 1
	_apply()


func _exit_tree() -> void:
	if is_instance_valid(player) and player.cam != null:
		player.cam.cine_k = 0.0


## 横抹的那一下
func cut() -> void:
	if _phase != 0:
		return
	_phase = 1
	_pt = 0.0
	Combat.hitstop(CUT_FRAME, 0.0)
	player.cam.add_trauma(0.3)


## 一线齐断
func split() -> void:
	if _phase >= 3:
		return
	_phase = 3
	_pt = 0.0
	Combat.hitstop(SPLIT_FRAME, 0.0)
	Sfx.play("punch_heavy", -2.0, 0.6)


func _alive() -> bool:
	return is_instance_valid(player) and not player.dead and player.st == Player.St.AIR and not player.ult.active


func _process(dt: float) -> void:
	if not _alive():
		_finish()
		return
	_pt += dt
	match _phase:
		0:
			if _pt >= CHARGE_MAX or (_pt > 0.15 and air.state != air.A.ATTACK):
				_finish()
				return
		1:
			if _pt >= CUT_FRAME:
				_phase = 2
				_pt = 0.0
		2:
			if _pt >= HOLD_MAX:
				_phase = 4
				_pt = 0.0
		3:
			if _pt >= SPLIT_FRAME:
				_phase = 4
				_pt = 0.0
		4:
			if _pt >= RELEASE:
				_finish()
				return
	_apply()


func _finish() -> void:
	frames = _n
	queue_free()


static func _ease(u: float) -> float:
	u = clampf(u, 0.0, 1.0)
	return 1.0 - (1.0 - u) * (1.0 - u)


static func _xf(eye: Vector3, look: Vector3, roll: float) -> Transform3D:
	var f := look - eye
	if f.length_squared() < 1e-4:
		f = Vector3.FORWARD
	var up := Vector3.UP if absf(f.normalized().dot(Vector3.UP)) < 0.97 else Vector3.BACK
	return Transform3D(Basis.looking_at(f, up) * Basis(Vector3.BACK, roll), eye)


## 机位别进墙 / 进地：不行就往人身上收，再不行这一拍不接管镜头
func _fit(c: Vector3, eye: Vector3) -> Vector3:
	for sk: float in [1.0, 0.7, 0.45]:
		var e := c + (eye - c) * sk
		var fy := -1e9
		if player.cam.floor_fn.is_valid():
			fy = float(player.cam.floor_fn.call(e.x, e.z))
		e.y = maxf(e.y, fy + 0.3)
		if player.solid_hit(c, e, 0.4, 0.5, 0.0) == Vector3.INF:
			return e
	return Vector3.INF


func _apply() -> void:
	var cam := player.cam
	var c := player.center()
	var vs := get_viewport().get_visible_rect().size
	var ddt := get_process_delta_time()
	var eye := Vector3.ZERO
	var look := c
	var fov := 40.0
	var roll := 0.0
	var k := 0.0
	var inv := 0.0
	var lines := 0.0
	var dim := 0.0
	var ck := 1.0
	var show_title := false
	match _phase:
		0:
			# 贴着剑的低机位近景：人藏锋蹲着，剑在左腰 —— 机位在他左前方，慢慢推近；画面压暗、只留一点红
			var u := _ease(_pt / 0.5)
			eye = c + _fwd * lerpf(2.9, 2.0, u) - _right * lerpf(1.7, 1.25, u) + Vector3.UP * lerpf(-0.2, -0.45, u)
			look = c - _right * 0.25 + Vector3.UP * 0.05
			fov = lerpf(42.0, 32.0, u)
			roll = lerpf(0.0, -0.1, u)
			dim = clampf(_pt / 0.18, 0.0, 1.0) * 0.75
			_bar = move_toward(_bar, BAR, ddt / 0.12 * BAR)
		1:
			# 出剑：侧面的全身，剑光横着铺满画面
			eye = c + _right * 6.5 + _fwd * 2.5 + Vector3.UP * 0.9
			look = c + _fwd * 3.5 + Vector3.UP * 0.2
			fov = 62.0
			roll = 0.12
			k = 1.0
			lines = 0.9
			_n += 1
		2:
			# 身后高处的大远景：一线铺在面前，镜头缓缓往前推
			var u2 := clampf(_pt / 0.8, 0.0, 1.0)
			eye = c - _fwd * lerpf(7.5, 6.2, u2) + _right * 2.4 + Vector3.UP * lerpf(3.8, 3.2, u2)
			look = c + _fwd * 9.0 + Vector3.UP * 0.3
			fov = lerpf(70.0, 64.0, u2)
			dim = 0.35
		3:
			eye = c - _fwd * 6.2 + _right * 2.4 + Vector3.UP * 3.2
			look = c + _fwd * 9.0 + Vector3.UP * 0.3
			fov = 76.0
			roll = -0.08
			k = 1.0
			inv = 1.0
			lines = 1.0
			show_title = true
			_n += 1
		4:
			var u4 := _ease(_pt / RELEASE)
			eye = c - _fwd * lerpf(6.2, 7.0, u4) + _right * lerpf(2.4, 0.8, u4) + Vector3.UP * lerpf(3.2, 2.6, u4)
			look = c + _fwd * lerpf(9.0, 4.0, u4) + Vector3.UP * 0.3
			fov = lerpf(72.0, cam.BASE_FOV, u4)
			ck = clampf((RELEASE - _pt) / 0.3, 0.0, 1.0)
			_bar = move_toward(_bar, 0.0, ddt / 0.25 * BAR)
			show_title = _pt < 0.35
	var fit := _fit(c, eye)
	if fit == Vector3.INF:
		cam.cine_k = 0.0
	else:
		cam.cine_xf = _xf(fit, look, roll)
		cam.cine_fov = fov
		cam.cine_k = ck
	_mat.set_shader_parameter("k", k)
	_mat.set_shader_parameter("invert", inv)
	_mat.set_shader_parameter("lines", lines)
	_mat.set_shader_parameter("seed", 5.0 + float(_phase))
	_mat.set_shader_parameter("center", Vector2(0.5, 0.52))
	_mat.set_shader_parameter("aspect", vs.x / maxf(vs.y, 1.0))
	_mat.set_shader_parameter("bars", _bar)
	_mat.set_shader_parameter("dim", dim)
	_mat.set_shader_parameter("dim_tint", Color(col.r, col.g * 0.5, col.b * 0.5))
	_rect.visible = k > 0.001 or _bar > 0.001 or dim > 0.001
	_title_show(show_title, vs, inv > 0.5, k)


## 题字：竖着写（同觉醒演出），触屏时挪到左侧
func _title_show(on: bool, vs: Vector2, inverted: bool, k: float) -> void:
	if not on or title == "":
		_lab.visible = false
		return
	var n := title.length()
	var fs := int(vs.y * minf(0.2, 0.74 / float(n)))
	if not _lab.visible:
		_lab.text = "\n".join(title.split(""))
		_lab.add_theme_font_size_override("font_size", fs)
		_lab.add_theme_constant_override("line_spacing", -int(float(fs) * 0.16))
		_lab.add_theme_constant_override("outline_size", maxi(int(float(fs) * 0.16), 6))
		_lab.size = Vector2(float(fs) * 1.6, vs.y)
		_lab.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		_lab.visible = true
	var scene := get_tree().current_scene
	var touch_on := scene != null and scene.get("touch") != null
	_lab.position = Vector2(vs.x * (0.21 if touch_on else 0.76) - float(fs) * 0.8, 0.0)
	var ink := Color(0.04, 0.04, 0.05)
	var a := 1.0
	if _phase == 4:
		a = clampf(1.0 - (_pt - 0.15) / 0.2, 0.0, 1.0)
	var fg := Color.WHITE if inverted else ink
	var bg := ink if inverted else Color.WHITE
	if k < 0.5:
		fg = Color.WHITE.lerp(col, 0.6)
		bg = ink
	_lab.add_theme_color_override("font_color", Color(fg, a))
	_lab.add_theme_color_override("font_outline_color", Color(bg, a))
