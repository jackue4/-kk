extends Node3D
## 入口：注册输入、搭建大厅、生成角色/相机/飞剑/木人桩/刀客/后处理/HUD。
## 命令行追加 `-- --shot` 会跑一段自动演示并截图到 res://_shots（3C 回归）；
## `-- --combat-shot` 跑近战演示（三连击、命中顿刀与碎块、弹反对刃、破防处决、跳斩、空中弹反）
## 并截图到 res://_shots/combat_feel_*。
## `-- --fx-shot` 跑飞行表现演示（筑基风丝、化身光剑起飞/巡航/现形、闪现）并截图到 res://_shots/fx_*。
## `-- --hitfx-shot` 把飞剑命中、近战分档命中、弹反、死亡特效并排放一遍并截图到 res://_shots/hitfx_*。
## `-- --air-shot` 跑 Shift 短按闪现 / 长按疾行、炼气残影闪现、结丹空格腾空与法术三段、俯冲落地，截图到 res://_shots/air_*。
## `-- --trailer` 录宣传片：炼气→大乘逐阶演示，逐帧存到 res://_shots/trailer/（见 trailer.gd，需配合 --fixed-fps 30）。
## `-- --realm-shot` 跑升阶突破（右侧毛笔题字 + 各境界突破特效）、完美闪避 → 瞬移斩、敌人碎裂消融，截图到 res://_shots/realm_*。
## `-- --boss-test` 剑冢 Boss 空战自检：走进剑冢 → 开战 → 打进二、三阶段 → 中弹 → 击败，打印各阶段弹数和状态；
## 有渲染时（非 --headless）顺带截图到 res://_shots/boss_*。
## `-- --meadow-shot` 跑择境传送门 → 选关 → 木兰草原：出生点、草地近景、低空 / 高空飞行、大乘高速巡航时的流式加载统计，
## 最后穿回程门回大厅；截图到 res://_shots/meadow_*。
##
## `-- --duel-shot` 跑空战斗法演示（R15 定妆、五段追身连击、击飞 → 瞬身追击 → 陨落砸地、蓄力崩拳、追身突进、
## 瞬身 / 护体 / 挨打、飞剑点射与三式剑诀），打印各步结算并截图到 res://_shots/duel_*。
##
## `-- --raid-shot` 跑搜打撤自检（进木兰草原 → 各区域风格 / 小怪 / Boss / 其他修士 → 拾取、背包、服丹 → 传送阵撤离结算），
## 打印各步状态和帧率并截图到 res://_shots/raid_*；加 `--touch` 看手机布局和手机画质档。
##
## 大厅西侧的择境传送门（level_portal.gd）：走进去弹出关卡选择（level_select.gd），选中后黑场切到关卡
## （目前只有木兰草原 meadow_level.gd）。切关时大厅整体停用（隐藏、停处理、关碰撞、敌人移出索敌分组），回来原样恢复。

const BLUR_SHADER := preload("res://shaders/speed_blur.gdshader")
const LINES_SHADER := preload("res://shaders/speed_lines.gdshader")     # 手机档：速度线 + 暗角（不读屏幕）
const WARP_SHADER := preload("res://shaders/impact_warp.gdshader")      # 手机档：冲击帧 / 空间扭曲（只在那零点几秒开）
const Swordsman := preload("res://scripts/swordsman.gd")
const Combat := preload("res://scripts/combat.gd")
const Sfx := preload("res://scripts/sfx.gd")
const Warm := preload("res://scripts/warmup.gd")
const CombatWord := preload("res://scripts/combat_word.gd")
const Trailer := preload("res://scripts/trailer.gd")
const BossArena := preload("res://scripts/boss_arena.gd")
const MeadowGen := preload("res://scripts/meadow_gen.gd")
const MeadowLevel := preload("res://scripts/meadow_level.gd")
const MeadowPreview := preload("res://scripts/meadow_preview.gd")
const LevelPortal := preload("res://scripts/level_portal.gd")
const UiStyle := preload("res://scripts/ui_style.gd")
const LevelSelect := preload("res://scripts/level_select.gd")
const AirFoe := preload("res://scripts/air_foe.gd")
const TouchControls := preload("res://scripts/touch_controls.gd")
const Tribulation := preload("res://scripts/tribulation.gd")
const Net := preload("res://scripts/net.gd")
const Proj := preload("res://scripts/spell_projectile.gd")
const BlockPreview := preload("res://scripts/block_preview.gd")
const BlockWorld := preload("res://scripts/block_world.gd")
const FEEL := "combat_feel_"  # 近战演示截图前缀（不覆盖 3C 回归图和上一轮的 combat_ 图）
const FX := "fx_"             # 飞行表现演示截图前缀
const HITFX := "hitfx_"       # 打击特效对照截图前缀
const AIR := "air_"           # Shift 闪现 / 空战法术演示截图前缀

var player: Player
var cam: CameraRig
var swords: SwordManager
var hud: Hud
var duelist: Swordsman
var foe: AirFoe          # 空战对手（魔修）
var sandbag: AirFoe      # 空战陪练木人（不还手）
var _duel_demo := false
var rival: AirFoe        # 真人陪练（真人式打法的 NPC）
var touch: TouchControls
var net: Net              # 局域网联机（net.gd）
var _raid_demo := false
var _touch := false      # 手机触屏模式（触屏设备自动开；桌面调试加 --touch）
var _warm := false       # 载入时预热首次使用的着色器 / 特效（warmup.gd）：手机和网页版开；自检默认不开，加 --warm 才开
var arena: BossArena
var hall: TestHall
var hall_portal: LevelPortal
var level: MeadowLevel
var level_ui: LevelSelect
var font: Font
var _hall_root: Node3D
var _hall_groups: Array = []   # 停用大厅时移出索敌分组的 [节点, 分组名]
var _switching := false
var _meadow_demo := false
var _blur_rect: ColorRect
var _blur_mat: ShaderMaterial
var _warp_rect: ColorRect      # 手机档才有：冲击帧 / 空间扭曲那一层
var _warp_mat: ShaderMaterial
var _fx_warm := 4              # 开头几帧两层都亮着（强度为零，看不出来）：把着色器先编好
var _mobile := false           # 手机画质档（触屏 / 网页版）
var _autotest := false
var _combat_demo := false
var _fx_demo := false
var _hitfx_demo := false
var _air_demo := false
var _realm_demo := false
var _trailer := false
var _boss_test := false
var _evc: Dictionary = {}


func _ready() -> void:
	var args := OS.get_cmdline_user_args()
	_autotest = args.has("--shot")
	_combat_demo = args.has("--combat-shot")
	_fx_demo = args.has("--fx-shot")
	_hitfx_demo = args.has("--hitfx-shot")
	_air_demo = args.has("--air-shot")
	_realm_demo = args.has("--realm-shot")
	_trailer = args.has("--trailer")
	_boss_test = args.has("--boss-test")
	_meadow_demo = args.has("--meadow-shot")
	_duel_demo = args.has("--duel-shot")
	_raid_demo = args.has("--raid-shot")
	_touch = args.has("--touch") or DisplayServer.is_touchscreen_available()
	_mobile = _touch or OS.has_feature("web")
	if _mobile:
		_apply_mobile_tier()
	get_tree().node_added.connect(_keep_node_added)
	_warm = args.has("--warm") or ((_touch or OS.has_feature("web")) and not (_raid_demo or _duel_demo or _autotest or _combat_demo or _fx_demo
			or _hitfx_demo or _air_demo or _realm_demo or _trailer or _boss_test or _meadow_demo or _net_role() != ""))
	_setup_input()
	Sfx.root = self
	if OS.has_feature("windows"):
		var sf := SystemFont.new()
		# 界面正文统一用楷体（武侠修仙风格，见 ui_style.gd）；没有楷体的机器退回黑体
		sf.font_names = PackedStringArray(["KaiTi", "STKaiti", "Kaiti SC", "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", "SimHei"])
		sf.font_weight = 500
		font = sf
	else:
		font = UiStyle.kai()       # 网页 / 手机：随包带的开源字体
	Vfx.font = font

	_hall_root = Node3D.new()
	_hall_root.name = "HallRoot"
	add_child(_hall_root)
	hall = TestHall.new()
	hall.font = font
	_hall_root.add_child(hall)

	var vfx := Node3D.new()
	vfx.name = "Vfx"
	add_child(vfx)
	Vfx.root = vfx

	cam = CameraRig.new()
	cam.touch_mode = _touch
	cam.capture_mouse = not (_raid_demo or _touch or _duel_demo or _autotest or _combat_demo or _fx_demo or _hitfx_demo or _air_demo or _realm_demo or _trailer or _boss_test or _meadow_demo)
	add_child(cam)

	player = Player.new()
	player.cam = cam
	player.vfx_root = vfx
	add_child(player)
	player.global_position = Vector3(0, 0.1, 0)
	cam.target = player

	# 老演示（--air-shot / 宣传片 / Boss 自检）里"按住攻击键 = 连发"照旧
	player.caster.demo_hold_attack = _air_demo or _trailer or _boss_test or _autotest or _realm_demo

	swords = SwordManager.new()
	swords.player = player
	add_child(swords)

	_spawn_enemies()
	# 3C 回归 / 飞行表现截图不放刀客，保证画面干净、与上一轮一致
	if not (_autotest or _fx_demo or _hitfx_demo or _air_demo):
		_spawn_duelists()
	# 空战对手：老的回归截图里不放
	if not (_autotest or _fx_demo or _hitfx_demo or _air_demo or _combat_demo or _realm_demo or _trailer or _boss_test or _meadow_demo):
		_spawn_air_foes()
	_build_postfx()

	hud = Hud.new()
	hud.font = font
	hud.trailer = _trailer
	hud.touch = _touch
	add_child(hud)
	if _touch:
		# 桌面调试：鼠标当手指
		if not DisplayServer.is_touchscreen_available():
			Input.emulate_touch_from_mouse = true
		touch = TouchControls.new()
		touch.player = player
		touch.cam = cam
		touch.font = font
		add_child(touch)

	# 剑冢 Boss 空战（大厅东侧，见 boss_arena.gd）
	arena = BossArena.new()
	arena.player = player
	arena.cam = cam
	arena.hud = hud
	arena.font = font
	_hall_root.add_child(arena)

	# 择境传送门 + 关卡选择（老的回归截图 / 演示里不放，画面和以前一致）
	level_ui = LevelSelect.new()
	level_ui.font = font
	add_child(level_ui)
	net = Net.new()
	net.name = "Net"
	net.player = player
	add_child(net)
	net.room_closed.connect(_on_room_closed)
	level_ui.net = net
	level_ui.picked.connect(_enter_level)
	level_ui.closed.connect(_on_menu_closed)
	if not (_duel_demo or _autotest or _fx_demo or _hitfx_demo or _air_demo or _combat_demo or _realm_demo or _trailer or _boss_test):
		hall_portal = LevelPortal.new()
		hall_portal.name = "HallPortal"
		hall_portal.font = font
		hall_portal.title = "择 境 门"
		hall_portal.subtitle = "木兰草原"
		hall_portal.position = TestHall.PORTAL_POS
		hall_portal.rotation.y = PI * 0.5   # 门口朝 +X（出生点）
		# 门心里看到的是现在的大世界（方块世界的出生点一带），不再是旧的吉卜力草原
		hall_portal.preview_eye = BlockPreview.eye()
		var pworld := BlockWorld.new()
		add_child(pworld)
		pworld.set_process(false)   # 只借它算高度，不建地块
		hall_portal.preview_floor = func(x: float, z: float) -> float: return pworld.height(x, z)
		hall_portal.preview_builder = func(vp: SubViewport) -> void: vp.add_child(BlockPreview.new())
		hall_portal.entered.connect(_open_level_select)
		_hall_root.add_child(hall_portal)

	player.realm_changed.connect(_on_realm_changed)
	player.realm_ascended.connect(func(_i: int) -> void: hud.realm_up(player.realm))
	player.dun_changed.connect(swords.set_cloaked)  # 遁光：飞剑本体随主角一起隐藏/恢复
	player.melee.combat_event.connect(_on_combat_event)
	player.set_realm(0, false)
	if _autotest or _combat_demo or _fx_demo or _hitfx_demo or _air_demo or _realm_demo or _trailer:
		swords.summon(true, true)  # 演示沿用以前"飞剑常驻"的画面
	if _autotest:
		_run_autotest()
	elif _combat_demo:
		_run_combat_demo()
	elif _fx_demo:
		_run_fx_demo()
	elif _hitfx_demo:
		_run_hitfx_demo()
	elif _air_demo:
		_run_air_demo()
	elif _realm_demo:
		_run_realm_demo()
	elif _boss_test:
		_run_boss_test()
	elif _meadow_demo:
		_run_meadow_demo()
	elif _net_role() != "":
		_run_net_demo(_net_role())
	elif _duel_demo and OS.get_cmdline_user_args().has("--trib"):
		_run_trib_demo()
	elif _duel_demo and OS.get_cmdline_user_args().has("--touch-test"):
		_run_touch_test()
	elif _duel_demo:
		_run_duel_demo()
	elif _raid_demo:
		_run_raid_demo()
	elif _trailer:
		var tr := Trailer.new()
		tr.m = self
		add_child(tr)
	elif _warm:
		_boot_warm()


# ---------- 留住着色器 ----------
## StandardMaterial3D / ParticleProcessMaterial 的着色器是引擎按「功能组合」（透明方式、是否受光、裁剪面、自发光…）现生成的，
## 同一种组合的材质共用一份、按引用计数管理：用它的最后一个材质一释放，着色器跟着释放；下次再出现同样组合的材质，
## 又得重新生成、编译、链接。战斗特效的材质都是用完就扔的（剑影、火星、飞剑的剑身…），于是打着打着就一遍遍重编 ——
## 桌面显卡有驱动缓存感觉不到，网页版上每次一百多毫秒，就是那种「打斗时隔一会儿顿一下」。
## 做法：每一种组合留住第一份见到的材质不放手（_keep），着色器就一直在。新节点进树的下一帧看一眼它用的材质（那时才配齐）。
var _keep := {}                # 功能组合的签名 → 留着的那份材质
var _keep_queue: Array = []
var keep_seen := 0             # 看过多少个材质（自检打印）


func _keep_node_added(n: Node) -> void:
	if n is GeometryInstance3D:
		_keep_queue.append(n)


func _keep_step() -> void:
	if _keep_queue.is_empty():
		return
	var q := _keep_queue
	_keep_queue = []
	for n: Variant in q:
		if not is_instance_valid(n):
			continue
		var gi := n as GeometryInstance3D
		_keep_mat(gi.material_override)
		_keep_mat(gi.material_overlay)
		if gi is MeshInstance3D:
			var mi := gi as MeshInstance3D
			_keep_mesh(mi.mesh)
			for i in mi.get_surface_override_material_count():
				_keep_mat(mi.get_surface_override_material(i))
		elif gi is CPUParticles3D:
			_keep_mesh((gi as CPUParticles3D).mesh)
		elif gi is MultiMeshInstance3D:
			var mm := (gi as MultiMeshInstance3D).multimesh
			if mm != null:
				_keep_mesh(mm.mesh)
		elif gi is GPUParticles3D:
			var gp := gi as GPUParticles3D
			_keep_mat(gp.process_material)
			for i in gp.draw_passes:
				_keep_mesh(gp.get_draw_pass_mesh(i))


func _keep_mesh(mesh: Mesh) -> void:
	if mesh == null:
		return
	for i in mesh.get_surface_count():
		_keep_mat(mesh.surface_get_material(i))


func _keep_mat(m: Material) -> void:
	if m == null:
		return
	var key := 0
	if m is BaseMaterial3D:
		var b := m as BaseMaterial3D
		# 凡是会改变生成出来的着色器代码的开关都算进签名（宁多勿少：多算只是多留几份副本，少算会漏掉某种组合）
		key = hash([b.get_class(), b.transparency, b.shading_mode, b.blend_mode, b.cull_mode, b.depth_draw_mode, b.no_depth_test,
				b.vertex_color_use_as_albedo, b.vertex_color_is_srgb, b.billboard_mode, b.billboard_keep_scale, b.use_particle_trails,
				b.emission_enabled, b.emission_operator, b.diffuse_mode, b.specular_mode, b.disable_receive_shadows, b.disable_ambient_light,
				b.disable_fog, b.texture_filter, b.texture_repeat, b.grow, b.fixed_size, b.use_point_size, b.distance_fade_mode,
				b.proximity_fade_enabled, b.rim_enabled, b.normal_enabled, b.clearcoat_enabled, b.anisotropy_enabled, b.ao_enabled,
				b.heightmap_enabled, b.subsurf_scatter_enabled, b.backlight_enabled, b.refraction_enabled, b.detail_enabled,
				b.uv1_triplanar, b.uv2_triplanar, b.alpha_antialiasing_mode, b.albedo_texture_msdf, b.albedo_texture_force_srgb,
				b.shadow_to_opacity, b.emission_on_uv2, b.ao_on_uv2, b.detail_blend_mode, b.detail_uv_layer, b.uv1_world_triplanar,
				b.uv2_world_triplanar, b.albedo_texture != null and b.transparency != BaseMaterial3D.TRANSPARENCY_DISABLED])
	elif m is ParticleProcessMaterial:
		var p := m as ParticleProcessMaterial
		var sig: Array = [p.emission_shape, p.particle_flag_align_y, p.particle_flag_rotate_y, p.particle_flag_disable_z, p.turbulence_enabled,
				p.collision_mode, p.sub_emitter_mode, p.attractor_interaction_enabled, p.color_ramp != null, p.color_initial_ramp != null,
				p.alpha_curve != null, p.emission_curve != null, p.directional_velocity_curve != null, p.orbit_velocity_curve != null,
				p.radial_velocity_curve != null, p.scale_over_velocity_curve != null, p.velocity_limit_curve != null, p.inherit_velocity_ratio != 0.0]
		for i in ParticleProcessMaterial.PARAM_MAX:
			sig.append(p.get_param_texture(i) != null)
		key = hash(sig)
	else:
		return
	keep_seen += 1
	if not _keep.has(key):
		# 留的是这份材质本身，不是副本：材质的着色器是「第一次真被拿去画」时才生成的，没上过场的副本不占引用计数、留不住
		_keep[key] = m


## 手机画质档（触屏设备 / 网页版）：开机就定好（中途改这些会让一批着色器重编）。
##   · 3D 画面按 720 线出、再放大到屏幕（界面仍是原生分辨率）：手机屏动辄 1080p 以上再乘设备像素比，原生分辨率画 3D 太吃填充率
##   · 不开多重采样；日影的软边用最便宜的一档、阴影图 2048
##   · 不要动态点光（飞剑 / 火球身上的灯、命中的闪光）：这套渲染里一盏灯就让它照到的整块地表每个像素多算一遍光照
##   · 命中特效减层、同帧限量（Vfx.lite）
func _apply_mobile_tier() -> void:
	var vp := get_viewport()
	vp.msaa_3d = Viewport.MSAA_DISABLED
	vp.scaling_3d_mode = Viewport.SCALING_3D_MODE_BILINEAR
	_fit_3d_scale()
	get_window().size_changed.connect(_fit_3d_scale)
	RenderingServer.directional_soft_shadow_filter_set_quality(RenderingServer.SHADOW_QUALITY_SOFT_VERY_LOW)
	RenderingServer.directional_shadow_atlas_set_size(2048, true)
	Vfx.lights = false
	Vfx.lite = true


func _fit_3d_scale() -> void:
	var h := float(get_window().size.y)
	var k := clampf(720.0 / maxf(h, 1.0), 0.5, 1.0)
	for a: String in OS.get_cmdline_user_args():
		if a.begins_with("--scale3d="):
			k = clampf(float(a.get_slice("=", 1)), 0.25, 1.0)
	get_viewport().scaling_3d_scale = k


## 开机预热（大厅）：黑幕后面把战斗里第一次会用到的着色器 / 特效都画一遍（见 warmup.gd），做完再亮场
func _boot_warm() -> void:
	player.process_mode = Node.PROCESS_MODE_DISABLED
	level_ui._fade.color.a = 1.0
	level_ui.set_loading("灵气汇聚中")
	await get_tree().process_frame
	await get_tree().process_frame
	await Warm.run(self, player, cam, "hall", func(t: String) -> void: level_ui.set_loading("灵气汇聚中 · " + t), null, [swords])
	level_ui.set_loading("")
	player.process_mode = Node.PROCESS_MODE_INHERIT
	await level_ui.fade(0.0, 0.5)


func _on_realm_changed(_idx: int) -> void:
	swords.apply_realm(player.realm)
	# 这个境界的三式剑诀名：字贴图先排队画好，第一次放招时不用现画
	CombatWord.queue_words(Realm.art_info(player.realm)["stages"])


## 战斗字：3D 发光毛笔字立在角色身边（见 combat_word.gd），敌方状态写在敌人头顶，自己的写在主角头顶
func _on_combat_event(kind: String, info: Dictionary) -> void:
	_evc[kind] = int(_evc.get(kind, 0)) + 1
	var head := player.center() + Vector3.UP * 1.35
	match kind:
		"parry":
			CombatWord.pop("弹反", info.get("contact", head) + Vector3.UP * 1.0, Color(1.0, 0.78, 0.35))
		"enemy_break":
			CombatWord.pop("破防", info.get("pos", head) + Vector3.UP * 1.45, Color(1.0, 0.32, 0.22), 1.1)
		"execute":
			CombatWord.pop("斩", info.get("pos", head) + Vector3.UP * 1.3, Color(1.0, 0.18, 0.14), 1.6)
		"self_broken":
			CombatWord.pop("架势崩溃", head, Color(1.0, 0.5, 0.25), 0.8)
		"recoiled":
			CombatWord.pop("被弹开", head, Color(0.7, 0.8, 1.0), 0.8)
		# ---- 空战斗法（air_melee.gd / air_foe.gd）----
		"air_launch":
			var w: String = {"fwd": "崩", "up": "挑", "down": "陨"}.get(str(info.get("kind", "fwd")), "崩")
			CombatWord.pop(w, (info.get("pos", head) as Vector3) + Vector3.UP * 1.6, Color(1.0, 0.82, 0.4), 1.3)
		"air_chase":
			CombatWord.pop("瞬身追击", head, Realm.line_color(player.realm).lerp(Color.WHITE, 0.4), 0.8)
		"air_vanish":
			CombatWord.pop("瞬身", head, Color(0.75, 0.9, 1.0), 1.1)
		"air_break":
			CombatWord.pop("破", (info.get("pos", head) as Vector3) + Vector3.UP * 1.4, Color(1.0, 0.32, 0.22), 1.1)
		"air_crash":
			if bool(info.get("ground", true)):
				CombatWord.pop("坠", (info.get("pos", head) as Vector3) + Vector3.UP * 2.6, Color(1.0, 0.6, 0.3), 1.5)
		"air_kill":
			CombatWord.pop("斩", (info.get("pos", head) as Vector3) + Vector3.UP * 1.3, Color(1.0, 0.18, 0.14), 1.6)
		"air_skill":
			CombatWord.pop(str(info.get("name", "")), head + Vector3.UP * 0.3, Realm.line_color(player.realm).lerp(Color.WHITE, 0.3), 0.9)
		"air_clash_warn":
			CombatWord.pop("飞剑来袭", (info.get("pos", head) as Vector3) + Vector3.UP * 2.0, Color(1.0, 0.4, 0.3), 1.3)
		"air_clash":
			CombatWord.pop("飞剑对波", (info.get("pos", head) as Vector3) + Vector3.UP * 2.6, Color(1.0, 0.85, 0.4), 1.6)
		"air_clash_end":
			var won := bool(info.get("win", false))
			CombatWord.pop("破" if won else "溃", (info.get("pos", head) as Vector3) + Vector3.UP * 1.8,
					Color(1.0, 0.82, 0.4) if won else Color(1.0, 0.3, 0.25), 1.6)
		"air_awaken":
			CombatWord.pop("觉醒", head + Vector3.UP * 0.4, Realm.line_color(player.realm).lerp(Color.WHITE, 0.3), 1.6)
		"air_hurt":
			if bool(info.get("dead", false)):
				CombatWord.pop("败", head, Color(1.0, 0.25, 0.22), 1.4)


# ---------- 输入 ----------

func _setup_input() -> void:
	_key("move_forward", KEY_W)
	_key("move_back", KEY_S)
	_key("move_left", KEY_A)
	_key("move_right", KEY_D)
	_key("jump", KEY_SPACE)
	# Shift：短按闪现，长按疾行 / 疾遁（见 Player._unhandled_input）
	_key("sprint", KEY_SHIFT)
	_key("fly", KEY_F)
	_key("toggle_auto", KEY_G)
	_key("summon", KEY_Q)  # 飞剑阵技能：逐柄召出 → 自动索敌；再按收起
	_key("ult", KEY_R)  # 大罡剑阵（大乘专属，见 gate_array.gd）
	_key("reset", KEY_BACKSPACE)  # 回出生点（R 让给大罡剑阵）
	_key("realm_prev", KEY_BRACKETLEFT)
	_key("realm_next", KEY_BRACKETRIGHT)
	# 万剑齐发：E；左键在空中照旧是万剑齐发，在地面归近战（见 SwordManager）
	_key("burst", KEY_E)
	# 近战：攻击 J / 左键；格挡·弹反 K / 右键
	_key("attack", KEY_J)
	_key("guard", KEY_K)
	if not _touch:
		# 触屏上不绑鼠标键：系统会把第一根手指（多半是摇杆那根）同时当成鼠标左键按下，
		# 绑了的话推着摇杆 = 一直按着「攻击」，空战里就会不停地蓄力
		_mouse("burst", MOUSE_BUTTON_LEFT)
		_mouse("attack", MOUSE_BUTTON_LEFT)
		_mouse("guard", MOUSE_BUTTON_RIGHT)
	# 空战：E 飞剑点射 / 长按连发；Z X C 三式剑诀（见 air_melee.gd）
	_key("air_shot", KEY_E)
	_key("skill_next", KEY_Z)   # 「诀」：三式剑诀按顺序轮放
	# 对波光柱 T；聚气（按住回灵力、攒觉醒槽，满了继续按 = 觉醒）V
	_key("gather", KEY_V)
	_key("bag", KEY_B)   # 搜打撤：背包


func _mouse(action: String, button: MouseButton) -> void:
	if not InputMap.has_action(action):
		InputMap.add_action(action)
	var mb := InputEventMouseButton.new()
	mb.button_index = button
	InputMap.action_add_event(action, mb)


func _key(action: String, code: Key) -> void:
	if not InputMap.has_action(action):
		InputMap.add_action(action)
	var ev := InputEventKey.new()
	ev.physical_keycode = code
	InputMap.action_add_event(action, ev)


func _unhandled_input(e: InputEvent) -> void:
	if e.is_action_pressed("realm_prev"):
		player.set_realm(player.realm_idx - 1)
	elif e.is_action_pressed("realm_next"):
		_gm_breakthrough(player.realm_idx + 1)
	elif e.is_action_pressed("reset"):
		player.force_ground()
		player.global_position = level.spawn_point() if level != null else Vector3(0, 0.1, 0)
	elif e is InputEventKey and e.pressed and not e.echo:
		var k := (e as InputEventKey).physical_keycode
		if k >= KEY_1 and k <= KEY_8:
			# 数字键：往上跳境界也先渡对应的雷劫（测试雷劫用）；往下 / 原地是直接切
			if Tribulation.running:
				return
			if k - KEY_1 > player.realm_idx:
				_gm_breakthrough(k - KEY_1)
			else:
				player.set_realm(k - KEY_1)


## GM 升境界（] 键 / 触屏「境+」升一级；数字键 1-8 直接跳到那个境界）：和正常突破一样先渡目标境界的雷劫，
## 渡过了才升，渡劫失败就不升。往下降（「境-」、按比当前低的数字键）是直接切换，不走雷劫。
func _gm_breakthrough(to: int) -> void:
	if Tribulation.running or to > Realm.count() - 1 or to <= player.realm_idx or player.ult.active:
		return
	if level != null and level.raid != null:
		level.raid.gm_tribulation(to)   # 大世界里走搜打撤那套（怪定住、天色压暗、等级跟着走）
		return
	var tb := Tribulation.new()
	tb.player = player
	tb.cam = cam
	tb.realm_to = to
	tb.finished.connect(func(ok: bool, _perfect: int, _total: int) -> void:
		if ok:
			player.set_realm(to))
	add_child(tb)


# ---------- 木人桩 ----------

func _enemy(pos: Vector3, kind: int) -> void:
	var e := EnemyDummy.new()
	e.kind = kind
	e.position = pos
	_hall_root.add_child(e)


func _spawn_enemies() -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = 7
	# 地面一圈
	for i in 10:
		var a := TAU * i / 10.0 + 0.3
		var r := rng.randf_range(8.0, 15.0)
		_enemy(Vector3(cos(a) * r, 0, sin(a) * r - 4.0), 0)
	# 近处浮空
	for i in 10:
		var a := rng.randf() * TAU
		var r := rng.randf_range(10.0, 38.0)
		_enemy(Vector3(cos(a) * r, rng.randf_range(5.0, 32.0), sin(a) * r), 1)
	# 巡游
	_enemy(Vector3(0, 2.0, -24.0), 2)
	_enemy(Vector3(18, 12.0, -6.0), 2)
	_enemy(Vector3(-18, 8.0, 6.0), 2)
	# 长廊上空：空战靶
	var z := 60.0
	while z <= 660.0:
		_enemy(Vector3(rng.randf_range(-14.0, 14.0), rng.randf_range(15.0, 60.0), -z), 1)
		_enemy(Vector3(rng.randf_range(-14.0, 14.0), rng.randf_range(15.0, 60.0), -z - 20.0), 1)
		z += 60.0


## 空战对手：出生点左前方半空一个不还手的陪练木人；右前方远处高空一个会追打、放剑气的魔修
func _spawn_air_foes() -> void:
	sandbag = _air_foe(Vector3(-9.0, 7.0, -13.0), "陪练木人", false, 1, 1500.0)
	foe = _air_foe(Vector3(20.0, 11.0, -34.0), "魔修·厉无咎", true, 0, 900.0)
	# 真人陪练：打法照着真人玩家来（连段、击飞追击、瞬身反打、对波），在出生点正后方的半空
	rival = _air_foe(Vector3(6.0, 9.0, 26.0), "陪练·青禾", true, 2, 1600.0)
	rival.pro = true
	rival.qi = Color(0.3, 0.95, 0.85)


func _air_foe(pos: Vector3, nm: String, ai: bool, style: int, hp: float) -> AirFoe:
	var e := AirFoe.new()
	e.player = player
	e.display_name = nm
	e.ai_enabled = ai
	e.style = style
	e.hp_max = hp
	e.position = pos
	_hall_root.add_child(e)
	return e


## 刀客：出生点正前方一个（走两步就会迎上来），右前方远一点再放一个，默认一对一
func _spawn_duelists() -> void:
	duelist = _duelist(Vector3(0, 0, -10.0), "刀客")
	_duelist(Vector3(10.0, 0, -17.0), "刀客·二")


func _duelist(pos: Vector3, nm: String) -> Swordsman:
	var e := Swordsman.new()
	e.player = player
	e.display_name = nm
	e.home_yaw = PI
	e.position = pos
	_hall_root.add_child(e)
	return e


# ---------- 择境：大厅 ⇄ 关卡 ----------

func _open_level_select() -> void:
	if _switching or level != null:
		return
	Input.action_release("move_forward")
	level_ui.open()


## 房主退出了：房间解散，回大厅
func _on_room_closed() -> void:
	if level != null:
		_return_to_hall()


func _on_menu_closed() -> void:
	if cam.capture_mouse:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


## 大厅整体停用 / 恢复：隐藏、停处理、关碰撞、敌人移出索敌分组、摘掉大厅的环境
func _set_hall_active(on: bool) -> void:
	_hall_root.visible = on
	_hall_root.process_mode = Node.PROCESS_MODE_INHERIT if on else Node.PROCESS_MODE_DISABLED
	if on:
		for e: Array in _hall_groups:
			var n: Node = e[0]
			if is_instance_valid(n):
				n.add_to_group(String(e[1]))
		_hall_groups.clear()
	else:
		for g: String in ["enemies", "swordsmen", "air_foes"]:
			for n in get_tree().get_nodes_in_group(g):
				if _hall_root.is_ancestor_of(n):
					n.remove_from_group(g)
					_hall_groups.append([n, g])
	_set_collision(_hall_root, on)
	hall.set_env_active(on)
	if hall_portal != null:
		hall_portal.preview_on = on


func _set_collision(n: Node, on: bool) -> void:
	var co := n as CollisionObject3D
	if co != null:
		if on and co.has_meta("hall_layers"):
			var lm: Array = co.get_meta("hall_layers")
			co.collision_layer = int(lm[0])
			co.collision_mask = int(lm[1])
			co.remove_meta("hall_layers")
		elif not on and not co.has_meta("hall_layers"):
			co.set_meta("hall_layers", [co.collision_layer, co.collision_mask])
			co.collision_layer = 0
			co.collision_mask = 0
	for c in n.get_children():
		_set_collision(c, on)


func _enter_level(_id: String) -> void:
	if _switching or level != null:
		return
	_switching = true
	var t0 := Time.get_ticks_msec()
	await level_ui.fade(1.0, 0.45)
	level_ui.set_loading("木兰草原 · 载入中")
	# 联机：先把房间建好 / 连上（要拿到房主给的种子才能建关卡）
	if level_ui.mode == "match":
		await _matchmake()
	elif level_ui.mode == "host":
		if not net.host(int(level_ui.team_size)):
			level_ui.set_loading("建房失败（端口被占用？）· 改为单人进入")
			await get_tree().create_timer(1.2).timeout
	elif level_ui.mode == "join":
		level_ui.set_loading("正在加入 %s …" % level_ui.join_ip)
		var joined: bool = await net.join(str(level_ui.join_ip), int(level_ui.team_size))
		if not joined:
			level_ui.set_loading("加入失败：连不上 %s" % level_ui.join_ip)
			await get_tree().create_timer(1.6).timeout
			level_ui.set_loading("")
			level_ui.mode = "solo"
			if cam.capture_mouse:
				Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
			await level_ui.fade(0.0, 0.4)
			_switching = false
			return
		level_ui.set_loading("木兰草原 · 载入中")
	level_ui.mode = "solo"
	player.force_ground()
	swords.dismiss_all()
	player.process_mode = Node.PROCESS_MODE_DISABLED
	_set_hall_active(false)
	level = MeadowLevel.new()
	level.name = "Meadow"
	level.player = player
	level.cam = cam
	level.font = font
	level.raid_enabled = not _meadow_demo or _raid_demo
	level.mobile = _mobile     # 触屏 / 网页版走手机画质档
	level.net = net
	level.exit_requested.connect(_return_to_hall)
	add_child(level)
	player.global_position = level.spawn_point()
	player.velocity = Vector3.ZERO
	player.face_now(level.spawn_yaw())
	cam.snap(level.spawn_yaw(), CameraRig.PITCH_DEFAULT, 6.5)
	var waited: float = await level.prewarm()
	if _warm:
		await Warm.run(self, player, cam, "raid" if level.raid != null else "meadow",
				func(t: String) -> void: level_ui.set_loading("木兰草原 · " + t), level.raid, [swords])
	# 正式关卡：收起键位说明和调试按钮
	hud.set_compact(level.raid != null)
	if touch != null:
		touch.compact = level.raid != null
	print("[meadow] 载入 %.2fs（黑场起 %dms），%s" % [waited, Time.get_ticks_msec() - t0, level.stats_text().replace("\n", " | ")])
	player.process_mode = Node.PROCESS_MODE_INHERIT
	level_ui.set_loading("")
	if cam.capture_mouse:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	await level_ui.fade(0.0, 0.7)
	_switching = false


## 一键匹配：先听一两秒局域网里有没有房间——有就进人最多的那间（房主按组队人数把人拼进没满的队）；
## 没有、或进不去，就自己开一间等别人进来；连房间都开不了（端口被占）先试试本机上的那间，再不行就单人。
## 队伍里缺的人进图后由 AI 道友补位（raid_manager.gd 的 _update_allies）。
func _matchmake() -> void:
	var size := int(level_ui.team_size)
	net.team_size = size
	if OS.has_feature("web"):
		# 浏览器里没有局域网联机（不能开 UDP 端口）：直接单人进，队友由 AI 补位
		level_ui.set_loading("木兰草原 · 载入中")
		return
	net.start_discovery()
	level_ui.set_loading("正在匹配道友 …")
	var wait := randf_range(1.6, 2.6)   # 错开一点：两个人同时点匹配时，后到的那个能看见先开的房间
	var t := 0.0
	while t < wait and net.rooms.is_empty():
		await get_tree().process_frame
		t += get_process_delta_time()
	var best_ip := ""
	var best_n := -1
	for ip: String in net.rooms.keys():
		var n := int(net.rooms[ip]["count"])
		if n < net.MAX_PLAYERS and n > best_n:
			best_n = n
			best_ip = ip
	net.stop_discovery()
	var joined := false
	if best_ip != "":
		level_ui.set_loading("匹配到 %d 位道友，正在入境 …" % best_n)
		joined = await net.join(best_ip, size, 4.0)
	if not joined and not net.host(size):
		joined = await net.join("127.0.0.1", size, 2.0)
	net.team_size = size
	var mates := (int(net.team_count()) - 1) if net.active else 0
	if size > 1:
		level_ui.set_loading("同队真人 %d 位 · AI 道友补位 %d 位" % [mates, maxi(size - 1 - mates, 0)])
		await get_tree().create_timer(0.7).timeout
	level_ui.set_loading("木兰草原 · 载入中")
	print("[match] 组队人数 %d 联机=%s 房主=%s 房间 %d 人 同队真人 %d" % [size, net.active, net.is_host, net.players.size(), mates])


func _return_to_hall() -> void:
	if _switching or level == null:
		return
	_switching = true
	await level_ui.fade(1.0, 0.4)
	player.force_ground()
	swords.dismiss_all()
	player.process_mode = Node.PROCESS_MODE_DISABLED
	level.queue_free()
	level = null
	net.leave()
	hud.set_compact(false)
	if touch != null:
		touch.compact = false
	await get_tree().process_frame
	_set_hall_active(true)
	var out := hall_portal.front(8.0) if hall_portal != null else Vector3.ZERO
	player.global_position = out + Vector3(0, 0.1, 0)
	player.velocity = Vector3.ZERO
	player.face_now(-PI * 0.5)
	cam.snap(-PI * 0.5, CameraRig.PITCH_DEFAULT, 6.5)
	if hall_portal != null:
		hall_portal.rearm()
	player.process_mode = Node.PROCESS_MODE_INHERIT
	await level_ui.fade(0.0, 0.5)
	_switching = false


# ---------- 后处理 ----------

func _build_postfx() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 1
	add_child(layer)
	_blur_mat = ShaderMaterial.new()
	_blur_mat.shader = LINES_SHADER if _mobile else BLUR_SHADER
	if _mobile:
		_warp_mat = ShaderMaterial.new()
		_warp_mat.shader = WARP_SHADER
		_warp_rect = ColorRect.new()
		_warp_rect.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		_warp_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_warp_rect.material = _warp_mat
		_warp_rect.visible = false
		layer.add_child(_warp_rect)
	_blur_rect = ColorRect.new()
	_blur_rect.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_blur_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_blur_rect.material = _blur_mat
	_blur_rect.visible = false
	layer.add_child(_blur_rect)


func _process(dt: float) -> void:
	if _hx_on:
		_hx_tick()
	if _fp_on:
		_fp_tick()
	_keep_step()
	CombatWord.step()
	Combat.tick(dt)
	var mt: Variant = player.melee.target
	cam.focus = mt if player.melee.engaged() and is_instance_valid(mt) else null
	hud.refresh(player, swords)
	if touch != null:
		touch.blocked = Tribulation.running or (level != null and level.raid != null and level.raid.hud.bag_open())
	_update_postfx(dt)


## 全屏后处理的参数。桌面档一层（speed_blur：径向拖影 + 速度线 + 冲击帧 + 扭曲）；
## 手机档拆成两层：速度线 / 暗角直接叠（不读屏幕），冲击帧 / 扭曲只在生效的那零点几秒才开
func _update_postfx(dt: float) -> void:
	var s := cam.blur_strength
	# 空间扭曲：交汇点投到屏幕；离得越近圈越大。没人再写就很快退掉
	var wk := Vfx.warp_k
	Vfx.warp_k = move_toward(Vfx.warp_k, 0.0, dt * 0.25)
	var fx: ShaderMaterial = _warp_mat if _mobile else _blur_mat
	fx.set_shader_parameter("impact", cam.impact_k)
	fx.set_shader_parameter("shatter_r", cam.impact_r)
	_blur_mat.set_shader_parameter("rush", cam.rush_k)
	if wk > 0.0005 and not cam.cam.is_position_behind(Vfx.warp_pos):
		var vs0 := get_viewport().get_visible_rect().size
		var sp := cam.cam.unproject_position(Vfx.warp_pos)
		fx.set_shader_parameter("warp_c", Vector2(sp.x / vs0.x, sp.y / vs0.y))
		fx.set_shader_parameter("warp_r", clampf(7.0 / maxf(cam.cam.global_position.distance_to(Vfx.warp_pos), 1.0), 0.1, 0.5))
		fx.set_shader_parameter("warp_k", wk)
	else:
		wk = 0.0
		fx.set_shader_parameter("warp_k", 0.0)
	var warm := _fx_warm > 0
	_fx_warm = maxi(_fx_warm - 1, 0)
	var lines_on := s > 0.01 or cam.rush_k > 0.01
	var warp_on := cam.impact_k > 0.01 or wk > 0.0005
	if _mobile:
		# 速度线要强度过了 0.25 才看得见，暗角也是慢慢起来的：太弱的时候这一层干脆不画
		_blur_rect.visible = s > 0.06 or cam.rush_k > 0.01 or warm
		_warp_rect.visible = warp_on or warm
	else:
		_blur_rect.visible = lines_on or warp_on
	if _blur_rect.visible or (_warp_rect != null and _warp_rect.visible):
		var c := Vector2(0.5, 0.5)
		var pc := player.center()
		if not cam.cam.is_position_behind(pc):
			var sz := get_viewport().get_visible_rect().size
			c = cam.cam.unproject_position(pc) / sz
			c = c.clamp(Vector2(0.25, 0.25), Vector2(0.75, 0.75))
		var tint := Realm.line_color(player.realm)
		_blur_mat.set_shader_parameter("strength", s)
		_blur_mat.set_shader_parameter("center", c)
		_blur_mat.set_shader_parameter("tint", tint)
		if _mobile:
			_warp_mat.set_shader_parameter("center", c)
			_warp_mat.set_shader_parameter("tint", tint)


# ---------- 自动演示截图 ----------

func _wait(sec: float) -> void:
	await get_tree().create_timer(sec).timeout


## 截图：原图 PNG 存 _shots，另存一张 800 宽的 JPG 预览到 _shots/preview（方便快速验收）。
## 存盘期间冻结战斗时钟，长帧不会让招式时间轴跳帧。
func _shot(tag: String) -> void:
	Combat.hold = true
	await RenderingServer.frame_post_draw
	var img := get_viewport().get_texture().get_image()
	img.save_png("res://_shots/%s.png" % tag)
	var pv := img.duplicate() as Image
	pv.resize(800, int(800.0 * img.get_height() / img.get_width()), Image.INTERPOLATE_BILINEAR)
	pv.save_jpg("res://_shots/preview/%s.jpg" % tag, 0.85)
	Combat.hold = false
	print("[shot] ", tag)


## 镜头临时偏转 yaw_off 拍一张侧视，再转回去（只隔两帧，飞行方向几乎不受影响）
func _side_shot(tag: String, yaw_off: float) -> void:
	cam.yaw += yaw_off
	await get_tree().process_frame
	await get_tree().process_frame
	await _shot(tag)
	cam.yaw -= yaw_off


func _home() -> void:
	player.force_ground()
	player.global_position = Vector3(0, 0.1, 0)


func _run_autotest() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	await _wait(1.5)
	await _shot("01_lianqi_ground")

	# 主角近景：地面站立，多角度（先停掉自动出剑，画面里只留人和待命飞剑）
	swords.auto_attack = false
	await _wait(0.8)
	var views := [["front", PI, -0.1], ["front34", PI * 0.78, -0.2], ["side", PI * 0.5, -0.1],
			["back34", PI * 0.22, -0.3], ["back", 0.0, -0.26]]
	for v: Array in views:
		cam.snap(float(v[1]), float(v[2]), 2.4)
		await _wait(0.25)
		await _shot("hero_%s" % v[0])
	# 行走：朝镜头斜向走来，拍迈步摆臂
	cam.snap(PI * 0.8, -0.16, 3.2)
	Input.action_press("move_back")
	Input.action_press("move_right")
	await _wait(0.45)
	await _shot("hero_walk")
	Input.action_release("move_back")
	Input.action_release("move_right")
	await _wait(0.4)
	_home()
	cam.snap(0.0, -0.26, 6.5)
	swords.auto_attack = true

	player.set_realm(4)
	await _wait(1.6)
	await _shot("02_huashen_swords")

	# 出剑拖尾：万剑齐发，看剑光是否是一条条可读的细线
	player.set_realm(5)
	await _wait(0.6)
	swords.burst()
	await _wait(0.3)
	await _shot("04_strike_trails")
	cam.snap(0.7, -0.32, 11.0)
	swords.burst()
	await _wait(0.35)
	await _shot("04_strike_trails_wide")
	cam.snap(0.0, -0.26, 6.5)

	player.set_realm(0)
	await _wait(0.4)
	player.toggle_flight()
	Input.action_press("move_forward")
	await _wait(1.6)
	await _shot("03_lianqi_sword_ride")
	await _side_shot("03_lianqi_sword_ride_side", 1.25)
	Input.action_release("move_forward")
	player.toggle_flight()
	await _wait(1.0)

	# 结丹 / 元婴 / 炼虚 / 大乘：起飞、破空瞬间、巡航（背后 + 侧视）
	for idx: int in [2, 3, 5, 7]:
		_home()
		player.set_realm(idx)
		await _wait(0.8)
		player.toggle_flight()
		await _wait(0.4)
		await _shot("r%d_a_takeoff" % idx)
		await _wait(0.25)
		await _shot("r%d_a2_launch" % idx)
		Input.action_press("move_forward")
		await _wait(1.1)
		await _shot("r%d_b_cruise" % idx)
		await _side_shot("r%d_c_cruise_side" % idx, 1.05)
		Input.action_release("move_forward")
		player.toggle_flight()
		await _wait(1.2)
	get_tree().quit()


# ---------- 近战演示截图（-- --combat-shot） ----------

func _evn(kind: String) -> int:
	return int(_evc.get(kind, 0))


## 等到第 n0+1 次 kind 事件（返回是否等到）
func _wait_event(kind: String, n0: int, timeout := 3.0) -> bool:
	var t := 0.0
	while _evn(kind) == n0 and t < timeout:
		await get_tree().process_frame
		t += get_process_delta_time()
	if _evn(kind) == n0:
		print("[combat-shot] 未等到事件 ", kind)
	return _evn(kind) > n0


func _wait_until(cond: Callable, timeout := 3.0) -> bool:
	var t := 0.0
	while not cond.call() and t < timeout:
		await get_tree().process_frame
		t += get_process_delta_time()
	return cond.call()


## 两人面对面站好：主角在原点面朝 -Z，刀客在 dist 米外面朝主角
func _duel_reset(dist: float) -> void:
	player.velocity = Vector3.ZERO
	player.global_position = Vector3(0, 0.02, 0)
	player.face_now(0.0)
	duelist.place(Vector3(0, 0, -dist), PI)


## 读招弹反（演示用"玩家"）：刀客出刀判定前 0.07s 点按格挡；hold=true 则一直按住
func _bot_parry(hold := false) -> void:
	await _wait_until(func() -> bool: return duelist.time_to_hit() <= 0.07, 3.0)
	player.melee.press_guard()
	if not hold:
		await _wait(0.05)
		player.melee.release_guard()


## 刀客出一招，主角读招弹反；先从主角身后拍刀客的前摇，再切到侧面拍对刃
func _parry_round(kind: int, dist: float, windup_t: float, tag: String) -> void:
	_duel_reset(dist)
	cam.snap(0.42, -0.14, 5.2)
	await _wait(0.45)
	duelist.force_attack(kind)
	await _wait_until(func() -> bool: return duelist.attack_time() >= windup_t)
	await _shot(FEEL + "%s_windup" % tag)
	cam.snap(PI * 0.5, -0.1, 4.3)
	var n := _evn("parry")
	_bot_parry()
	if await _wait_event("parry", n):
		await _shot(FEEL + "%s_parry_clash" % tag)
		await _wait(0.22)
		await _shot(FEEL + "%s_parry_after" % tag)
	await _wait(0.7)


## 三连击：每段拍蓄势/命中顿刀/收势关键姿势
func _combo_round(prefix: String) -> void:
	var m := player.melee
	_duel_reset(2.3)
	cam.snap(1.1, -0.16, 4.8)
	await _wait(0.5)
	var n := _evn("hit")
	m.press_attack()
	await _wait_until(func() -> bool: return m.attack_time() >= 0.11)
	await _shot("%s_a1_windup" % prefix)
	await _wait_event("hit", n)
	await _shot("%s_a1_hit" % prefix)
	await _wait_until(func() -> bool: return m.attack_time() >= 0.25)
	await _shot("%s_a1_pose" % prefix)
	n = _evn("hit")
	m.press_attack()
	await _wait_until(func() -> bool: return m.step == 1 and m.attack_time() >= 0.085)
	await _shot("%s_a2_windup" % prefix)
	await _wait_event("hit", n)
	await _shot("%s_a2_hit" % prefix)
	await _wait_until(func() -> bool: return m.step == 1 and m.attack_time() >= 0.24)
	await _shot("%s_a2_pose" % prefix)
	n = _evn("hit")
	m.press_attack()
	await _wait_until(func() -> bool: return m.step == 2 and m.attack_time() >= 0.3)
	await _shot("%s_a3_windup" % prefix)
	await _wait_event("hit", n)
	await _shot("%s_a3_impact" % prefix)
	await _wait_until(func() -> bool: return m.step == 2 and m.attack_time() >= 0.95)
	await _shot("%s_a3_finish" % prefix)
	await _wait(0.6)


## 单刀命中：顿刀那一帧 → 碎块飞出 → 碎块落地
func _debris_round() -> void:
	var m := player.melee
	duelist.demo_reset()
	_duel_reset(2.3)
	cam.snap(0.9, -0.24, 4.2)
	await _wait(1.6)  # 等连续受击计数清零，避免刀客格挡
	var nh := _evn("hit")
	m.press_attack()
	if await _wait_event("hit", nh):
		await _shot(FEEL + "15_hit_impact")
		await _wait(0.12)
		await _shot(FEEL + "16_debris_fly")
		await _wait(0.4)
		await _shot(FEEL + "17_debris_ground")
	await _wait(0.6)


## 跳跃攻击：落下来时的空中斩
func _jump_attack_round() -> void:
	var m := player.melee
	duelist.demo_reset()
	_duel_reset(2.4)
	cam.snap(1.2, -0.1, 5.8)
	await _wait(1.6)
	player.jump()
	await _wait_until(func() -> bool: return player.velocity.y < 0.0 and player.global_position.y < 1.1, 1.5)
	var nh := _evn("hit")
	m.press_attack()
	await _wait_until(func() -> bool: return m.attack_time() >= 0.09, 0.5)
	await _shot(FEEL + "40_jump_slash")
	if await _wait_event("hit", nh, 0.6):
		await _shot(FEEL + "41_jump_slash_hit")
	await _wait(1.3)


## 空中弹反：刀客上撩防空，主角跳起后在空中点按弹反，再空中反击
func _air_parry_round() -> void:
	var m := player.melee
	duelist.demo_reset()
	_duel_reset(2.4)
	cam.snap(PI * 0.5, -0.04, 5.6)
	await _wait(0.8)
	duelist.force_attack(Swordsman.A.RISE)
	await _wait_until(func() -> bool: return duelist.attack_time() >= 0.3, 1.0)
	player.jump()
	var np := _evn("parry")
	_bot_parry()
	if await _wait_event("parry", np, 1.5):
		await _shot(FEEL + "44_air_parry")
		await _wait(0.1)
		var nh := _evn("hit")
		m.press_attack()
		if await _wait_event("hit", nh, 1.0):
			await _shot(FEEL + "45_air_counter")
	await _wait(1.2)


func _run_combat_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	swords.auto_attack = false
	player.set_realm(2, false)
	duelist.ai_enabled = false
	duelist.block_chance = 0.0
	cam.focus_yaw = false
	cam.focus_mix = 0.5
	var m := player.melee

	# 0. 刀客进入 8m 内自动拔剑：戒备架势 + 飞剑收到背后
	_duel_reset(6.5)
	cam.snap(0.75, -0.2, 6.0)
	await _wait(1.4)
	await _shot(FEEL + "00_ready")
	# 放大一圈后的近战持剑（近景）
	cam.snap(0.95, -0.1, 2.6)
	await _wait(0.3)
	await _shot(FEEL + "00b_weapon")

	# 1. 挥空：干脆收招，只有剑光，没有火星、碎块和顿帧
	cam.snap(1.1, -0.16, 4.8)
	m.press_attack()
	await _wait_until(func() -> bool: return m.attack_time() >= 0.19)
	await _shot(FEEL + "01_whiff")
	await _wait(0.8)

	# 2. 三段连招
	await _combo_round(FEEL + "02")

	# 3. 读招弹反：横斩 / 刺击；中间穿插一次按住格挡
	await _parry_round(Swordsman.A.SWEEP, 2.1, 0.46, "03_sweep")
	if not duelist.is_broken():
		await _parry_round(Swordsman.A.THRUST, 2.6, 0.5, "04_thrust")
	if not duelist.is_broken():
		_duel_reset(2.1)
		cam.snap(PI * 0.5, -0.1, 4.3)
		await _wait(0.4)
		duelist.force_attack(Swordsman.A.SWEEP)
		await _wait_until(func() -> bool: return duelist.attack_time() >= 0.3)
		var nb := _evn("block")
		m.press_guard()
		if await _wait_event("block", nb):
			await _shot(FEEL + "05_block")
		await _wait(0.2)
		m.release_guard()
		await _wait(0.8)
	# 延迟重击：举刀悬停骗早弹，红光亮起后才落刀
	var tries := 0
	while not duelist.is_broken() and tries < 3:
		await _parry_round(Swordsman.A.HEAVY, 2.1, 0.75, "06_heavy" if tries == 0 else "06_heavy_%d" % tries)
		if not duelist.is_broken():
			await _combo_round(FEEL + "07_extra_%d" % tries)
		tries += 1

	# 4. 破防 → 处决
	await _wait_until(func() -> bool: return duelist.is_broken(), 1.0)
	await _wait(0.5)
	cam.snap(0.8, -0.18, 5.0)
	await _wait(0.1)
	await _shot(FEEL + "08_posture_break")
	var ne := _evn("execute")
	m.press_attack()
	if await _wait_event("execute", ne):
		await _shot(FEEL + "09_deathblow")
		await _wait(0.5)
		await _shot(FEEL + "10_deathblow_after")
	await _wait(1.2)
	await _shot(FEEL + "11_fallen")
	await _wait_until(func() -> bool: return not duelist.visual.visible, 2.0)
	await _wait(0.12)
	await _shot(FEEL + "11b_dissolve")

	# 5. 不防不弹：硬吃一刀（扣血、涨架势、主角身上崩出碎块）
	await _wait_until(func() -> bool: return duelist.is_alive() and duelist.visual.scale.x > 0.95, 6.0)
	_duel_reset(2.1)
	cam.snap(0.42, -0.14, 5.2)
	await _wait(0.4)
	var nh := _evn("hurt")
	duelist.force_attack(Swordsman.A.SWEEP)
	if await _wait_event("hurt", nh):
		await _shot(FEEL + "12_player_hit")
		await _wait(0.3)
		await _shot(FEEL + "12b_player_debris")
	await _wait(0.8)

	# 6. 打击感细节：单刀命中的顿刀 / 碎块飞出 / 碎块落地
	await _debris_round()
	# 7. 跳斩；空中弹反
	await _jump_attack_round()
	await _air_parry_round()

	# 8. 收剑起飞再落地：遁光规则不受影响，落地后重新拔剑
	duelist.demo_reset()
	_duel_reset(3.0)
	await _wait(0.6)
	player.toggle_flight()
	await _wait(0.35)
	await _shot(FEEL + "13_takeoff_sheathed")
	player.toggle_flight()
	await _wait(1.6)
	_duel_reset(3.0)
	cam.snap(0.75, -0.2, 6.0)
	await _wait(0.8)
	await _shot(FEEL + "14_landed_ready")
	print("[combat-shot] 事件计数 ", _evc)
	get_tree().quit()


# ---------- 飞行表现演示截图（-- --fx-shot） ----------

func _run_fx_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	swords.auto_attack = false
	await _wait(1.2)

	# 筑基御风：巡航时的风丝（背后 + 侧视）
	player.set_realm(1, false)
	await _wait(0.4)
	player.toggle_flight()
	await _wait(0.6)
	Input.action_press("move_forward")
	await _wait(1.4)
	await _shot(FX + "01_zhuji_cruise")
	await _side_shot(FX + "02_zhuji_cruise_side", 1.1)
	Input.action_release("move_forward")
	player.toggle_flight()
	await _wait(1.0)

	# 结丹：化作光剑起飞（化剑途中 → 光剑升空）
	_home()
	player.set_realm(2, false)
	cam.snap(0.9, -0.12, 5.0)
	await _wait(1.0)
	player.toggle_flight()
	await _wait(0.07)
	await _shot(FX + "03_jiedan_morph")
	await _wait_until(func() -> bool: return player.morph_k() >= 1.0, 1.0)
	await _wait(0.05)
	await _shot(FX + "04_jiedan_sword_rise")
	await _wait(0.6)
	cam.snap(0.0, CameraRig.PITCH_DEFAULT, 6.5)
	Input.action_press("move_forward")
	await _wait(1.0)
	await _shot(FX + "05_jiedan_cruise")
	await _side_shot(FX + "06_jiedan_cruise_side", 1.1)

	# 飞行跟随镜头俯仰：默认视角平飞，抬头爬升，低头俯冲
	var y0 := player.global_position.y
	await _wait(0.5)
	print("[fx-shot] 默认视角 0.5s 高度 %.1f -> %.1f" % [y0, player.global_position.y])
	y0 = player.global_position.y
	cam.pitch = 0.5
	await _wait(0.8)
	print("[fx-shot] 抬头 0.8s 高度 %.1f -> %.1f" % [y0, player.global_position.y])
	await _shot(FX + "07_pitch_up_climb")
	y0 = player.global_position.y
	cam.pitch = -0.9
	await _wait(0.5)
	print("[fx-shot] 低头 0.5s 高度 %.1f -> %.1f" % [y0, player.global_position.y])
	Input.action_release("move_forward")
	cam.pitch = CameraRig.PITCH_DEFAULT

	# 悬停：由光剑现形
	await _wait_until(func() -> bool: return player.morph_k() < 0.55, 3.0)
	await _shot(FX + "08_reappear")
	await _wait(0.5)
	player.toggle_flight()
	await _wait(1.5)

	# 闪现：结丹在地面横向闪现（侧视，朝 -Z 的空旷方向；+Z 方向 10m 处有方块会挡住）
	_home()
	cam.snap(PI * 0.5, -0.12, 8.0)
	await _wait(0.6)
	var p0 := player.global_position
	Input.action_press("move_right")
	player.blink()
	Input.action_release("move_right")
	await _wait(0.1)
	await _shot(FX + "09_blink_ground_mid")
	await _wait_until(func() -> bool: return not player.is_dashing(), 1.0)
	print("[fx-shot] 结丹闪现位移 %.1fm" % player.global_position.distance_to(p0))
	await _wait(0.05)
	await _shot(FX + "10_blink_ground_end")
	await _wait(1.0)

	# 闪现：大乘空中闪现（结丹起距离统一 8m，只是更快）
	_home()
	player.set_realm(7, false)
	cam.snap(0.0, CameraRig.PITCH_DEFAULT, 6.5)
	await _wait(0.6)
	player.toggle_flight()
	await _wait_until(func() -> bool: return player.morph_k() <= 0.0 and player.st == Player.St.FLY, 4.0)
	await _wait(0.3)
	cam.snap(PI * 0.5, -0.12, 9.0)
	await _wait(0.2)
	p0 = player.global_position
	Input.action_press("move_left")
	player.blink()
	Input.action_release("move_left")
	await _wait(0.06)
	await _shot(FX + "11_blink_air_mid")
	await _wait_until(func() -> bool: return not player.is_dashing(), 1.0)
	print("[fx-shot] 大乘闪现位移 %.1fm" % player.global_position.distance_to(p0))
	await _wait(0.03)
	await _shot(FX + "12_blink_air_end")
	await _wait(0.8)
	get_tree().quit()


# ---------- Shift 闪现 / 空战法术演示截图（-- --air-shot） ----------

## 模拟一次 Shift 按下 / 松开（走真实的输入事件，验证短按 / 长按判定）
func _shift(on: bool) -> void:
	_act("sprint", on)


func _act(action: String, on: bool) -> void:
	var ev := InputEventAction.new()
	ev.action = action
	ev.pressed = on
	Input.parse_input_event(ev)


func _tap_shift_toward(move: String) -> void:
	Input.action_press(move)
	_shift(true)
	await _wait(0.08)
	_shift(false)
	await get_tree().process_frame
	await get_tree().process_frame
	Input.action_release(move)


func _run_air_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	swords.auto_attack = false
	await _wait(1.2)

	# 炼气：短按 Shift 闪现（侧视，朝 -Z 的空旷方向），沿途留残影
	cam.snap(PI * 0.5, -0.12, 8.0)
	await _wait(0.5)
	var p0 := player.global_position
	await _tap_shift_toward("move_right")
	await _wait(0.04)
	await _shot(AIR + "01_lianqi_blink_ghosts")
	await _wait_until(func() -> bool: return not player.is_dashing(), 1.0)
	print("[air-shot] 炼气短按 Shift：闪现位移 %.1fm" % player.global_position.distance_to(p0))
	await _shot(AIR + "02_lianqi_blink_end")
	await _wait(0.6)

	# 长按 Shift：只疾行，松开也不闪现
	_home()
	await _wait(0.5)
	p0 = player.global_position
	_shift(true)
	await _wait(0.45)
	var sprint_on := player.sprinting()
	_shift(false)
	await _wait(0.2)
	print("[air-shot] 长按 Shift 0.45s：疾行=%s，松开后闪现=%s，位移 %.1fm" % [
		sprint_on, player.is_dashing(), player.global_position.distance_to(p0)])

	# 结丹：闪现统一 8m，化光剑
	player.set_realm(2, false)
	_home()
	await _wait(0.6)
	p0 = player.global_position
	await _tap_shift_toward("move_right")
	await _wait_until(func() -> bool: return not player.is_dashing(), 1.0)
	print("[air-shot] 结丹短按 Shift：闪现位移 %.1fm" % player.global_position.distance_to(p0))
	await _wait(0.6)

	# 结丹空战：空格腾空，镜头对准一个木桩
	_home()
	var tgt: EnemyDummy = null
	for n in get_tree().get_nodes_in_group("enemies"):
		var e := n as EnemyDummy
		var dd := e.global_position.distance_to(player.global_position)
		if e.kind == 0 and dd > 10.0 and (tgt == null or dd < tgt.global_position.distance_to(player.global_position)):
			tgt = e
	var d := tgt.global_position - player.global_position
	cam.snap(atan2(-d.x, -d.z), CameraRig.PITCH_DEFAULT, 6.0)
	await _wait(0.8)
	var y0 := player.global_position.y
	_act("jump", true)
	await _wait(0.05)
	_act("jump", false)
	await _wait(0.08)
	await _shot(AIR + "03_takeoff")
	await _wait(0.5)
	print("[air-shot] 空格腾空：%s，高度 %.1f -> %.1f" % [player.state_text(), y0, player.global_position.y])
	var hp0 := tgt.hp

	# 三段：御剑三连刺 → 火球 → 剑火齐发（出招中预输入下一段）
	var c := player.caster
	c.press_attack()
	await _wait(0.1)
	await _shot(AIR + "04_s1_summon")
	await _wait(0.16)
	await _shot(AIR + "05_s1_swords_fly")
	c.press_attack()
	await _wait_until(func() -> bool: return c.step == 1, 1.0)
	await _wait(0.2)
	await _shot(AIR + "06_s2_fireball_fly")
	await _wait(0.22)
	await _shot(AIR + "07_s2_fireball_boom")
	c.press_attack()
	await _wait_until(func() -> bool: return c.step == 2, 1.0)
	await _wait(0.22)
	await _shot(AIR + "08_s3_charge")
	await _wait(0.3)
	await _shot(AIR + "09_s3_volley")
	await _wait(0.3)
	await _shot(AIR + "10_s3_boom")
	await _wait(0.3)
	await _shot(AIR + "11_s3_after")
	await _wait(0.4)
	print("[air-shot] 三段打完：木桩血量 %d -> %d（预期约 -%d），连段结束 step=%d" % [
		hp0, tgt.hp, int(float(player.realm["dmg"]) * (0.6 * 3 + 1.5 + 2.6 + 0.5 * 6)), c.step])

	# 低头俯冲：碰到地面即落地
	cam.pitch = -1.1
	Input.action_press("move_forward")
	var landed: bool = await _wait_until(func() -> bool: return player.st == Player.St.GROUND, 3.0)
	Input.action_release("move_forward")
	cam.pitch = CameraRig.PITCH_DEFAULT
	print("[air-shot] 低头俯冲：落地=%s，状态 %s，高度 %.2f" % [landed, player.state_text(), player.global_position.y])
	await _wait(0.1)
	await _shot(AIR + "12_landed")
	await _wait(0.5)
	get_tree().quit()


# ---------- 升阶 / 闪避 / 碎裂演示截图（-- --realm-shot） ----------

const REALM := "realm_"


func _run_realm_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	swords.auto_attack = false
	duelist.ai_enabled = false
	duelist.block_chance = 0.0
	cam.focus_yaw = false
	duelist.place(Vector3(0, 0, -14.0), PI)
	cam.snap(PI * 0.82, -0.1, 5.2)
	await _wait(1.0)

	# 1. 炼气 → 筑基：聚气 / 破境 / 题字书写中 / 题字写完 / 淡出
	player.set_realm(1)
	await _wait(0.25)
	await _shot(REALM + "01_zhuji_gather")
	await _wait(0.3)
	await _shot(REALM + "02_zhuji_burst")
	await _wait(0.55)
	await _shot(REALM + "03_zhuji_writing")
	await _wait(1.0)
	await _shot(REALM + "04_zhuji_full")
	await _wait(1.5)
	await _shot(REALM + "05_zhuji_fadeout")
	await _wait(1.0)

	# 2. 其余各阶：破境那一下 + 题字写完
	for idx: int in [2, 3, 4, 5, 6, 7]:
		player.set_realm(idx)
		await _wait(0.6)
		await _shot(REALM + "1%d_burst" % idx)
		await _wait(1.55)
		await _shot(REALM + "1%d_full" % idx)
		await _wait(1.6)

	# 3. 完美闪避 → 瞬移斩（结丹）
	player.set_realm(2, false)
	duelist.demo_reset()
	_duel_reset(2.1)
	cam.snap(PI * 0.5, -0.12, 6.0)
	await _wait(1.6)
	duelist.force_attack(Swordsman.A.SWEEP)
	await _wait_until(func() -> bool: return duelist.time_to_hit() <= 0.12, 3.0)
	var p0 := player.global_position
	Input.action_press("move_left")
	player.blink()
	Input.action_release("move_left")
	var ok := await _wait_event("perfect_dodge", 0, 1.0)
	await _wait(0.05)
	print("[realm-shot] 完美闪避=%s 闪避距离 %.1fm 时间流速 %.2f" % [ok, player.global_position.distance_to(p0), Engine.time_scale])
	await _shot(REALM + "20_perfect_dodge_slowmo")
	var nw := _evn("warp")
	player.melee.press_attack()
	var warped := await _wait_event("warp", nw, 1.0)
	await _wait(0.03)
	print("[realm-shot] 瞬移斩=%s 离刀客 %.1fm" % [warped, player.global_position.distance_to(duelist.global_position)])
	await _shot(REALM + "21_warp_strike")
	await _wait(0.6)

	# 4. 死亡碎裂 + 消融：刀客被斩 / 木桩被击碎
	duelist.demo_reset()
	_duel_reset(2.4)
	cam.snap(0.9, -0.2, 5.5)
	await _wait(0.5)
	duelist.begin_deathblow()
	duelist.deathblow_hit(Vector3(0, 0, -1))
	await _wait(0.5)
	await _shot(REALM + "30_shatter")
	await _wait(0.5)
	await _shot(REALM + "31_shatter_fall")
	await _wait(0.6)
	await _shot(REALM + "32_dissolve")
	await _wait(0.6)
	await _shot(REALM + "33_dissolve_late")
	var tgt: EnemyDummy = null
	for n in get_tree().get_nodes_in_group("enemies"):
		var e := n as EnemyDummy
		if e.kind == 0 and (tgt == null or e.global_position.length() < tgt.global_position.length()):
			tgt = e
	var d := tgt.global_position - player.global_position
	cam.snap(atan2(-d.x, -d.z), -0.2, 4.0)
	player.global_position = tgt.global_position - d.normalized() * 3.0
	await _wait(0.4)
	tgt.take_hit(9999.0, d.normalized(), Realm.line_color(player.realm))
	await _wait(0.3)
	await _shot(REALM + "34_dummy_shatter")
	await _wait(1.1)
	await _shot(REALM + "35_dummy_dissolve")
	await _wait(0.5)
	get_tree().quit()


# ---------- 剑冢 Boss 空战自检（-- --boss-test） ----------

const BOSS_SHOT := "boss_"


## 有渲染才截图（--headless 下只跑逻辑、打印）
func _boss_shot(tag: String) -> void:
	if DisplayServer.get_name() == "headless":
		return
	await _shot(BOSS_SHOT + tag)


func _boss_walk_in() -> bool:
	var to := arena.center() - player.global_position
	cam.snap(atan2(-to.x, -to.z), -0.1, 6.5)
	Input.action_press("move_forward")
	var ok: bool = await _wait_until(func() -> bool: return arena.active(), 12.0)
	Input.action_release("move_forward")
	return ok


func _boss_watch(tag: String, sec: float) -> void:
	var peak := 0
	var t := 0.0
	while t < sec:
		await get_tree().process_frame
		t += get_process_delta_time()
		peak = maxi(peak, arena.bullets.count())
		arena.hp = maxf(arena.hp, 40.0)  # 自检不让主角倒下
	print("[boss-test] %s：%.1fs 内同屏弹数峰值 %d，当前 %d，主角中弹 %d 次，护体 %d" % [
		tag, sec, peak, arena.bullets.count(), arena.hits, int(arena.hp)])


func _run_boss_test() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	swords.auto_attack = false
	player.set_realm(0, false)
	await _wait(0.8)
	var b := arena.boss
	print("[boss-test] Boss：%s · %s（%s）血量 %d，剑冢中心 %s，状态 %d" % [
		BossArena.Boss.TITLE, BossArena.Boss.NAME, BossArena.Boss.RANK, int(b.max_hp), arena.center(), b.state])

	# 0. 沉睡：入口处看立在剑冢正中的方块魔像
	player.force_ground()
	player.global_position = arena.entrance()
	var to0 := arena.center() - player.global_position
	cam.snap(atan2(-to0.x, -to0.z), 0.22, 9.0)
	await _wait(0.6)
	await _boss_shot("00_dormant")

	# 1. 炼气从入口走进赤线：自动压境元婴、切空战、镜头锁定、Boss 开场
	var ok := await _boss_walk_in()
	print("[boss-test] 走进赤线自动开战=%s 境界=%s 状态=%s 镜头锁定=%s" % [
		ok, player.realm["name"], player.state_text(), cam.lock == b])
	await _wait(1.6)
	await _boss_shot("01_intro_roar")
	await _wait(1.3)
	print("[boss-test] 首次开战登场题名=%s" % arena.ui._banner.visible)
	await _boss_shot("01b_name")
	await _wait_until(func() -> bool: return b.state == BossArena.Boss.S.FIGHT, 5.0)
	print("[boss-test] 开场结束，进入战斗=%s 镜头距离目标 %.1f" % [b.state == BossArena.Boss.S.FIGHT, cam.lock_zoom])

	# 2. 一阶：看一会儿弹幕（主角不动挨打，确认判定生效）
	await _boss_watch("一阶 " + b.phase_title(), 4.0)
	await _boss_shot("02_phase1")
	var tgt: Array = player.caster._pick()
	print("[boss-test] 空战法术自动索敌到 Boss=%s" % [tgt[0] == b])
	# 2b. 真打：元婴空战法术三段连按 4 秒（不走作弊伤害），看 Boss 掉血、估算整场用时
	var hp0 := b.hp
	var tt := 0.0
	while tt < 4.0:
		player.caster.press_attack()
		await _wait(0.2)
		tt += 0.2
		arena.hp = maxf(arena.hp, 40.0)
	await _wait(0.8)
	var dps := (hp0 - b.hp) / 4.8
	print("[boss-test] 法术真打 4s：Boss 血量 %d -> %d（约 %d/s，三段连按满血打完约 %ds，不算转阶段）" % [
		int(hp0), int(b.hp), int(dps), int(b.max_hp / maxf(dps, 1.0))])

	# 3. 护体打空 → 败 → 送回入口 → 再走进来重开
	arena.hp = 5.0
	arena._iframe = 0.0
	arena._on_bullet_hit(player.center(), Vector3.FORWARD, 10.0)
	print("[boss-test] 护体打空：战况=%d Boss 状态=%d" % [arena.state, b.state])
	await _wait(3.2)
	print("[boss-test] 送回入口：离剑冢中心 %.1fm（赤线 %.0fm）战况=%d" % [
		Vector2(player.global_position.x - arena.center().x, player.global_position.z - arena.center().z).length(),
		BossArena.TRIGGER_R, arena.state])
	ok = await _boss_walk_in()
	print("[boss-test] 再次走进赤线重开=%s" % ok)
	await _wait_until(func() -> bool: return b.state == BossArena.Boss.S.FIGHT, 6.0)
	print("[boss-test] 再次开战不再题名=%s" % (not arena.ui._banner.visible))

	# 4. 打到 70%：转二阶
	var dir := Vector3.FORWARD
	b.take_hit(b.max_hp * 0.5, dir, Color.WHITE)
	print("[boss-test] 一刀打掉 50%%：血量 %.0f%%（阶段闸门 70%%），状态=%d" % [b.hp_ratio() * 100.0, b.state])
	await _wait(1.0)
	await _boss_shot("03_shift")
	await _wait_until(func() -> bool: return b.state == BossArena.Boss.S.FIGHT, 5.0)
	await _boss_watch("二阶 " + b.phase_title(), 5.0)
	await _boss_shot("04_phase2")

	# 5. 打到 35%：转三阶
	b.take_hit(b.max_hp * 0.4, dir, Color.WHITE)
	await _wait_until(func() -> bool: return b.state == BossArena.Boss.S.FIGHT and b.phase == 2, 6.0)
	await _boss_watch("三阶 " + b.phase_title(), 6.0)
	await _boss_shot("05_phase3")

	# 6. 每一招单独放一遍，确认都能跑
	for p: String in ["fan", "ring", "swords", "orbs", "spiral", "curve", "wall", "rose"]:
		var n0: int = arena.bullets.count()
		var dur: float = b._cast(p)
		await _boss_watch("招式 %s（时长 %.1fs，出手前 %d 颗）" % [p, dur, n0], minf(dur, 2.0))
		await _boss_shot("06_" + p)

	# 7. 击败：碎裂、伏诛、HUD 大字；之后重新凝聚
	b.take_hit(b.max_hp, dir, Color.WHITE)
	print("[boss-test] 致命一击：Boss 状态=%d 可索敌=%s 弹幕清屏中 %d" % [b.state, b.alive, arena.bullets.count()])
	await _wait(1.2)
	await _boss_shot("07_dying")
	await _wait_until(func() -> bool: return b.state == BossArena.Boss.S.DEAD, 6.0)
	await _boss_shot("08_shatter")
	print("[boss-test] 击败：Boss 状态=%d 战况=%d（3=胜）镜头锁定=%s" % [b.state, arena.state, cam.lock != null])
	await _wait(2.5)
	print("[boss-test] 击败 2.5s 后：镜头锁定=%s 弹数 %d" % [cam.lock != null, arena.bullets.count()])
	get_tree().quit()


# ---------- 打击特效对照截图（-- --hitfx-shot） ----------

func _run_hitfx_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	swords.auto_attack = false
	player.set_realm(4, false)
	cam.snap(0.0, -0.1, 5.0)
	await _wait(1.2)
	var c := Realm.line_color(player.realm)
	var r := cam.global_basis.x
	var f := -cam.global_basis.z
	f = Vector3(f.x, 0.0, f.z).normalized()
	var at := func(i: float) -> Vector3: return player.global_position + f * 2.0 + r * i * 1.6 + Vector3.UP * 1.2

	# 飞剑命中：三个不同方向
	Vfx.hit(at.call(-1.0), (f + r).normalized(), c)
	Vfx.hit(at.call(0.0), -r, c)
	Vfx.hit(at.call(1.0), (f - r + Vector3.UP * 0.5).normalized(), c)
	await _wait(0.06)
	await _shot(HITFX + "01_sword_hit_early")
	await _wait(0.16)
	await _shot(HITFX + "02_sword_hit_late")
	await _wait(0.8)

	# 近战分档：轻击 / 重击 / 下砸 / 处决
	var blade := Color(0.75, 0.88, 1.0)
	Vfx.impact(at.call(-1.5), r, blade, 0)
	Vfx.impact(at.call(-0.5), r, blade, 1)
	Vfx.impact(at.call(0.5), r, blade, 4)
	Vfx.impact(at.call(1.5), r, Color(0.95, 0.2, 0.15), 3)
	await _wait(0.08)
	await _shot(HITFX + "03_impact_early")
	await _wait(0.22)
	await _shot(HITFX + "04_impact_late")
	await _wait(0.8)

	# 弹反对刃
	Vfx.blade_clash(at.call(0.0), f, 1.0)
	await _wait(0.1)
	await _shot(HITFX + "05_parry_early")
	await _wait(0.3)
	await _shot(HITFX + "06_parry_late")
	await _wait(0.8)

	# 死亡：当场击碎（左）与倒地内爆（右，炸开对上 1.5s 时刻）
	Vfx.death_implode(at.call(1.0), Color(1.0, 0.22, 0.16))
	await _wait(0.6)
	await _shot(HITFX + "07_implode_gather")
	await _wait(Vfx.implode_lead() - 0.6)
	Vfx.death_burst(at.call(-1.0), c)
	await _wait(0.08)
	await _shot(HITFX + "08_death_pop")
	await _wait(0.3)
	await _shot(HITFX + "09_death_spread")
	await _wait(1.2)
	get_tree().quit()


# ---------- 择境门 / 木兰草原演示（-- --meadow-shot） ----------

const MEADOW := "meadow_"


func _meadow_shot(tag: String) -> void:
	if DisplayServer.get_name() != "headless":
		await _shot(MEADOW + tag)


func _meadow_print(tag: String) -> void:
	print("[meadow-shot] %s：%s" % [tag, level.stats_text().replace("\n", " | ")])


## 飞 sec 秒：前进（可开疾遁），按前方地面高度调镜头俯仰保持离地 alt 米（贴地高速飞是流式加载最吃力的情形）；
## 返回 [最低前方覆盖率, 脚下不是 LOD0 的帧数, 总帧数]
func _meadow_cruise(sec: float, alt: float, boost: bool, print_every := 1.0) -> Array:
	Input.action_press("move_forward")
	if boost:
		_shift(true)
	var t := 0.0
	var next := print_every
	var min_ahead := 1.0
	var bad := 0
	var frames := 0
	while t < sec:
		await get_tree().process_frame
		t += get_process_delta_time()
		frames += 1
		var p := player.global_position
		var v := player.velocity
		var ahead := p + Vector3(v.x, 0.0, v.z) * 1.2
		var g := maxf(level.terrain.height_at(p.x, p.z), level.terrain.height_at(ahead.x, ahead.z))
		cam.pitch = CameraRig.PITCH_DEFAULT + clampf((g + alt - p.y) * 0.012, -0.45, 0.6)
		var s := level.terrain.stats()
		if t > 1.0:
			min_ahead = minf(min_ahead, float(s["ahead"]))
		if int(s["under"]) != 0 and p.y - g < 60.0:
			bad += 1
		if t >= next:
			next += print_every
			_meadow_print("%.0fs 离地 %.0fm" % [t, p.y - level.terrain.height_at(p.x, p.z)])
	if boost:
		_shift(false)
	Input.action_release("move_forward")
	cam.pitch = CameraRig.PITCH_DEFAULT
	return [min_ahead, bad, frames]


func _run_meadow_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	swords.auto_attack = false
	# 1. 大厅里的择境门（门心里是草原）
	player.global_position = hall_portal.front(14.0) + Vector3(0, 0.1, 0)
	cam.snap(PI * 0.5 + 0.3, -0.1, 6.5)
	await _wait(2.5)
	await _meadow_shot("00_hall_portal")
	cam.snap(PI * 0.5, -0.06, 4.0)
	await _wait(0.5)
	await _meadow_shot("00b_hall_portal_close")
	# 2. 走进门 → 择境
	cam.snap(PI * 0.5, -0.12, 6.5)
	Input.action_press("move_forward")
	var opened: bool = await _wait_until(func() -> bool: return level_ui.is_open(), 8.0)
	Input.action_release("move_forward")
	print("[meadow-shot] 走进择境门弹出选关=%s 暂停=%s" % [opened, get_tree().paused])
	await _wait(0.3)
	await _meadow_shot("01_select")
	level_ui.pick(0, true)
	var t0 := Time.get_ticks_msec()
	var entered: bool = await _wait_until(func() -> bool: return level != null and not _switching, 25.0)
	print("[meadow-shot] 进入木兰草原=%s 用时 %dms 出生点 %s" % [entered, Time.get_ticks_msec() - t0, player.global_position])
	if not entered:
		get_tree().quit()
		return
	# 3. 出生点：正对远山 / 回头看回程门和石碑 / 草地近景
	await _wait(1.0)
	_meadow_print("出生点")
	await _meadow_shot("02_spawn")
	var yaw := level.spawn_yaw()
	cam.snap(yaw + PI * 0.8, -0.16, 10.0)
	await _wait(0.6)
	await _meadow_shot("03_exit_portal")
	cam.snap(yaw + 0.7, -0.04, 3.0)
	await _wait(0.4)
	await _meadow_shot("04_grass_close")
	# 4. 炼气走上坡：贴地、踩草
	cam.snap(yaw, CameraRig.PITCH_DEFAULT, 6.5)
	Input.action_press("move_forward")
	await _wait(5.0)
	Input.action_release("move_forward")
	var p := player.global_position
	print("[meadow-shot] 走 5s：位置 %s 地面 %.2f 脚下差 %.2f 着地=%s" % [p, level.terrain.height_at(p.x, p.z),
			p.y - level.terrain.height_at(p.x, p.z), player.is_on_floor()])
	await _meadow_shot("05_walk")
	# 5. 筑基御风：低空巡航（升限按地面起算）
	player.set_realm(1, false)
	player.toggle_flight()
	await _wait(0.8)
	var r: Array = await _meadow_cruise(4.0, 18.0, false, 2.0)
	await _meadow_shot("06_zhuji_low")
	await _side_shot(MEADOW + "06b_zhuji_low_side", 1.1)
	# 6. 大乘：爬高俯瞰
	player.force_ground()
	player.global_position.y = level.terrain.height_at(player.global_position.x, player.global_position.z) + 0.1
	player.set_realm(7, false)
	await _wait(0.3)
	player.toggle_flight()
	await _wait(1.0)
	r = await _meadow_cruise(4.0, 420.0, false, 2.0)
	cam.pitch = -0.55
	await _wait(0.3)
	await _meadow_shot("07_high_view")
	cam.pitch = CameraRig.PITCH_DEFAULT
	# 7. 大乘疾遁：高空直飞 8 秒（约 315 m/s）
	level.worst_frame_ms = 0.0
	r = await _meadow_cruise(8.0, 300.0, true, 1.0)
	print("[meadow-shot] 高空疾遁 8s：前方覆盖最低 %.0f%%，最长帧 %.1fms，%d 帧" % [float(r[0]) * 100.0, level.worst_frame_ms, r[2]])
	await _meadow_shot("08_high_speed")
	# 8. 大乘疾遁：贴地 40 米高速飞 10 秒（流式加载最吃力）
	level.worst_frame_ms = 0.0
	r = await _meadow_cruise(10.0, 40.0, true, 1.0)
	print("[meadow-shot] 贴地疾遁 10s：前方覆盖最低 %.0f%%，脚下没 LOD0 的帧 %d/%d，最长帧 %.1fms" % [
			float(r[0]) * 100.0, r[1], r[2], level.worst_frame_ms])
	await _meadow_shot("09_low_speed")
	await _side_shot(MEADOW + "09b_low_speed_side", 1.0)
	# 9. 遁光落地（砸在坡上）
	cam.pitch = -1.1
	player.toggle_flight()
	var landed: bool = await _wait_until(func() -> bool: return player.st == Player.St.GROUND, 6.0)
	cam.pitch = CameraRig.PITCH_DEFAULT
	p = player.global_position
	print("[meadow-shot] 落地=%s 高度差 %.2f" % [landed, p.y - level.terrain.height_at(p.x, p.z)])
	await _wait(1.0)
	await _meadow_shot("10_landed")
	# 10. 回出生点，走进回程门回大厅
	player.set_realm(0, false)
	player.force_ground()
	var door := level.exit_portal
	player.global_position = door.front(10.0) + Vector3.UP * 0.2
	var to := door.global_position - player.global_position
	cam.snap(atan2(-to.x, -to.z), CameraRig.PITCH_DEFAULT, 6.5)
	await _wait(1.5)
	await _meadow_shot("11_exit_portal_front")
	Input.action_press("move_forward")
	var back: bool = await _wait_until(func() -> bool: return level == null and not _switching, 15.0)
	Input.action_release("move_forward")
	print("[meadow-shot] 回大厅=%s 位置 %s 大厅可见=%s 敌人分组 %d" % [back, player.global_position, _hall_root.visible,
			get_tree().get_nodes_in_group("enemies").size()])
	await _wait(1.0)
	await _meadow_shot("12_back_in_hall")
	get_tree().quit()


# ---------- 空战斗法演示截图（-- --duel-shot） ----------

const DUEL := "duel_"


func _air_state() -> int:
	return int(player.air.state)


## 把主角摆到 e 的 +Z 方向 dist 米处（同高），侧视机位
func _duel_place(e: Node3D, dist: float, zoom := 7.0) -> void:
	player.velocity = Vector3.ZERO
	player.global_position = e.global_position + Vector3(0.0, 0.0, dist)
	player.face_now(0.0)
	cam.snap(PI * 0.5, -0.06, zoom)


## 联机自检要一路跑完：主角气血一直补满
func _net_immortal() -> void:
	while level != null and level.raid != null and level.raid.running:
		player.melee.hp = 100.0
		await get_tree().process_frame


func _net_role() -> String:
	for a: String in OS.get_cmdline_user_args():
		if a.begins_with("--net="):
			return a.substr(6)
	return ""


## 联机自检：同一台机器上开三个实例，`-- --net=host`（房主，双人队）、`-- --net=mate`（双人队，应和房主同队）、
## `-- --net=foe`（独行，是敌人）。各自打印看到了什么、打没打得到，结果存 _shots/net_<角色>.txt。
func _run_net_demo(role: String) -> void:
	var out: Array = []
	var say := func(s: String) -> void:
		print("[net:%s] %s" % [role, s])
		out.append(s)
	await _wait(1.0)
	if role == "ui":
		# 只看画面：大厅里的择境门（门心预览）和入图界面
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
		var front := hall_portal.front(9.0)
		player.global_position = front + Vector3(0, 0.1, 0)
		var to := hall_portal.center() - player.global_position
		cam.snap(atan2(-to.x, -to.z), -0.05, 5.0)
		await _wait(3.5)
		await _shot("net_ui_portal")
		level_ui.open()
		await get_tree().process_frame
		level_ui.pick(0)
		for i in 40:
			await get_tree().process_frame
		await _shot("net_ui_modes")
		get_tree().quit()
		return
	player.set_realm(4, false)
	net.my_name = {"host": "房主甲", "mate": "队友乙", "foe": "敌人丙"}.get(role, role)
	level_ui.team_size = 1 if role == "foe" else 2
	if role == "host":
		level_ui.mode = "host"
	else:
		await _wait(6.0 if role == "mate" else 9.0)   # 等房主建好；敌人最后进，顺便测中途加入
		level_ui.mode = "join"
		level_ui.join_ip = "127.0.0.1"
	await _enter_level("meadow")
	if level == null:
		say.call("没进去（加入失败）")
		get_tree().quit()
		return
	var rd = level.raid
	rd._mob_root.visible = true
	_net_immortal()
	say.call("进入大世界：联机=%s 我的编号 %d 房间 %d 人 种子 %d 亮着的传送阵 %s" % [net.active, net.my_id, net.players.size(), net.seed_v,
			str(rd._extracts.map(func(e: Dictionary) -> bool: return bool(e["active"])))])
	# 各自站开一点，免得叠在一起
	var off: Vector3 = {"host": Vector3(0, 0, 0), "mate": Vector3(5, 0, 0), "foe": Vector3(-5, 0, 3)}.get(role, Vector3.ZERO)
	player.global_position = level.spawn_point() + off
	var t_end := Time.get_ticks_msec() + 60000
	var hp_min := 100.0
	var seen_mobs := 0
	var ids := {}      # 角色名 → 玩家编号
	# 等三个人到齐
	while Time.get_ticks_msec() < t_end and (net.players.size() < 3 or net.remotes.size() < 2):
		await _wait(0.5)
	if net.players.size() < 3:
		say.call("没等到三个人到齐（房间 %d 人）" % net.players.size())
	else:
		for id: int in net.players.keys():
			var nm: String = net.players[id]["name"]
			ids["host" if nm == "房主甲" else ("mate" if nm == "队友乙" else "foe")] = id
		await _wait(1.5)
		# 1. 谁是队友、谁能打、索敌选谁
		for id: int in net.remotes.keys():
			var r: Node3D = net.remotes[id]
			var res: int = r.air_hit(player, {"dmg": 38.0, "dir": Vector3.FORWARD, "kb": 3.0})
			say.call("看到 %s：队友=%s 在索敌分组里=%s 打他一下返回 %d（-1 = 打不到）" % [r.display_name, r.mate, r.is_in_group("air_foes"), res])
		if role == "host":
			var mid := Vector3.ZERO
			for id2: int in net.remotes.keys():
				mid += (net.remotes[id2] as Node3D).global_position
			mid /= float(net.remotes.size())
			var tv := mid - player.global_position
			cam.snap(atan2(-tv.x, -tv.z), -0.12, 9.0)
			await _wait(0.6)
			await _shot("net_host_view")
		# 2. 共享掉落：房主在队友脚边丢一件，队友走上去应该自动拾走，三边地上都没了
		await _wait(1.0)
		var bag0: int = rd.bag.size()
		if role == "host":
			var mp2: Vector3 = (net.remotes[ids["mate"]] as Node3D).global_position
			rd._drop_item(mp2 + Vector3(0.0, 0.3, 0.0), RaidData.make_gear(2, RandomNumberGenerator.new()), 0.3)
		await _wait(0.6)
		var drops_mid: int = rd._drops.size()
		await _wait(2.0)
		say.call("共享掉落：丢下后我这边地上 %d 件 → 2 秒后 %d 件；我的背包 %d -> %d" % [drops_mid, rd._drops.size(), bag0, rd.bag.size()])
		# 3. 雷劫旁观：队友渡一场（自动点），另外两人应该在他头上看到劫云
		if role == "mate":
			player.set_realm(1, false)
			rd.gm_tribulation(2)
			await _wait_until(func() -> bool: return rd.trib_active(), 3.0)
			if rd.trib_active():
				rd._trib.demo_auto = 1.0
		else:
			await _wait(2.5)
			say.call("旁观雷劫：我这边有 %d 场别人的雷劫在播，对方状态位 %d（4 = 渡劫中）" % [rd._spec.size(), int(net.remotes[ids["mate"]].flags)])
			if role == "host":
				var tv2: Vector3 = (net.remotes[ids["mate"]] as Node3D).global_position - player.global_position
				cam.snap(atan2(-tv2.x, -tv2.z), 0.25, 12.0)
				await _wait(1.5)
				await _shot("net_host_trib")
		# 4. 玩家之间的飞剑对波：敌人朝房主连发 → 房主收到预警 → 点「剑」接波 → 两边都进相持 → 房主连点获胜
		if role != "mate":
			rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED   # 这一步把自己名下的怪定住，免得被打断
			await _wait(1.0)
			player.force_ground()
			player.melee.hp = 100.0
			# 两人挪到远处单独对上（离别的怪和人远一点，索敌才会选中对方）
			var spot := Vector3(300.0, 0.0, 10.0 if role == "host" else -10.0)
			spot.y = level.ground(spot.x, spot.z) + 0.1
			player.global_position = spot
			await level.prewarm(4.0)
			await _wait(0.4)
			player.take_air()
			await _wait(1.2)
			player.mp = player.mp_max()
			var other: Node3D = net.remotes[ids["foe" if role == "host" else "host"]]
			var air := player.air
			air.target = other
			if role == "foe":
				await _wait(3.0)      # 等房主那边也升空站好
				Input.action_press("air_shot")
				await _wait_until(func() -> bool: return player.caster.channeling, 4.0)
				await _wait(0.4)
				var tg2: Variant = player.caster.aim_target()
				say.call("我在连发飞剑=%s（空战=%s），瞄着 %s" % [player.caster.channeling, player.st == Player.St.AIR,
						str(tg2.get("display_name")) if tg2 != null else "无"])
				await _wait_until(func() -> bool: return air.in_clash(), 5.0)
				say.call("被房主接波后我也进了对波=%s 我做主=%s" % [air.in_clash(), air._clash_auth])
				var hp1: float = player.melee.hp
				await _wait_until(func() -> bool: return not air.in_clash(), 10.0)
				Input.action_release("air_shot")
				await _wait(0.3)
				say.call("对波结束：我的状态 %s 气血 %d -> %d" % [air.state_name(), int(hp1), int(player.melee.hp)])
			else:
				var warned: bool = await _wait_until(func() -> bool: return air.warn_k() > 0.0, 9.0)
				say.call("收到对波预警=%s（我在空战=%s）对方在连发=%s 飞剑画面已收到 %d 柄" % [warned, player.st == Player.St.AIR, other.is_volleying(),
						int(net.stat["proj"])])
				air.demo_mash = 7.0
				air.press_shot()
				await _wait(0.6)
				say.call("接波后进了对波=%s 我做主=%s 交汇点 %.2f" % [air.in_clash(), air._clash_auth, air.clash_u()])
				cam.snap(PI * 0.5, -0.05, 14.0)
				await _wait(0.5)
				await _shot("net_host_clash")
				await _wait_until(func() -> bool: return not air.in_clash(), 10.0)
				air.demo_mash = 0.0
				say.call("对波结束：我的状态 %s" % air.state_name())
		else:
			await _wait_until(func() -> bool: return not rd._in_trib, 30.0)
			say.call("雷劫结束：境界 %s" % player.realm["name"])
		await _wait(2.0)
	hp_min = minf(hp_min, player.melee.hp)
	seen_mobs = maxi(seen_mobs, rd._puppets.size())
	say.call("结束：房间 %d 人 本队 %d 人 眼前别人的怪 %d 只 自己名下 %d 只；收到别人的飞剑画面 %d 柄、打击特效 %d 次、被别人的怪打中 %d 次" % [net.players.size(),
			net.team_count(), seen_mobs, rd._mobs.size(), int(net.stat["proj"]), int(net.stat["fx"]), int(net.stat["mobhit"])])
	var f := FileAccess.open("res://_shots/net_%s.txt" % role, FileAccess.WRITE)
	if f != null:
		f.store_string("\n".join(out))
		f.close()
	get_tree().quit()


## `-- --duel-shot --trib`：在大厅里把各段位的雷劫各渡一遍（自动点击，命中率 85%；最后一场故意全不点看失败），截图 duel_t*
func _run_trib_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	foe.ai_enabled = false
	rival.ai_enabled = false
	await _wait(1.0)
	for item: Array in [[1, 0.9], [3, 0.9], [5, 0.9], [7, 0.9], [4, 0.0]]:
		var r: int = item[0]
		player.set_realm(r - 1, false)
		player.force_ground()
		_home()
		player.melee.hp = 100.0
		await _wait(0.4)
		var tb := Tribulation.new()
		tb.player = player
		tb.cam = cam
		tb.realm_to = r
		tb.demo_auto = item[1]
		var res := [false, 0, 0, false]
		tb.finished.connect(func(ok: bool, perfect: int, total: int) -> void:
			res[0] = ok
			res[1] = perfect
			res[2] = total
			res[3] = true
			if ok:
				player.set_realm(r))
		add_child(tb)
		var tref: WeakRef = weakref(tb)
		var tag := "t%d%s" % [r, "" if float(item[1]) > 0.0 else "_fail"]
		await _wait(1.3)
		await _shot(DUEL + "%s_intro" % tag)
		await _wait(2.4)
		await _shot(DUEL + "%s_play" % tag)
		if float(item[1]) > 0.0:
			# 等一道雷被挡下的那一瞬间再拍一张
			var d0: int = tb._done
			await _wait_until(func() -> bool: return tref.get_ref() == null or tref.get_ref()._done > d0 + 1, 4.0)
			await _shot(DUEL + "%s_block" % tag)
		await _wait_until(func() -> bool: return bool(res[3]), 20.0)
		await _wait(0.5)
		await _shot(DUEL + "%s_result" % tag)
		await _wait_until(func() -> bool: return tref.get_ref() == null, 6.0)
		print("[trib] 渡 %s（突破到 %s期）：%s 完美 %d / %d 气血 %d 结束后境界 %s 主角恢复处理=%s 镜头交还=%s" % [Tribulation.NAMES[r], Realm.LIST[r]["name"],
				"成功" if res[0] else "失败", res[1], res[2], int(player.melee.hp), player.realm["name"],
				player.process_mode == Node.PROCESS_MODE_INHERIT, cam.cine_k <= 0.001])
		await _wait(0.8)
	get_tree().quit()


## `-- --duel-shot --flair`：只跑「地面按攻击直接升空」和各境界的连段表现（结丹 → 大乘各打一套五连），截图 duel_f*
func _run_flair_demo() -> void:
	var AM := Player.AirMelee
	var air := player.air
	cam.lock_turn = false
	foe.ai_enabled = false
	rival.ai_enabled = false
	await _wait(1.0)
	# 筑基：地面按攻击仍是老的地面近战，不升空
	player.set_realm(1, false)
	_home()
	await _wait(0.3)
	player.melee.press_attack()
	await _wait(0.3)
	print("[flair] 筑基在地面按攻击：状态 %s（应仍在地面）" % ("空战" if player.st == Player.St.AIR else "地面"))
	await _wait(1.0)
	for realm_i: int in [2, 4, 5, 6, 7]:
		player.set_realm(realm_i, false)
		player.force_ground()
		_home()
		sandbag.demo_reset(player.global_position + Vector3(0.0, 2.2, -7.0))
		sandbag.hp_max = 99999.0
		sandbag.hp = 99999.0
		player.face_now(0.0)
		cam.snap(PI * 0.5, -0.06, 8.0)
		await _wait(0.5)
		# 地面上直接按攻击：应当腾空进入空战并开打
		var ev := InputEventAction.new()
		ev.action = "attack"
		ev.pressed = true
		Input.parse_input_event(ev)
		await _wait(0.12)
		var ev2 := InputEventAction.new()
		ev2.action = "attack"
		ev2.pressed = false
		Input.parse_input_event(ev2)
		var entered := player.st == Player.St.AIR
		var y_in := player.global_position.y
		air.target = sandbag
		air._engage = 99.0
		var hp0: float = sandbag.hp
		var tag := "f%d" % realm_i
		for i in 5:
			air.press_attack()
			await _wait_until(func() -> bool: return _air_state() == AM.A.ATTACK and air.step == i and air._hit_done, 3.0)
			await _wait(0.02)
			if i == 2 or i == 3:
				await _shot(DUEL + "%s_combo_%d" % [tag, i + 1])
			if i < 4:
				await _wait(0.12)
		await _shot(DUEL + "%s_finish" % tag)
		if realm_i == 4:
			# 空间破碎冲击帧：手动拉满拍一张看效果本身
			cam.impact_k = 1.0
			await _shot(DUEL + "f_shatter")
			cam.impact_k = 0.45
			await _shot(DUEL + "f_shatter_half")
			# 「诀」一个键按顺序轮放三式；长按「御」转聚气
			await _wait(1.5)
			player.mp = player.mp_max()
			for k in 3:
				air.cds[k] = 0.0
			var seq: Array = []
			for k in 4:
				seq.append(air.skill_name(air.next_skill()))
				air.press_art()
				await _wait(1.4)
			print("[flair] 「诀」连按四次放出的顺序：%s" % " → ".join(seq))
			player.threat.clear()
			player.mp = 20.0
			air.press_guard()
			await _wait(0.4)
			var st_a: String = air.state_name()
			await _wait(1.0)
			await _shot(DUEL + "f_buttons")
			print("[flair] 按住「御」0.4 秒：%s；1.4 秒：%s 灵力 20 -> %d" % [st_a, air.state_name(), int(player.mp)])
			air.release_guard()
			await _wait(0.3)
		await _wait(0.5)
		await _shot(DUEL + "%s_after" % tag)
		print("[flair] %s期（档位 %d）：地面按攻击升空=%s 五连打掉木人 %d 血 连击数 %d 木人被击飞=%s 主角仍在空战=%s 高度 %.1f -> %.1f" % [player.realm["name"], air.flair(), entered,
				int(hp0 - sandbag.hp), air.combo, sandbag.is_launched(), player.st == Player.St.AIR, y_in, player.global_position.y])
		await _wait(1.6)
	get_tree().quit()


## `-- --duel-shot --looks`：八个境界的装束各拍正面、背面两张（duel_look_<n>_front / back）
func _run_looks_demo() -> void:
	foe.ai_enabled = false
	rival.ai_enabled = false
	_home()
	await _wait(0.6)
	for i in Realm.count():
		player.set_realm(i, false)
		player.face_now(0.0)
		cam.snap(PI + 0.45, -0.1, 3.4)
		await _wait(0.5)
		await _shot(DUEL + "look_%d_front" % (i + 1))
		cam.snap(-0.5, -0.12, 3.6)
		await _wait(0.3)
		await _shot(DUEL + "look_%d_back" % (i + 1))
	get_tree().quit()


## `-- --duel-shot --yuanying`（大厅）/ `-- --raid-shot --raid-yuanying`（大世界）：结婴演出。不走雷劫，直接把境界设到元婴触发过场，
## 按七个分镜的时间点各拍一张（<前缀>yy_1_omen … yy_7_wide），放完再拍一张回到操作的画面；对照 _refs/yuanying_advance 里的参考图看
func _run_yuanying_demo(prefix: String, via_trib := false) -> void:
	var Cine = load("res://scripts/yuanying_cine.gd")
	if via_trib:
		# 走真实流程：外面已经起了元婴雷劫，这里等它收尾、把过场接上
		await _wait_until(func() -> bool: return Cine.playing != null, 60.0)
		print("[yy] 雷劫收尾接上过场=%s 主角离地 %.2f" % [Cine.playing != null, player.global_position.y - float(cam.floor_fn.call(player.global_position.x, player.global_position.z)) if cam.floor_fn.is_valid() else 0.0])
	else:
		player.set_realm(2, false)
		await _wait(0.5)
		cam.snap(cam.yaw, -0.15, 6.5)
		player.set_realm(3)
		await _wait(0.1)
	var marks := [[1.0, "0_rise"], [1.9, "1_omen"], [3.2, "2_sword"], [4.9, "3_pillar"], [6.9, "4a_break"], [7.9, "4_dawn"], [10.1, "5_face"], [12.7, "6_pull"], [14.7, "7_wide"], [16.1, "7b_absorb"]]
	for m: Array in marks:
		await _wait_until(func() -> bool: return Cine.playing == null or float(Cine.playing._t) >= float(m[0]), 25.0)
		if Cine.playing == null:
			print("[yy] 过场没有在播（在 %s 之前就结束了）" % m[1])
			break
		var c = Cine.playing
		print("[yy] %s t=%.2f 暗 %.2f 金 %.2f 云洞 %.2f 镜头离主角 %.0fm 视野 %.0f 帧率 %d" % [m[1], float(c._t), float(c.dark), float(c.gold), float(c.tear_k),
				cam.cam.global_position.distance_to(player.global_position), cam.cam.fov, int(Engine.get_frames_per_second())])
		await _shot(prefix + "yy_" + str(m[1]))
	await _wait_until(func() -> bool: return Cine.playing == null, 25.0)
	await _wait(0.8)
	await _shot(prefix + "yy_8_after")
	print("[yy] 过场结束：境界 %s 主角恢复处理=%s 镜头接管 %.2f 主角离地 %.2f" % [player.realm["name"], player.process_mode == Node.PROCESS_MODE_INHERIT, cam.cine_k,
			player.global_position.y - float(cam.floor_fn.call(player.global_position.x, player.global_position.z)) if cam.floor_fn.is_valid() else 0.0])
	if not via_trib:
		get_tree().quit()


## `-- --duel-shot --launchcam`：蓄满重击把木人打飞（上挑 / 平推 / 下砸）之后的自动镜头。镜头不摆机位、全程自动跟；
## 打飞后 0.25 / 0.7 / 1.4 秒各量一次：镜头离主角多远、木人飞出多远、两个人在不在画面里；再瞬身追上去量一次（duel_lc_*）
func _run_launchcam_demo() -> void:
	var AM := Player.AirMelee
	var air := player.air
	foe.ai_enabled = false
	rival.ai_enabled = false
	player.set_realm(4, false)
	await _wait(0.6)
	var vp := get_viewport().get_visible_rect()
	var seen := func(pos: Vector3) -> bool:
		return not cam.cam.is_position_behind(pos) and vp.grow(-8.0).has_point(cam.cam.unproject_position(pos))
	for kind: String in ["up", "fwd", "down"]:
		_home()
		await _wait(0.2)
		player.take_air()
		await _wait(0.8)
		sandbag.demo_reset(Vector3(-9.0, 9.0 if kind != "down" else 26.0, -13.0))
		player.global_position = sandbag.global_position + Vector3(0.0, 0.0, 9.0)
		player.velocity = Vector3.ZERO
		player.face_now(0.0)
		cam.lock_turn = true
		cam.snap(0.0, -0.1, 6.5)
		air._engage = 99.0
		air.target = sandbag
		await _wait(0.8)
		air.demo_heavy(kind, 1.2)
		var ok: bool = await _wait_until(func() -> bool: return _air_state() == AM.A.SMASH and air._hit_done, 3.0)
		var t_prev := 0.0
		for t: float in [0.25, 0.7, 1.4]:
			await _wait(t - t_prev)
			t_prev = t
			print("[lcam] %s 命中=%s 后 %.2fs：镜头离主角 %.1fm，木人离主角 %.1fm（被击飞=%s），主角在画面里=%s 木人在画面里=%s" % [kind, ok, t,
					cam.cam.global_position.distance_to(player.center()), sandbag.center().distance_to(player.center()), sandbag.is_launched(),
					seen.call(player.center()), seen.call(sandbag.center())])
			if t == 0.7:
				await _shot(DUEL + "lc_%s" % kind)
		if kind == "up":
			# 瞬身追上去接着打：镜头要跟着主角走
			var p0 := player.global_position
			air.press_attack()
			await _wait(0.45)
			print("[lcam] 瞬身追击 0.45s 后：主角挪了 %.1fm，镜头离主角 %.1fm，主角在画面里=%s" % [p0.distance_to(player.global_position),
					cam.cam.global_position.distance_to(player.center()), seen.call(player.center())])
			await _shot(DUEL + "lc_chase")
		await _wait(1.0)
	get_tree().quit()


## `-- --duel-shot --cape`：披风布料。站定背面近景 → 侧向跑动 → 急停 → 腾空悬停 → 空中疾飞，各拍一张（duel_cape_*），并打印布料那几帧的耗时
func _run_cape_demo() -> void:
	foe.ai_enabled = false
	rival.ai_enabled = false
	_home()
	player.set_realm(4, false)
	player.face_now(0.0)
	await _wait(1.5)
	cam.snap(-0.45, -0.1, 2.6)
	await _wait(0.3)
	await _shot(DUEL + "cape_0_stand")
	cam.snap(PI * 0.5, -0.08, 3.6)
	cam.yaw = PI * 0.5
	Input.action_press("move_left")
	await _wait(0.7)
	await _shot(DUEL + "cape_1_run")
	Input.action_release("move_left")
	await _wait(0.12)
	await _shot(DUEL + "cape_2_stop")
	await _wait(0.8)
	var cl: Variant = player.hero.cloth
	var t0 := Time.get_ticks_usec()
	for i in 200:
		cl.tick(1.0 / 60.0)
	print("[cape] 布料一帧 %.3f ms（%d 质点）" % [float(Time.get_ticks_usec() - t0) / 200000.0, cl.N])
	_home()
	player.take_air()
	await _wait(1.2)
	cam.snap(-0.5, -0.05, 3.0)
	await _wait(0.4)
	await _shot(DUEL + "cape_3_hover")
	cam.snap(PI * 0.5, -0.08, 4.5)
	cam.yaw = PI * 0.5
	Input.action_press("move_left")
	Input.action_press("sprint")
	await _wait(0.8)
	await _shot(DUEL + "cape_4_fly")
	Input.action_release("sprint")
	Input.action_release("move_left")
	await _wait(0.5)
	get_tree().quit()


func _run_duel_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	if OS.get_cmdline_user_args().has("--looks"):
		await _run_looks_demo()
		return
	if OS.get_cmdline_user_args().has("--cape"):
		await _run_cape_demo()
		return
	if OS.get_cmdline_user_args().has("--launchcam"):
		await _run_launchcam_demo()
		return
	if OS.get_cmdline_user_args().has("--yuanying"):
		foe.ai_enabled = false
		rival.ai_enabled = false
		await _wait(0.8)
		await _run_yuanying_demo(DUEL)
		return
	if OS.get_cmdline_user_args().has("--flair"):
		await _run_flair_demo()
		return
	var AM := Player.AirMelee
	var air := player.air
	cam.lock_turn = false
	foe.ai_enabled = false
	await _wait(1.0)
	player.set_realm(4, false)   # 化神期
	rival.ai_enabled = false

	# 0. R15 定妆：正面 / 侧面 / 跑动
	cam.snap(PI, -0.08, 3.6)
	await _wait(0.4)
	await _shot(DUEL + "00_model_front")
	cam.snap(PI * 0.5, -0.08, 3.6)
	await _wait(0.2)
	await _shot(DUEL + "00_model_side")
	cam.snap(PI * 0.5, -0.08, 4.5)
	cam.yaw = PI * 0.5
	Input.action_press("move_left")
	await _wait(0.45)
	await _shot(DUEL + "00_model_run")
	Input.action_release("move_left")
	await _wait(0.3)

	# 1. 腾空，凌空架势
	_home()
	await _wait(0.2)
	player.take_air()
	await _wait(0.8)
	_duel_place(sandbag, 6.0, 5.0)
	air._engage = 99.0
	air.target = sandbag
	await _wait(0.5)
	await _shot(DUEL + "01_air_stance")

	# 2. 五段追身连击
	var hp0 := sandbag.hp
	for i in 5:
		air.press_attack()
		await _wait_until(func() -> bool: return _air_state() == AM.A.ATTACK and air.step == i and air._hit_done, 2.0)
		await _wait(0.02)
		await _shot(DUEL + "02_combo_%d" % (i + 1))
		print("[duel] 连击 %d %s：间距 %.2f 连击数 %d 木人血 %d" % [i + 1, air.state_name(),
				player.center().distance_to(sandbag.center()), air.combo, int(sandbag.hp)])
		if i < 4:
			await _wait(0.12)
	await _wait(0.1)
	print("[duel] 五段打完：木人被击飞=%s 速度 %.1f 总伤害 %d" % [sandbag.is_launched(), sandbag.velocity().length(), int(hp0 - sandbag.hp)])
	cam.snap(PI * 0.5, -0.06, 14.0)
	await _wait(0.12)
	await _shot(DUEL + "03_launched")

	# 3. 瞬身追击：挑飞 → 陨落砸地
	var n := 0
	while n < 2 and sandbag.is_launched():
		air.press_attack()
		var ok: bool = await _wait_until(func() -> bool: return _air_state() == AM.A.SMASH and air._hit_done, 1.5)
		await _wait(0.02)
		await _shot(DUEL + "04_chase_%d" % (n + 1))
		print("[duel] 瞬身追击 %d：%s 命中=%s 木人速度 %s 灵力 %d" % [n + 1, air.state_name(), ok, sandbag.velocity(), int(player.mp)])
		n += 1
		await _wait(0.22)
	await _shot(DUEL + "05_meteor_cine")
	var crashed: bool = await _wait_until(func() -> bool: return sandbag.state == AirFoe.S.DOWN or sandbag.state == AirFoe.S.DEAD, 3.0)
	await _wait(0.06)
	await _shot(DUEL + "06_crash")
	print("[duel] 砸地=%s 木人状态 %s 血 %d 位置 %s 连击 %d" % [crashed, sandbag.state_name(), int(sandbag.hp), sandbag.global_position, air.combo])
	await _wait(1.2)

	# 4. 蓄力重击·崩拳（从 12 米外冲过去）
	sandbag.demo_reset(Vector3(-9.0, 7.0, -13.0))
	_duel_place(sandbag, 12.0, 9.0)
	air.target = sandbag
	await _wait(0.4)
	air.demo_heavy("fwd", 0.75)
	await _wait(0.55)
	await _shot(DUEL + "07_charge")
	await _wait_until(func() -> bool: return _air_state() == AM.A.SMASH, 1.0)
	await _wait(0.06)
	await _shot(DUEL + "08_smash_dash")
	await _wait_until(func() -> bool: return _air_state() == AM.A.SMASH and air._hit_done, 1.5)
	await _shot(DUEL + "09_smash_hit")
	await _wait(0.03)
	await _shot(DUEL + "09_smash_hit_b")
	print("[duel] 崩拳：木人击飞=%s 速度 %.1f 血 %d" % [sandbag.is_launched(), sandbag.velocity().length(), int(sandbag.hp)])
	await _wait(1.6)

	# 5. 追身突进（25 米外按攻击）
	sandbag.demo_reset(Vector3(-9.0, 7.0, -13.0))
	_duel_place(sandbag, 25.0, 12.0)
	air.target = sandbag
	await _wait(0.4)
	air.press_attack()
	await _wait(0.16)
	await _shot(DUEL + "10_rush")
	var arrived: bool = await _wait_until(func() -> bool: return _air_state() == AM.A.ATTACK, 1.5)
	print("[duel] 追身突进：到位出手=%s 间距 %.2f" % [arrived, player.center().distance_to(sandbag.center())])
	await _wait(1.0)

	# 6. 对手出手：瞬身 / 护体 / 挨打
	foe.demo_reset(player.global_position + Vector3(0.0, 0.0, -2.6))
	air.target = foe
	cam.snap(PI * 0.5, -0.06, 6.0)
	await _wait(0.5)
	foe.force_attack(false)
	await _wait_until(func() -> bool: return foe.state == AirFoe.S.STRIKE, 2.0)
	air.press_guard()
	await _wait(0.12)
	await _shot(DUEL + "11_vanish")
	air.release_guard()
	print("[duel] 瞬身：对手状态 %s 主角位置在对手背后=%s 气血 %d" % [foe.state_name(),
			player.global_position.z < foe.global_position.z, int(player.melee.hp)])
	await _wait(1.5)
	foe.demo_reset(player.global_position + Vector3(0.0, 0.0, -2.6))
	player.face_now(0.0)
	await _wait(0.4)
	air.press_guard()
	await _wait(0.4)
	foe.force_attack(false)
	await _wait_until(func() -> bool: return foe.state == AirFoe.S.STRIKE and foe._hit_done, 2.0)
	await _shot(DUEL + "12_guard")
	air.release_guard()
	print("[duel] 护体：气血 %d 灵力 %d" % [int(player.melee.hp), int(player.mp)])
	await _wait(1.2)
	foe.demo_reset(player.global_position + Vector3(0.0, 0.0, -2.6))
	await _wait(0.4)
	foe.force_attack(true)
	await _wait_until(func() -> bool: return foe.state == AirFoe.S.STRIKE and foe._hit_done, 2.5)
	await _wait(0.1)
	await _shot(DUEL + "13_blown")
	print("[duel] 挨重击：%s 气血 %d" % [air.state_name(), int(player.melee.hp)])
	await _wait(1.6)

	# 7. 飞剑点射 + 三式剑诀
	foe.demo_reset(player.global_position + Vector3(0.0, 0.0, -14.0))
	air.target = foe
	player.face_now(0.0)
	cam.snap(0.5, -0.1, 7.0)
	player.mp = player.mp_max()
	await _wait(0.5)
	var fhp := foe.hp
	for i in 3:
		air.press_shot()
		await _wait(0.18)
	await _shot(DUEL + "14_sword_shot")
	await _wait(0.5)
	print("[duel] 飞剑点射 ×3：对手血 %d -> %d 灵力 %d" % [int(fhp), int(foe.hp), int(player.mp)])
	for i in 3:
		fhp = foe.hp
		air.press_skill(i)
		await _wait(0.22)
		await _shot(DUEL + "15_skill_%d" % (i + 1))
		await _wait(1.3)
		print("[duel] 剑诀 %d「%s」：对手血 %d -> %d 灵力 %d 冷却 %.1f" % [i + 1, air.skill_name(i), int(fhp), int(foe.hp), int(player.mp), air.cds[i]])

	# 7a. 飞剑连发（长按 E）打木人：看阵位齐射的队形
	sandbag.demo_reset(Vector3(-9.0, 7.0, -13.0))
	_duel_place(sandbag, 16.0, 11.0)
	air.target = sandbag
	player.mp = player.mp_max()
	await _wait(0.4)
	var shp := sandbag.hp
	Input.action_press("air_shot")
	await _wait(0.9)
	await _shot(DUEL + "17_volley_form")
	cam.snap(cam.yaw + 0.9, -0.1, 10.0)
	await _wait(0.6)
	await _shot(DUEL + "18_volley_side")
	Input.action_release("air_shot")
	print("[duel] 飞剑连发「%s」：木人血 %d -> %d 灵力 %d" % [player.caster.stage_name(), int(shp), int(sandbag.hp), int(player.mp)])
	await _wait(1.2)

	# 7a2. 与真人陪练飞剑对波：它先连发，主角按住 E 回敬，两股剑流对撞、相持（自动连点），把它轰穿
	rival.demo_reset(player.global_position + Vector3(0.0, 0.0, -24.0))
	rival.ai_enabled = true
	rival._volley_cd = 0.0
	rival._cd = 99.0
	air.target = rival
	player.face_now(0.0)
	player.mp = player.mp_max()
	player.melee.hp = 100.0
	air.demo_mash = 7.0
	cam.snap(PI * 0.5, -0.06, 14.0)
	await _wait(0.3)
	# 对手先起手：主角这边时停 + 预警；等一会儿（真实时间）再点「剑」接波
	rival._start_volley(0.3)
	var t_w := Time.get_ticks_msec()
	while Time.get_ticks_msec() - t_w < 350:
		await get_tree().process_frame
	await _shot(DUEL + "19_clash_warn")
	print("[duel] 对波预警：窗口剩余 %.0f%% 时间倍率 %.2f 可接波=%s" % [air.warn_k() * 100.0, Engine.time_scale, air.can_accept_clash()])
	air.press_shot()
	var clashed: bool = await _wait_until(func() -> bool: return air.in_clash(), 3.0)
	var mp0 := player.mp
	# 第三者（木人）凑到交汇点旁边：应该被震开；它打主角 / 主角的对手，都应该打不进去
	sandbag.demo_reset(air.clash_point() + Vector3(4.0, 0.5, 0.0))
	var sb0: Vector3 = sandbag.global_position
	var r1: int = air.receive_attack(sandbag, {"dmg": 30.0, "dir": Vector3.RIGHT, "contact": player.center()})
	var r2: int = rival.air_hit(sandbag, {"dmg": 300.0, "dir": Vector3.RIGHT, "contact": rival.center()})
	await _wait(0.9)
	print("[duel] 对波中：旁人打主角返回 %d（-1 = 打不进）打对手返回 %d；旁人被震开 %.1fm；灵力 %d -> %d" % [r1, r2,
			sandbag.global_position.distance_to(sb0), int(mp0), int(player.mp)])
	await _shot(DUEL + "19_clash")
	await _wait(0.8)
	await _shot(DUEL + "19_clash_b")
	var rhp := rival.hp
	var u_mid := air.clash_u()
	await _wait_until(func() -> bool: return not air.in_clash(), 8.0)
	await _wait(0.05)
	await _shot(DUEL + "20_clash_end")
	var t_e := Time.get_ticks_msec()
	await _wait_until(func() -> bool: return cam.cine_k <= 0.001, 3.0)
	print("[duel] 对波结束后镜头交还用时 %d ms" % (Time.get_ticks_msec() - t_e))
	# 没接的情况：对手再发一轮，主角不按，应该挨打；挨打僵直中再点「剑」也能接上
	await _wait(2.0)
	rival.demo_reset(player.global_position + Vector3(0.0, 0.0, -22.0))
	rival.ai_enabled = true
	rival._cd = 99.0
	player.melee.hp = 100.0
	rival._start_volley(0.3)
	var t_m := Time.get_ticks_msec()
	while Time.get_ticks_msec() - t_m < 2300:
		await get_tree().process_frame
	print("[duel] 不接波 2.3 秒：主角气血 %d 状态 %s 仍可接波=%s" % [int(player.melee.hp), air.state_name(), air.can_accept_clash()])
	air.press_shot()
	await _wait(0.2)
	print("[duel] 僵直中点「剑」：进入对波=%s" % air.in_clash())
	await _wait_until(func() -> bool: return not air.in_clash(), 8.0)
	await _wait(0.4)
	print("[duel] 飞剑对波：进入相持=%s 相持中交汇点 %.2f 陪练血 %d -> %d 被击飞=%s 扭曲强度 %.3f" % [clashed, u_mid, int(rhp), int(rival.hp),
			rival.is_launched(), air.WARP_BASE + air.WARP_STEP * float(player.realm_idx)])
	air.demo_mash = 0.0
	await _wait(2.5)

	# 7a3. 真人陪练进攻：连段 → 重击击飞 → 瞬身追击下砸 → 主角砸地成坑
	rival.demo_reset(player.global_position + Vector3(0.0, 0.0, -5.0))
	rival._volley_cd = 99.0
	rival._cd = 0.0
	player.melee.hp = 100.0
	cam.snap(PI * 0.5, -0.1, 9.0)
	var seen2 := {}
	var downed := false
	var t2 := 0.0
	while t2 < 9.0 and not downed:
		seen2[air.state_name()] = true
		if _air_state() == AM.A.DOWN:
			downed = true
		await _wait(0.03)
		t2 += 0.03
	await _wait(0.12)
	await _shot(DUEL + "21_player_ground_break")
	print("[duel] 陪练进攻：主角经历 %s 砸地=%s 气血 %d" % [seen2.keys(), downed, int(player.melee.hp)])
	rival.ai_enabled = false
	await _wait(1.5)

	# 7a4. 聚气 → 觉醒
	air.awaken = 96.0
	air.demo_gather = true
	await _wait(0.35)
	await _shot(DUEL + "22_gather")
	await _wait_until(func() -> bool: return air.awake_t > 0.0, 2.0)
	air.demo_gather = false
	await _wait(0.12)
	await _shot(DUEL + "23_awaken")
	print("[duel] 觉醒：剩余 %.1fs 伤害基数 %.0f" % [air.awake_t, air._base()])
	await _wait(1.0)

	# 7b. 对手自由进攻 10 秒：主角悬停不动，看它追上来连打 / 远处放剑气（中途按住护体 3 秒）
	foe.demo_reset(player.global_position + Vector3(0.0, 0.0, -20.0))
	foe.ai_enabled = true
	player.melee.hp = 100.0
	var seen := {}
	var tt := 0.0
	while tt < 10.0:
		seen[foe.state_name()] = true
		if tt > 5.0 and tt < 8.0 and not air.guard_held:
			air.press_guard()
		elif tt >= 8.0 and air.guard_held:
			air.release_guard()
		if absf(tt - 4.0) < 0.03:
			await _shot(DUEL + "16_foe_ai")
		await _wait(0.05)
		tt += 0.05
	foe.ai_enabled = false
	print("[duel] 对手自由进攻 10s：出现过的状态 %s 主角气血 %d 灵力 %d 间距 %.1f" % [seen.keys(), int(player.melee.hp),
			int(player.mp), player.center().distance_to(foe.center())])

	# 8. 落地
	cam.pitch = -1.1
	Input.action_press("move_forward")
	var landed: bool = await _wait_until(func() -> bool: return player.st == Player.St.GROUND, 4.0)
	Input.action_release("move_forward")
	print("[duel] 落地=%s 状态 %s" % [landed, player.state_text()])
	await _wait(0.3)
	get_tree().quit()


# ---------- 搜打撤自检截图（-- --raid-shot） ----------

const RAID := "raid_"
const RaidData := preload("res://scripts/raid_data.gd")


## 把主角放到 (x, z) 的地面上，等周围地块建好
func _raid_goto(p2: Vector2, yaw: float, up := 0.0) -> void:
	player.force_ground()
	player.velocity = Vector3.ZERO
	player.global_position = Vector3(p2.x, level.ground(p2.x, p2.y) + 0.2 + up, p2.y)
	cam.snap(yaw, -0.18, 9.0)
	await level.prewarm(8.0)


func _raid_fps(tag: String) -> void:
	level.worst_frame_ms = 0.0
	var n0 := Engine.get_frames_drawn()
	var t0 := Time.get_ticks_msec()
	await _wait(2.0)
	var fps := float(Engine.get_frames_drawn() - n0) * 1000.0 / float(Time.get_ticks_msec() - t0)
	var rd = level.raid
	print("[raid] %s：区域 %s 帧率 %.0f 最长帧 %.0fms 小怪 %d 修士 %d 掉落 %d 绘制调用 %d 图元 %dk 地块 %d" % [tag,
			RaidData.REGIONS[int(rd.region)]["name"], fps, level.worst_frame_ms, rd._mobs.size(), rd._rivals.size(), rd._pickups.size(),
			int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
			int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME) / 1000.0), level.world.chunk_count()])


func _raid_census(tag: String) -> void:
	var rd = level.raid
	var lines: Array = []
	for f: Variant in rd._rivals:
		if is_instance_valid(f):
			lines.append("%s(%s%s %dm)" % [f.display_name, "红名" if f.hostile else "白名", " 打怪中" if f._prey != null else "",
					int(f.global_position.distance_to(player.global_position))])
	var elites := 0
	for m: Variant in rd._mobs:
		if is_instance_valid(m) and m.elite:
			elites += 1
	print("[raid] %s：局内 %ds 难度系数 %.2f 怪等级 %d 导演点数 %d 小怪 %d（精英 %d）修士 %d：%s" % [tag, int(rd.run_t), rd.coeff(),
			rd.enemy_level(int(rd.region)), int(rd._credits), rd._mobs.size(), elites, rd._rivals.size(), " ".join(lines)])


## 自检要一路跑完：主角气血见底就补满（挨打的数值照常打印）
# ---------- 触屏自检 ----------

func _tt_touch(idx: int, vp_pos: Vector2, pressed: bool) -> void:
	var ev := InputEventScreenTouch.new()
	ev.index = idx
	ev.position = get_viewport().get_final_transform() * vp_pos
	ev.pressed = pressed
	Input.parse_input_event(ev)


func _tt_drag(idx: int, vp_pos: Vector2, bogus_rel := Vector2.ZERO) -> void:
	var ev := InputEventScreenDrag.new()
	ev.index = idx
	ev.position = get_viewport().get_final_transform() * vp_pos
	ev.relative = bogus_rel      # 故意给一个串了的 relative（网页版多指时引擎就会给错），看镜头会不会被带跑
	Input.parse_input_event(ev)


## `-- --duel-shot --touch-test --touch`：多点触控的逻辑自检（合成触摸事件，不需要真手机）。逐项打印 通过 / 不通过：
## 摇杆 + 镜头同时动、第一根手指不再等于按住「攻击」、暂停期间抬手不卡摇杆、丢了抬起事件后再按一次能接管、同序号重复按下、按钮照常。
func _run_touch_test() -> void:
	foe.ai_enabled = false
	rival.ai_enabled = false
	await _wait(1.0)
	var vs := get_viewport().get_visible_rect().size
	var stick0 := Vector2(vs.x * 0.16, vs.y * 0.72)
	var look0 := Vector2(vs.x * 0.7, vs.y * 0.4)
	var ok_n := 0
	var all_n := 0
	var check := func(name: String, ok: bool, detail: String) -> void:
		print("[touch] %s %s｜%s" % ["通过" if ok else "不通过", name, detail])
	var two := func() -> void:
		await get_tree().process_frame
		await get_tree().process_frame
	# 1 摇杆按下推到右边
	_tt_touch(0, stick0, true)
	await two.call()
	_tt_drag(0, stick0 + Vector2(90.0, 0.0))
	await two.call()
	var r1 := Input.get_action_strength("move_right")
	check.call("摇杆推右", r1 > 0.6, "向右力度 %.2f" % r1)
	# 2 第一根手指（会被系统当成鼠标左键）不等于按住攻击
	check.call("推着摇杆不算按住攻击", not Input.is_action_pressed("attack"), "攻击按住=%s" % Input.is_action_pressed("attack"))
	# 3 另一根手指转镜头，两根交替动；引擎给的 relative 故意是错的
	var yaw0 := cam.yaw
	_tt_touch(1, look0, true)
	await two.call()
	var moved := 0.0
	for i in 10:
		_tt_drag(1, look0 + Vector2(12.0 * float(i + 1), 0.0), Vector2(-500.0, 300.0))
		_tt_drag(0, stick0 + Vector2(90.0, 6.0 * float(i % 3)), Vector2(400.0, 0.0))
		await get_tree().process_frame
		moved += 12.0
	await two.call()
	var want := -moved * 0.0052
	var got := angle_difference(yaw0, cam.yaw)
	var r3 := Input.get_action_strength("move_right")
	check.call("推摇杆的同时转镜头", absf(got - want) < 0.03 and r3 > 0.6, "镜头转了 %.3f（应为 %.3f）向右力度 %.2f" % [got, want, r3])
	# 4 镜头那根抬起，摇杆不受影响；摇杆抬起后归零
	_tt_touch(1, look0, false)
	await two.call()
	var r4 := Input.get_action_strength("move_right")
	_tt_touch(0, stick0, false)
	await two.call()
	check.call("各抬各的", r4 > 0.6 and Input.get_action_strength("move_right") < 0.01 and not touch._stick_on, "抬镜头后向右 %.2f，抬摇杆后向右 %.2f" % [r4,
			Input.get_action_strength("move_right")])
	# 5 推着摇杆时游戏暂停（走进择境门弹出菜单），暂停期间抬手
	_tt_touch(0, stick0, true)
	await two.call()
	_tt_drag(0, stick0 + Vector2(0.0, -90.0))
	await two.call()
	var f5 := Input.get_action_strength("move_forward")
	get_tree().paused = true
	await two.call()
	_tt_touch(0, stick0, false)
	await two.call()
	get_tree().paused = false
	await two.call()
	check.call("暂停期间抬手不卡摇杆", f5 > 0.6 and Input.get_action_strength("move_forward") < 0.01 and not touch._stick_on, "暂停前向前 %.2f，恢复后向前 %.2f 摇杆占用=%s" % [f5,
			Input.get_action_strength("move_forward"), touch._stick_on])
	# 6 抬起事件丢了：摇杆还占着；再按一根手指（不同序号）接管，抬起后归零
	_tt_touch(3, stick0, true)
	await two.call()
	_tt_drag(3, stick0 + Vector2(-90.0, 0.0))
	await two.call()
	var l6 := Input.get_action_strength("move_left")
	_tt_touch(7, stick0 + Vector2(20.0, 10.0), true)      # 3 号的抬起没来
	await two.call()
	var l6b := Input.get_action_strength("move_left")
	_tt_drag(7, stick0 + Vector2(110.0, 10.0))
	await two.call()
	var r6 := Input.get_action_strength("move_right")
	_tt_touch(7, stick0, false)
	await two.call()
	check.call("丢了抬起事件后再按能接管", l6 > 0.6 and l6b < 0.01 and r6 > 0.6 and Input.get_action_strength("move_right") < 0.01 and not touch._stick_on,
			"旧触点向左 %.2f → 接管后 %.2f → 新触点向右 %.2f → 抬起后 %.2f" % [l6, l6b, r6, Input.get_action_strength("move_right")])
	# 7 负的触点序号（苹果手机浏览器）照常能用
	_tt_touch(-1884, stick0, true)
	await two.call()
	_tt_drag(-1884, stick0 + Vector2(90.0, 0.0))
	_tt_touch(-77, look0, true)
	await two.call()
	var yaw7 := cam.yaw
	_tt_drag(-77, look0 + Vector2(60.0, 0.0))
	await two.call()
	var r7 := Input.get_action_strength("move_right")
	var d7 := angle_difference(yaw7, cam.yaw)
	_tt_touch(-1884, stick0, false)
	_tt_touch(-77, look0, false)
	await two.call()
	check.call("负的触点序号", r7 > 0.6 and absf(d7 + 60.0 * 0.0052) < 0.03 and not touch._busy(), "向右 %.2f 镜头 %.3f 全部松开=%s" % [r7, d7, not touch._busy()])
	# 8 按钮：推着摇杆点「攻」，按住期间算按住，抬起就松
	var atk := Vector2(vs.x - 165.0, vs.y - 165.0)
	_tt_touch(0, stick0, true)
	_tt_touch(2, atk, true)
	await two.call()
	var a8 := Input.is_action_pressed("attack")
	_tt_touch(2, atk, false)
	await two.call()
	var a8b := Input.is_action_pressed("attack")
	_tt_touch(0, stick0, false)
	await two.call()
	check.call("按钮照常", a8 and not a8b, "按住=%s 抬起后=%s" % [a8, a8b])
	print("[touch] 自检结束")
	get_tree().quit()


# ---------- 卡顿探针 ----------
var _hx_on := false
var _hx_tag := ""
var _hx_last := 0
var _hx_worst := 0.0
var _hx_t0 := 0


## 每帧量一次真实帧长（不受慢动作 / 顿帧的时间缩放影响）；超过 50ms 的帧当场打印出来
func _hx_tick() -> void:
	var now := Time.get_ticks_usec()
	if _hx_t0 == 0:
		_hx_t0 = now
	if _hx_last > 0:
		var ms := float(now - _hx_last) / 1000.0
		_hx_worst = maxf(_hx_worst, ms)
		if player.melee.hp < 70.0:
			player.melee.hp = 100.0      # 探针期间不死
		if ms > 50.0:
			print("[hx] 长帧 %dms @%s t=%.1fs" % [int(ms), _hx_tag, float(now - _hx_t0) / 1e6])
	_hx_last = now


func _hx_fire(action: String, pressed: bool) -> void:
	var ev := InputEventAction.new()
	ev.action = action
	ev.pressed = pressed
	ev.strength = 1.0 if pressed else 0.0
	Input.parse_input_event(ev)


func _hx_tap(action: String, n := 1, gap := 0.3, hold := 0.06) -> void:
	for i in n:
		_hx_fire(action, true)
		await _wait(hold)
		_hx_fire(action, false)
		await _wait(gap)


## `-- --raid-shot --raid-hitch [--touch]`（配 `--rendering-method gl_compatibility` 就是网页版 / 手机用的那套渲染）：首次卡顿排查。
## 进图后把一轮常见操作（刷怪、出招、命中、挨打、怪死掉落、开包、腾空、空战连击、重击、飞剑、剑诀、砸坑、突破……）各做两遍，
## 打印每一步里最长的一帧：第一遍是「冷」的、第二遍是「热」的，差得多的那几步就是第一次用到时在编译着色器 / 生成资源。
func _run_raid_hitch(rd: Variant) -> void:
	_hx_tag = "进图后静置"
	await _wait(2.0)
	print("[hx] 进图完成：到这里最长帧 %dms（含载入）；音效库已合成=%s 预热过=%s" % [int(_hx_worst), not Sfx._bank.is_empty(), Warm.done])
	rd._mob_root.process_mode = Node.PROCESS_MODE_INHERIT
	for m: Variant in rd._mobs.duplicate():
		if is_instance_valid(m):
			m.queue_free()
	rd._mobs.clear()
	var defs: Array = RaidData.REGIONS[0]["mobs"]
	var boss_def := int(RaidData.REGIONS[0]["boss"])
	var mob := [null]
	var front := func(dist: float) -> Vector3:
		var q: Vector3 = player.global_position + Basis(Vector3.UP, cam.yaw) * Vector3.FORWARD * dist
		q.y = level.ground(q.x, q.z)
		return q
	var spawn := func(def: int, elite: bool, dist: float) -> void:
		var m: Node3D = rd._spawn_mob(def, 0, front.call(dist), elite, 1, 50.0)
		mob[0] = m
	var steps: Array = [
		["刷出小怪", 0.8, func() -> void:
			player.set_realm(0, false)
			spawn.call(int(defs[0]), false, 2.4)],
		["地面三连击", 0.4, func() -> void: await _hx_tap("attack", 3, 0.34)],
		["格挡", 0.4, func() -> void: await _hx_tap("guard", 1, 0.2, 0.4)],
		["闪现", 0.6, func() -> void: await _hx_tap("sprint", 1, 0.2)],
		["小怪打中主角", 0.6, func() -> void:
			if is_instance_valid(mob[0]):
				mob[0]._hit_player(4.0, false, Vector3.BACK, false)],
		["怪死 + 掉落", 1.0, func() -> void:
			if is_instance_valid(mob[0]):
				mob[0]._take_raw(1.0e9, Vector3.FORWARD, true)],
		["捡掉落", 0.8, func() -> void:
			for pk: Variant in rd._pickups:
				if is_instance_valid(pk):
					player.global_position = pk.global_position + Vector3(0.0, 0.2, 0.0)
					break],
		["开关背包", 0.5, func() -> void:
			rd.hud.toggle_bag()
			await _wait(0.4)
			rd.hud.toggle_bag()],
		["飘字提示", 0.6, func() -> void: rd.hud.toast("卡顿探针 · 提示条", Color(0.9, 0.8, 0.5))],
		["刷出精英", 0.8, func() -> void: spawn.call(int(defs[1]), true, 5.0)],
		["刷出首领", 1.0, func() -> void: spawn.call(boss_def, false, 14.0)],
		["结丹：按攻腾空 + 空战连击", 0.6, func() -> void:
			player.set_realm(2, false)
			await _hx_tap("attack", 6, 0.3)],
		["空战蓄力重击", 1.0, func() -> void: await _hx_tap("attack", 1, 0.3, 0.9)],
		["飞剑点射", 0.6, func() -> void: await _hx_tap("air_shot", 2, 0.3)],
		["剑诀一", 1.4, func() -> void: await _hx_tap("skill_next", 1, 0.2)],
		["剑诀二", 1.4, func() -> void: await _hx_tap("skill_next", 1, 0.2)],
		["剑诀三", 1.6, func() -> void: await _hx_tap("skill_next", 1, 0.2)],
		["护体", 0.5, func() -> void: await _hx_tap("guard", 1, 0.2, 0.5)],
		["空中闪现", 0.6, func() -> void: await _hx_tap("sprint", 1, 0.2)],
		["砸地成坑", 1.2, func() -> void: Vfx.crater(front.call(8.0), 1.2)],
		["打死首领 + 遗藏", 1.2, func() -> void:
			for m: Variant in rd._mobs.duplicate():
				if is_instance_valid(m) and m.is_alive():
					m._take_raw(1.0e9, Vector3.FORWARD, true)],
		["落地", 0.8, func() -> void:
			player.force_ground()
			player.global_position.y = level.ground(player.global_position.x, player.global_position.z) + 0.1],
		["突破特效（筑基）", 2.2, func() -> void: player.set_realm(1)],
		["突破特效（化神）", 2.6, func() -> void: player.set_realm(4)],
	]
	var cold: Array = []
	var warm: Array = []
	for round_i in 2:
		for st: Array in steps:
			_hx_tag = "%s·第%d遍" % [st[0], round_i + 1]
			await _wait(0.25)
			_hx_worst = 0.0
			await (st[2] as Callable).call()
			await _wait(float(st[1]))
			(cold if round_i == 0 else warm).append(_hx_worst)
		await _wait(1.0)
	var lines: Array = []
	var cold_sum := 0.0
	for i in steps.size():
		var c: float = cold[i]
		var w: float = warm[i]
		cold_sum += maxf(c - maxf(w, 20.0), 0.0)
		lines.append("%s %d / %d%s" % [steps[i][0], int(c), int(w), "  ←" if c > maxf(w * 2.0, 45.0) else ""])
	print("[hx] 各步最长帧 ms（第一遍 / 第二遍）：\n  " + "\n  ".join(lines))
	print("[hx] 首次使用多花的时间合计 %dms；渲染器 %s" % [int(cold_sum), RenderingServer.get_current_rendering_method()])


# ---------- 持续战斗 / 高速飞行的帧耗时探针 ----------
var _fp_on := false
var _fp_last := 0
var _fp_ms := PackedFloat32Array()
var _fp_prev: Array = []
var _fp_log: Array = []
var _fp_thr := 25.0
var _fp_mon: Array = [0.0, 0.0, 0.0, 0.0, 0]
var _fp_added: Array = []      # 这一帧里新进场景树的节点（类名 / 脚本名 @ 父节点）


func _fp_node_added(n: Node) -> void:
	if _fp_on and _fp_added.size() < 40:
		var sc: Variant = n.get_script()
		var par := n.get_parent()
		_fp_added.append("%s@%s" % [(sc as Script).resource_path.get_file().get_basename() if sc != null else n.get_class(), str(par.name) if par != null else "?"])


## 每帧记一次真实帧长；长帧当场记下「这一帧里变了什么」（落地的地块、怪、特效节点、掉落、坑、节点总数、是不是在算地块）
func _fp_tick() -> void:
	var now := Time.get_ticks_usec()
	if player.melee.hp < 70.0:
		player.melee.hp = 100.0
	var w = level.world
	var rd = level.raid
	var cur: Array = [int(w.built), rd._mobs.size(), Vfx.root.get_child_count(), rd._pickups.size(), int(level.blast_n),
			int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)), int(w.far_built), int(Sfx.plays), float(rd._tick)]
	if _fp_last > 0:
		var ms := float(now - _fp_last) / 1000.0
		_fp_ms.append(ms)
		_fp_mon[0] += Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0
		_fp_mon[1] += Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)
		_fp_mon[2] += Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME) / 1000.0
		_fp_mon[3] += float(cur[5])
		_fp_mon[4] += 1
		if ms > _fp_thr and _fp_log.size() < 14 and not _fp_prev.is_empty():
			_fp_log.append("%dms（地块+%d 色块+%d 怪%+d 特效%+d 掉落%+d 坑+%d 节点%+d%s）" % [int(ms), cur[0] - _fp_prev[0], cur[6] - _fp_prev[6],
					cur[1] - _fp_prev[1], cur[2] - _fp_prev[2], cur[3] - _fp_prev[3], cur[4] - _fp_prev[4], cur[5] - _fp_prev[5],
					" 算地块中" if w.busy() else ""])
			_fp_log[-1] = str(_fp_log[-1]) + "[音效+%d%s 流速%.2f]" % [cur[7] - _fp_prev[7], " 导演" if float(cur[8]) > float(_fp_prev[8]) else "", Engine.time_scale]
			if OS.get_cmdline_user_args().has("--fp-nodes") and not _fp_added.is_empty():
				_fp_log[-1] = str(_fp_log[-1]) + " 新节点：" + ",".join(_fp_added)
	_fp_added.clear()
	_fp_prev = cur
	_fp_last = now


func _fp_begin() -> void:
	_fp_ms = PackedFloat32Array()
	_fp_log.clear()
	_fp_prev.clear()
	_fp_mon = [0.0, 0.0, 0.0, 0.0, 0]
	_fp_last = 0
	_fp_on = true
	if not get_tree().node_added.is_connected(_fp_node_added):
		get_tree().node_added.connect(_fp_node_added)


func _fp_end(tag: String) -> void:
	_fp_on = false
	var a := Array(_fp_ms)
	if a.is_empty():
		return
	a.sort()
	var n := a.size()
	var sum := 0.0
	var over := [0, 0, 0]
	for v: float in a:
		sum += v
		over[0] += 1 if v > 20.0 else 0
		over[1] += 1 if v > 33.4 else 0
		over[2] += 1 if v > 50.0 else 0
	var k := maxf(float(_fp_mon[4]), 1.0)
	print("[fight] %s：%d 帧 平均 %.1fms（%.0f 帧/秒）中位 %.1f  95%% %.1f  99%% %.1f  最长 %.0f ｜ >20ms %d 帧  >33ms %d 帧  >50ms %d 帧 ｜ 脚本 %.2fms/帧 绘制调用 %d 图元 %dk 节点 %d" % [
			tag, n, sum / float(n), 1000.0 * float(n) / sum, a[n / 2], a[int(float(n) * 0.95)], a[int(float(n) * 0.99)], a[n - 1],
			over[0], over[1], over[2], float(_fp_mon[0]) / k, int(float(_fp_mon[1]) / k), int(float(_fp_mon[2]) / k), int(float(_fp_mon[3]) / k)])
	if not _fp_log.is_empty():
		print("[fight]   长帧：" + "；".join(_fp_log))


## `-- --raid-shot --raid-fight [--touch] [--sliced]`（配 `--rendering-method gl_compatibility` = 手机网页那套渲染）：
## 持续打一阵，看帧耗时的分布（不是只看平均帧率）：站着不动 → 炼气地面打一群小怪 → 结丹空战 + 飞剑 + 剑诀 → 化神空战 + 炸坑。
## 每一段打印 帧数 / 平均 / 中位 / 95% / 99% / 最长、超过 20 / 33 / 50 毫秒的帧数、脚本耗时、绘制调用，以及长帧当时场上变了什么。
func _run_raid_fight(rd: Variant) -> void:
	rd._credits = 0.0
	for m: Variant in rd._mobs.duplicate():
		if is_instance_valid(m):
			m.queue_free()
	rd._mobs.clear()
	await _raid_goto(Vector2(-46.0, 38.0), 0.0)
	await _wait(2.0)
	var defs: Array = RaidData.REGIONS[0]["mobs"]
	var ring := func(n: int, elite_n: int) -> void:
		for i in n:
			var a := TAU * float(i) / float(n)
			var q: Vector3 = player.global_position + Vector3(cos(a), 0.0, sin(a)) * (4.0 + 2.0 * float(i % 3))
			q.y = level.ground(q.x, q.z)
			var m: Node3D = rd._spawn_mob(int(defs[i % defs.size()]), 0, q, i < elite_n, 1, 30.0)
			rd._mobs.append(m)
			m.alert()
	var ground_only := false
	for a: String in OS.get_cmdline_user_args():
		if a.begins_with("--fp-mute="):
			Vfx.mute = int(a.get_slice("=", 1))
		if a == "--fp-ground":
			ground_only = true
		if a == "--fp-nosfx":
			Sfx.root = null        # 排查：不放音效
		if a == "--fp-nohud":
			rd.hud.visible = false
			rd.hud.process_mode = Node.PROCESS_MODE_DISABLED
		if a == "--fp-still":
			# 排查：怪照常围上来打，主角不出手
			ring.call(5, 0)
			await _wait(0.6)
			_fp_begin()
			await _wait(12.0)
			_fp_end("主角不出手 · 5 只小怪围攻")
	_fp_begin()
	await _wait(4.0)
	_fp_end("站着不动")
	# 炼气：地面连击
	player.set_realm(0, false)
	ring.call(5, 0)
	await _wait(0.6)
	_fp_begin()
	for i in 10:
		await _hx_tap("attack", 3, 0.3)
		if i % 3 == 2:
			await _hx_tap("sprint", 1, 0.25)
	_fp_end("炼气 · 地面打 5 只小怪（特效屏蔽档 %d）" % Vfx.mute)
	if ground_only:
		return
	# 结丹：空战
	player.set_realm(2, false)
	ring.call(4, 1)
	await _wait(0.4)
	_fp_begin()
	for i in 7:
		await _hx_tap("attack", 4, 0.28)
		await _hx_tap("air_shot", 2, 0.25)
		if i % 2 == 1:
			await _hx_tap("skill_next", 1, 0.9)
		if i % 3 == 2:
			await _hx_tap("sprint", 1, 0.3)
	_fp_end("结丹 · 空战 + 飞剑 + 剑诀")
	# 化神：空战 + 炸坑
	player.set_realm(4, false)
	ring.call(4, 1)
	await _wait(0.4)
	_fp_begin()
	for i in 7:
		await _hx_tap("attack", 4, 0.28)
		await _hx_tap("skill_next", 1, 0.8)
		var q2: Vector3 = player.global_position + Vector3(cos(float(i) * 1.9), 0.0, sin(float(i) * 1.9)) * 9.0
		q2.y = level.ground(q2.x, q2.z)
		Vfx.crater(q2, 1.0)
		await _hx_tap("air_shot", 2, 0.25)
	_fp_end("化神 · 空战 + 剑诀 + 炸坑")
	for m: Variant in rd._mobs.duplicate():
		if is_instance_valid(m):
			m.queue_free()
	rd._mobs.clear()
	player.force_ground()
	await _wait(1.0)


## `-- --raid-shot --raid-vfxcost [--touch]`：各种命中特效「放一次」要多少 CPU 时间（一帧里连放 20 次取平均），
## 以及放出去之后那一帧 / 之后半秒里最长的一帧。找战斗里的尖峰用
func _run_raid_vfxcost(rd: Variant) -> void:
	rd._credits = 0.0
	rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
	await _raid_goto(Vector2(-46.0, 38.0), 0.0)
	await _wait(1.5)
	var at := player.global_position + Vector3(0.0, 1.2, -3.0)
	var col := Realm.line_color(player.realm)
	var chips: Array = player.hero.chip_colors()
	var cases: Array = [
		["impact 轻击", func() -> void: Vfx.impact(at, Vector3.RIGHT, col, 0)],
		["impact 重击", func() -> void: Vfx.impact(at, Vector3.RIGHT, col, 1)],
		["blade_hit", func() -> void: Vfx.blade_hit(at, Vector3.RIGHT, col, 1.0)],
		["line_sparks ×1", func() -> void: Vfx.line_sparks(at, Vector3.UP, col, 6, 8.0)],
		["pixel hit_spark", func() -> void: Vfx.pixel("hit_spark", at, {"px": 0.024, "tint": col, "recolor": 0.6, "dir": Vector3.RIGHT})],
		["_burst_lines ×4", func() -> void: Vfx._burst_lines(at, 4, col, 0.32, 0.05, 0.42, 0.14)],
		["_sprite + _fade", func() -> void: Vfx._fade(Vfx._sprite(at, col, 1, 0.1), Vector3.ONE, 0.2)],
		["debris ×9", func() -> void: Vfx.debris(at, Vector3.UP, chips, 9, 5.0)],
		["damage_number", func() -> void: Vfx.damage_number(at, float(randi() % 900 + 100), col)],
		["hit（飞剑命中）", func() -> void: Vfx.hit(at, Vector3.RIGHT, col, 1.0)],
		["blade_clash", func() -> void: Vfx.blade_clash(at, Vector3.BACK, 1.0)],
		["art_hit", func() -> void: Vfx.art_hit(at, Vector3.RIGHT, col, 3, false)],
		["art_hit lite", func() -> void: Vfx.art_hit(at, Vector3.RIGHT, col, 3, true)],
		["shockwave", func() -> void: Vfx.shockwave(at, Vector3.RIGHT, col, 1.0)],
	]
	for round_i in 2:
		var lines: Array = []
		for c: Array in cases:
			await _wait(0.9)
			await get_tree().process_frame
			var t0 := Time.get_ticks_usec()
			for i in 20:
				(c[1] as Callable).call()
			var t1 := Time.get_ticks_usec()
			await get_tree().process_frame
			await get_tree().process_frame
			var t2 := Time.get_ticks_usec()
			var worst := 0.0
			var last := t2
			for f in 30:
				await get_tree().process_frame
				var now := Time.get_ticks_usec()
				worst = maxf(worst, float(now - last) / 1000.0)
				last = now
			lines.append("%s：调用 %.0f µs/次，紧接着的两帧共 %.1f ms，之后最长帧 %.1f ms" % [c[0], float(t1 - t0) / 20.0, float(t2 - t1) / 1000.0, worst])
		print("[vfxcost] 第 %d 遍（每种一帧连放 20 次）：
  " % (round_i + 1) + "
  ".join(lines))


## `-- --raid-shot --raid-surge [--touch] [--surge-stats]`：起飞三段冲刺 + 遁光变焦 + 火爆尺寸。
## 筑基 / 结丹 / 元婴 / 炼虚 / 大乘各起飞一次、按住前进飞两秒多：每段音爆后拍一张（raid_sg<境界>_s<段>），巡航时再拍一张；
## 打印每段起步的速度和扭曲强度、这段时间里视野最宽到多少 / 镜头最近到多少、巡航时的视野和距离。
## 加 --surge-stats 不拍照，改成统计这两秒多的帧耗时（配手机档那套参数看有没有掉帧）。
## 最后在主角面前并排放一组火爆：左边是缩小前的尺寸、右边是现在的（raid_sg_fire），人站在中间当比例尺
func _run_raid_surge(rd: Variant) -> void:
	rd._credits = 0.0
	rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
	rd._mob_root.visible = false
	var stats := OS.get_cmdline_user_args().has("--surge-stats")
	for ri: int in [1, 2, 3, 5, 7]:
		player.set_realm(ri, false)
		await _raid_goto(Vector2(0.0, 30.0), 0.0)
		await _wait(0.8)
		var yaw := PI * 0.5 + 0.35 * float(ri)
		cam.snap(yaw, -0.2, 6.5)
		player.surge_log.clear()
		player.toggle_flight()
		Input.action_press("move_forward")
		var seen := 0
		var t := 0.0
		var fov_max := 0.0
		var dist_min := 99.0
		var warp_max := 0.0
		var started := false
		while t < 2.5:
			await get_tree().process_frame
			if player.st != Player.St.FLY:
				continue
			if not started:
				started = true
				if stats:
					_fp_begin()
			t += get_process_delta_time()
			fov_max = maxf(fov_max, cam.cam.fov)
			dist_min = minf(dist_min, cam.cam.global_position.distance_to(player.center()))
			warp_max = maxf(warp_max, Vfx.warp_k)
			if player.surge_log.size() > seen:
				seen = player.surge_log.size()
				if not stats:
					await _wait(0.09)
					await _shot(RAID + "sg%d_s%d" % [ri, seen])
		var name: String = Realm.LIST[ri]["name"]
		if stats:
			_fp_end("%s 起飞三段冲刺（前 2.5 秒）" % name)
		else:
			await _shot(RAID + "sg%d_cruise" % ri)
		var parts: Array = []
		for e: Array in player.surge_log:
			parts.append("第 %d 段 %.0f m/s 扭曲 %.3f" % [int(e[0]) + 1, float(e[1]), float(e[2])])
		print("[surge] %s（遁速 %.0f，效果系数 %.2f）：%s ｜视野最宽 %.0f° 镜头最近 %.1f 米 扭曲峰值 %.3f ｜巡航 %.0f m/s 视野 %.0f° 镜头距离 %.1f 米 变焦=%s" % [name,
				float(Realm.LIST[ri]["speed"]), float(Realm.LIST[ri]["fx"]), "，".join(parts), fov_max, dist_min, warp_max,
				player.velocity.length(), cam.cam.fov, cam.cam.global_position.distance_to(player.center()), cam.vertigo_on])
		Input.action_release("move_forward")
		player.velocity = Vector3.ZERO
		player.force_ground()
		await _wait(0.4)
	if stats:
		return
	# 火爆尺寸对比：左旧右新
	player.set_realm(4, false)
	await _raid_goto(Vector2(-46.0, 38.0), 0.0)
	cam.snap(0.0, -0.12, 9.0)
	await _wait(0.6)
	var c := player.global_position + Vector3(0.0, 1.2, -5.0)
	var left := c + Vector3(-4.5, 0.0, 0.0)
	var right := c + Vector3(4.5, 0.0, 0.0)
	var fire := Color(1.0, 0.5, 0.15)
	Vfx.pixel("fire_burst", left - Vector3.UP * 0.03 * 55.0, {"px": 0.03, "lum_cut": 0.5})
	Vfx._fade(Vfx._sprite(left, Color(1.0, 0.75, 0.4), 1, 0.3), Vector3.ONE * 4.2, 0.25)
	Vfx.pixel("plasma", left, {"px": 0.034, "tint": fire, "recolor": 0.9, "to": 24})
	Vfx.fire_explode(right, Vector3.FORWARD, true)
	await _wait(0.2)
	await _shot(RAID + "sg_fire")
	print("[surge] 火爆对比图：左 = 缩小前（大火爆），右 = 现在（×%.2f）" % Vfx.FIRE_K)


## `-- --raid-shot --raid-fly [--touch] [--sliced]`：高速飞行时前方的地块跟不跟得上。
## 各境界按疾遁的速度直线飞一段，每帧数「镜头前方该有地的地块里，有几块还什么都没画」（真地形和色块都没有才算缺），顺带看帧耗时。
func _run_raid_fly(rd: Variant) -> void:
	rd._credits = 0.0
	rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
	rd._mob_root.visible = false
	var w = level.world
	var runs: Array = [[2, 67.0, Vector2(1.0, 0.25)], [4, 135.0, Vector2(-0.3, -1.0)], [7, 315.0, Vector2(-1.0, 0.45)]]
	for r: Array in runs:
		player.set_realm(int(r[0]), false)
		await _raid_goto(Vector2.ZERO, 0.0)
		await _wait(1.0)
		var dir2: Vector2 = (r[2] as Vector2).normalized()
		var dir := Vector3(dir2.x, 0.0, dir2.y)
		var spd: float = r[1]
		var yaw := atan2(-dir.x, -dir.z)
		player.toggle_flight()
		await _wait(1.2)
		var miss := 0
		var miss_real := 0
		var total := 0
		var worst_miss := 0
		var t := 0.0
		var gone := 0.0
		var dist := minf(spd * 9.0, RaidData.PLAY_R - 60.0)
		var shot_done := false
		_fp_begin()
		while gone < dist:
			await get_tree().process_frame
			t += get_process_delta_time()
			# 只给速度，位移让主角自己的飞行逻辑去走（之前这里又手动挪了一遍，实际速度成了两倍）
			var p := player.global_position
			gone = Vector2(p.x, p.z).length()
			if gone > RaidData.PLAY_R - 40.0:
				break
			p.y = maxf(level.ground(p.x, p.z), 0.0) + 70.0
			player.global_position = p
			player.velocity = dir * spd
			cam.snap(yaw, -0.3, 12.0)
			# 前方 view_r 圈内（60° 扇面）的地块
			var k: Vector2i = w.key_of(p)
			var fm := 0
			for dx in range(-w.view_r, w.view_r + 1):
				for dz in range(-w.view_r, w.view_r + 1):
					var d := Vector2(float(dx), float(dz))
					if d.length() > float(w.view_r) or d.length() < 0.5 or d.normalized().dot(dir2) < 0.5:
						continue
					var key := k + Vector2i(dx, dz)
					if not w.has_land(key):
						continue
					total += 1
					if not w._chunks.has(key):
						miss_real += 1
						if not w.far_has(key):
							miss += 1
							fm += 1
			worst_miss = maxi(worst_miss, fm)
			if not shot_done and gone > dist * 0.6:
				shot_done = true
				_fp_on = false
				await _shot(RAID + "fly_%d" % int(spd))
				await _wait(0.3)
				_fp_last = 0
				_fp_on = true
		_fp_end("%s 疾遁 %d m/s（实测 %d m/s）直飞 %d 米" % [Realm.LIST[int(r[0])]["name"], int(spd), int(gone / maxf(t, 0.01)), int(gone)])
		print("[fly]   前方扇面的地块（采样 %d 块次）：真地形没到 %.1f%%，连色块都没有 %.1f%%（单帧最多缺 %d 块）；地块 %d 色块 %d" % [total,
				100.0 * float(miss_real) / maxf(float(total), 1.0), 100.0 * float(miss) / maxf(float(total), 1.0), worst_miss, w.chunk_count(), w.far_count()])
		player.velocity = Vector3.ZERO
		player.force_ground()
		await _wait(0.5)


func _raid_immortal() -> void:
	while level != null and level.raid != null and level.raid.running:
		if player.melee.hp < 30.0:
			player.melee.hp = 100.0
		await get_tree().create_timer(0.2).timeout


## `-- --raid-shot --raid-vista [--touch] [-- 只拍第几个机位…]`：各区域的地貌定妆。每个机位把主角摆到指定位置的半空、按给定朝向和俯角拍一张
## （raid_v<序号>_<名字>），并打印那里的帧率 / 图元 / 地块数。机位表：[名字, 位置, 离地高度, 朝向, 俯角, 镜头距离]
func _run_raid_vista(rd: Variant) -> void:
	rd._mob_root.visible = false
	var views := [
		["hub_spawn", Vector2(6.0, 14.0), 0.0, 0.5, -0.12, 7.0],
		["hub_town", Vector2(40.0, 120.0), 46.0, 0.25, -0.5, 26.0],
		["hub_harbor", Vector2(196.0, 196.0), 26.0, -2.356, -0.36, 24.0],
		["maple_valley", Vector2(60.0, -700.0), 50.0, 0.3, -0.4, 26.0],
		["maple_floor", Vector2(0.0, -640.0), 8.0, -0.6, -0.08, 12.0],
		["maple_sect", Vector2(34.0, -1010.0), 30.0, 0.16, -0.06, 30.0],
		["blood_plain", Vector2(700.0, 60.0), 44.0, -PI * 0.5 + 0.3, -0.36, 26.0],
		["blood_gate", Vector2(966.0, 14.0), 14.0, -PI * 0.5 - 0.1, -0.02, 24.0],
		["cloud_peaks", Vector2(-60.0, 720.0), 90.0, PI + 0.25, -0.34, 26.0],
		["cloud_sect", Vector2(-34.0, 1010.0), 30.0, PI - 0.14, -0.04, 30.0],
		["demon_rift", Vector2(-700.0, 60.0), 50.0, PI * 0.5 + 0.3, -0.4, 26.0],
		["demon_gate", Vector2(-968.0, -12.0), 14.0, PI * 0.5 + 0.08, -0.02, 24.0],
		["x12", Vector2.ZERO, 0.0, 0.0, 0.0, 8.0],
		["x13", Vector2.ZERO, 0.0, 0.0, 0.0, 8.0],
		["road_maple", Vector2(40.0, -470.0), 30.0, 0.2, -0.3, 26.0],
		["road_blood", Vector2(470.0, 40.0), 30.0, -PI * 0.5 + 0.2, -0.3, 26.0],
		["road_cloud", Vector2(-40.0, 470.0), 30.0, PI + 0.2, -0.3, 26.0],
		["road_demon", Vector2(-470.0, -40.0), 30.0, PI * 0.5 + 0.2, -0.3, 26.0],
	]
	# 再自动找两个机位：草原上的一处村落、峡谷的谷底（贴着谷壁看洞窟拱门）
	var w = level.world
	for cx in range(-2, 2):
		for cz in range(-2, 2):
			var e: Array = w._feat_at(cx, cz, 230.0, 91)
			var c: Vector2 = e[0]
			if str(views[12][0]) == "x12" and float(e[1]) >= 0.4 and c.length() < 330.0 and c.length() > 80.0 and w.height(c.x, c.y) > 20.0:
				views[12] = ["meadow_village", c + Vector2(26.0, 26.0), 16.0, 0.8, -0.3, 20.0]
	for xi in range(-200, 200, 6):
		if str(views[13][0]) == "x13" and w._shaped(float(xi), -760.0) < 0.0 and w._shaped(float(xi) + 26.0, -760.0) > 20.0:
			views[13] = ["canyon_floor", Vector2(float(xi) - 6.0, -760.0), 12.0, -PI * 0.5 + 0.35, 0.12, 18.0]
	var only: Array = []
	for a: String in OS.get_cmdline_user_args():
		if a.is_valid_int():
			only.append(int(a))
	for i in views.size():
		if not only.is_empty() and not only.has(i):
			continue
		var v: Array = views[i]
		var at: Vector2 = v[1]
		player.set_realm(1, false)     # 筑基：飞行时不破开地形
		await _raid_goto(at, float(v[3]))
		var fly_y := level.ground(at.x, at.y) + float(v[2]) if float(v[2]) >= 0.0 else -float(v[2])
		if absf(float(v[2])) > 0.5:
			player.toggle_flight()
			await _wait(0.4)
			player.global_position.y = fly_y
			player.velocity = Vector3.ZERO
		cam.snap(float(v[3]), float(v[4]), float(v[5]))
		await _wait(3.5)
		if absf(float(v[2])) > 0.5:
			player.global_position.y = fly_y
		await _wait(0.5)
		await _shot(RAID + "v%02d_%s" % [i, v[0]])
		await _wait(0.3)
		await _raid_fps("地貌 %s（地面高 %.0f）" % [v[0], level.ground(at.x, at.y)])
		var tb := Time.get_ticks_usec()
		var res: Dictionary = await w._build(w.key_of(player.global_position), 0)
		var tm := float(Time.get_ticks_usec() - tb) / 1000.0
		tb = Time.get_ticks_usec()
		await w._build(w.key_of(player.global_position), 1)
		print("[vista] %s：脚下这块地 近景网格 %.0f ms（%d 三角形），远景网格 %.0f ms" % [v[0], tm, (res["i"] as PackedInt32Array).size() / 3,
				float(Time.get_ticks_usec() - tb) / 1000.0])
		player.force_ground()


## `-- --raid-shot --raid-quake [--touch]`：小地图 + 斗法地形破坏。
##   · 小地图：出生点拍一张（raid_95_map），点一下切到远景再拍（raid_95_map_far）
##   · 筑基时砸地：不该留坑；化神时砸地 / 连炸一串：留坑，量这段时间的帧率、最长帧、每批改表耗时、重建了多少地块
##   · 高强度：2 秒里在主角周围炸 40 下（远超正常斗法），看限流后帧率掉多少（raid_96_craters / raid_97_storm）
func _run_raid_quake(rd: Variant) -> void:
	var w = level.world
	rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
	await _raid_goto(Vector2(-46.0, 38.0), 0.0)
	await _wait(1.5)
	await _shot(RAID + "95_map")
	rd.hud.minimap._range_i = 1
	await _wait(1.2)
	await _shot(RAID + "95_map_far")
	rd.hud.minimap._range_i = 0
	var p := player.global_position
	var fwd := Vector3(0.0, 0.0, -1.0)
	# 筑基：不留坑
	player.set_realm(1, false)
	var at0 := p + fwd * 10.0
	at0.y = level.ground(at0.x, at0.z)
	var h0: float = w.height(at0.x, at0.z)
	Vfx.crater(at0, 1.2)
	await _wait(1.2)
	print("[quake] 筑基砸地：地面 %.1f -> %.1f（应不变），坑 %d 个" % [h0, w.height(at0.x, at0.z), level.blast_n])
	# 化神：留坑
	player.set_realm(4, false)
	await _raid_fps("破坏前")
	var b0: int = w.built
	Vfx.crater(at0, 1.2)
	await _wait(0.15)
	var t0 := Time.get_ticks_msec()
	await _wait_until(func() -> bool: return w.height(at0.x, at0.z) < h0 - 0.5 and w.rebuilding() == 0, 4.0)
	print("[quake] 化神砸地：地面 %.1f -> %.1f，从爆炸到地块重建完 %d ms，改表 %.2f ms，重建地块 %d 个，破坏表 %d 格" % [h0, w.height(at0.x, at0.z),
			Time.get_ticks_msec() - t0 + 150, level.blast_ms, w.built - b0, w.dug_table().size()])
	# 正常斗法的强度：每 0.4 秒一下，打 6 秒
	level.worst_frame_ms = 0.0
	var n0 := Engine.get_frames_drawn()
	var t1 := Time.get_ticks_msec()
	b0 = w.built
	var c0: int = level.blast_n
	for i in 15:
		var a := float(i) * 1.7
		var q := p + Vector3(cos(a), 0.0, sin(a)) * (8.0 + 3.0 * float(i % 4))
		q.y = level.ground(q.x, q.z)
		Vfx.crater(q, 1.0)
		await _wait(0.4)
	var fps := float(Engine.get_frames_drawn() - n0) * 1000.0 / float(Time.get_ticks_msec() - t1)
	print("[quake] 斗法强度（6 秒 15 下）：帧率 %.0f 最长帧 %.0fms 留坑 %d 个 重建地块 %d 次 改表 %.2f ms" % [fps, level.worst_frame_ms, level.blast_n - c0,
			w.built - b0, level.blast_ms])
	cam.snap(0.0, -0.55, 16.0)
	await _wait(1.0)
	await _shot(RAID + "96_craters")
	# 高强度：2 秒 40 下（先等截图存盘的那一长帧过去再开始计）
	await _wait(0.3)
	level.worst_frame_ms = 0.0
	n0 = Engine.get_frames_drawn()
	t1 = Time.get_ticks_msec()
	b0 = w.built
	c0 = level.blast_n
	var asked := 0
	for i in 40:
		var a := float(i) * 2.4
		var q := p + Vector3(cos(a), 0.0, sin(a)) * (6.0 + float(i % 7) * 4.0)
		q.y = level.ground(q.x, q.z)
		asked += 1 if Vfx.quake(q, 3.0 + float(i % 3)) else 0
		await _wait(0.05)
	await _wait(2.0)
	fps = float(Engine.get_frames_drawn() - n0) * 1000.0 / float(Time.get_ticks_msec() - t1)
	print("[quake] 高强度（2 秒 40 下，之后再等 2 秒）：帧率 %.0f 最长帧 %.0fms 接下 %d 下 留坑 %d 个 重建地块 %d 次 破坏表 %d 格" % [fps, level.worst_frame_ms, asked,
			level.blast_n - c0, w.built - b0, w.dug_table().size()])
	await _shot(RAID + "97_storm")
	await _raid_fps("破坏后")
	# 走进坑里：脚踩得到坑底
	player.global_position = Vector3(at0.x, w.height(at0.x, at0.z) + 0.2, at0.z)
	cam.snap(0.6, -0.3, 7.0)
	await _wait(0.8)
	await _shot(RAID + "98_in_crater")
	print("[quake] 站进坑里：主角高度 %.1f 坑底 %.1f 状态 %s" % [player.global_position.y, w.height(at0.x, at0.z), "地面" if player.st == Player.St.GROUND else "非地面"])


## `-- --raid-shot --raid-zoo`：怪物 / 掉落定妆。每个区域把两种小怪、两种精英、Boss 排在主角面前拍一张站姿（raid_8<n>_zoo），
## 放开让它们扑上来拍一张（raid_8<n>_zoo_fight），打死小怪拍尸体和掉落（raid_8<n>_zoo_dead）；最后把各品阶的掉落和三种箱子排开拍（raid_89_drops）。
func _run_raid_zoo(rd: Variant) -> void:
	# 掉落物：三行（法器 / 丹药 / 材料）× 五个品阶，后面一排三种箱子
	await _raid_goto(Vector2(-46.0, 38.0), 0.0)
	for m: Variant in rd._mobs.duplicate():
		if is_instance_valid(m):
			m.queue_free()
	rd._mobs.clear()
	var o := player.global_position
	var rng := RandomNumberGenerator.new()
	for t in 5:
		var x := (float(t) - 2.0) * 1.6
		for row in 3:
			var it: Dictionary = RaidData.make_gear(t, rng) if row == 0 else (RaidData.make_pill(t) if row == 1 else RaidData.make_mat(t))
			var q := o + Vector3(x, 0.0, -4.0 - 1.6 * float(row))
			q.y = level.ground(q.x, q.z)
			rd._drop_item(q, it, 999.0)
	var chests := [["啸月狼王 的遗藏", 4, -5.0], ["精英的遗物", 2, 0.0], ["韩立 的储物袋", 3, 5.0]]
	for c: Array in chests:
		var q := o + Vector3(float(c[2]), 0.0, -10.5)
		q.y = level.ground(q.x, q.z)
		rd._drop_chest(q, [RaidData.make_gear(int(c[1]), rng), RaidData.make_pill(1)], str(c[0]))
	cam.snap(0.0, -0.32, 6.5)
	await _wait(1.0)
	await _shot(RAID + "89_drops")
	print("[raid] 掉落定妆：地面掉落 %d" % rd._pickups.size())
	for pk: Variant in rd._pickups.duplicate():
		if is_instance_valid(pk):
			pk.queue_free()
	rd._pickups.clear()
	for i in 5:
		var d: Vector2 = RaidData.REGIONS[i]["dir"]
		var at := d.rotated(0.18) * 900.0 if i > 0 else Vector2(-46.0, 38.0)
		var yaw := atan2(-d.x, -d.y) if i > 0 else 0.0
		await _raid_goto(at, yaw)
		for m: Variant in rd._mobs.duplicate():
			if is_instance_valid(m):
				m.queue_free()
		rd._mobs.clear()
		await _wait(0.3)
		var p := player.global_position
		var fwd := Basis(Vector3.UP, yaw) * Vector3.FORWARD
		var side := Basis(Vector3.UP, yaw) * Vector3.RIGHT
		var defs: Array = RaidData.REGIONS[i]["mobs"]
		var lv: int = rd.enemy_level(i)
		var made: Array = []
		var slots := [[int(defs[0]), false, -7.5, 9.0], [int(defs[1]), false, -3.0, 8.0], [int(defs[0]), true, 2.5, 9.0],
				[int(defs[1]), true, 7.5, 8.0], [int(RaidData.REGIONS[i]["boss"]), false, 0.0, 24.0]]
		for sl: Array in slots:
			var q := p + side * float(sl[2]) + fwd * float(sl[3])
			q.y = level.ground(q.x, q.z)
			var m: Node3D = rd._spawn_mob(int(sl[0]), i, q, bool(sl[1]), lv)
			m.set_process(false)
			m.rotation.y = yaw + PI
			if m._float:
				m.global_position.y += 2.2
			made.append(m)
		cam.snap(yaw, -0.1, 7.0)
		await _wait(1.2)
		await _shot(RAID + "8%d_zoo" % i)
		var names: Array = []
		for m: Variant in made:
			names.append("%s(%s 高 %.1fm)" % [m.display_name, "模型" if m._anim != null else "方块", m.top_y()])
		print("[raid] 定妆 %s：%s" % [RaidData.REGIONS[i]["name"], " ".join(names)])
		for m: Variant in made:
			if is_instance_valid(m):
				m.set_process(true)
				m._facing = yaw + PI
				m.alert()
		await _wait(1.5)
		await _shot(RAID + "8%d_zoo_fight" % i)
		for m: Variant in made:
			if is_instance_valid(m) and not m.boss:
				m.receive_hit(player, {"dmg": 9999999.0, "dir": fwd})
		await _wait(0.7)
		await _shot(RAID + "8%d_zoo_dead" % i)
		await _raid_fps("定妆 %s（Boss + 尸体）" % RaidData.REGIONS[i]["name"])
		for m: Variant in made:
			if is_instance_valid(m):
				m.queue_free()
		for pk: Variant in rd._pickups.duplicate():
			if is_instance_valid(pk):
				pk.queue_free()
		rd._pickups.clear()


func _run_raid_demo() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://_shots/preview"))
	await _wait(1.0)
	player.set_realm(4, false)
	if OS.get_cmdline_user_args().has("--raid-match"):
		# 一键匹配（四人队，没有真人 → 三个 AI 道友补位）：进图后看它们跟不跟、打不打怪、主角飞远了追不追得上
		level_ui.team_size = 4
		level_ui.mode = "match"
		await _enter_level("meadow")
		var rm = level.raid
		_raid_immortal()
		await _wait(5.0)
		cam.snap(0.0, -0.25, 9.0)
		await _wait(0.3)
		await _shot(RAID + "90_allies")
		var hits := 0
		for f: Variant in rm._allies:
			hits += 1 if f.air_hit(player, {"dmg": 50.0, "dir": Vector3.FORWARD}) == -1 else 0
		print("[match] 进图 5 秒：联机=%s 房主=%s AI 队友 %d 个（应为 3）在索敌分组里的 %d 个，打队友返回 -1 的 %d 个" % [net.active, net.is_host, rm.ally_count(),
				rm._allies.filter(func(f: Variant) -> bool: return f.is_in_group("air_foes")).size(), hits])
		var k0: int = rm.kills
		await _wait(14.0)
		if not is_instance_valid(rm):
			print("[match] 房间关了（房主退出），自检到此为止")
			get_tree().quit()
			return
		var busy := 0
		var lines: Array = []
		for f: Variant in rm._allies:
			busy += 1 if f._prey != null else 0
			lines.append("%s Lv.%d 距主角 %dm%s" % [f.display_name, f.lv, int(f.global_position.distance_to(player.global_position)), " 打怪中" if f._prey != null else ""])
		await _shot(RAID + "91_allies_fight")
		print("[match] 原地 14 秒（主角没出手）：击杀 %d -> %d，正在打怪的队友 %d 个：%s" % [k0, rm.kills, busy, " | ".join(lines)])
		player.global_position += Vector3(260.0, 0.0, 0.0)
		player.global_position.y = level.ground(player.global_position.x, player.global_position.z) + 0.2
		await _wait(2.0)
		var far := 0.0
		for f: Variant in rm._allies:
			far = maxf(far, f.global_position.distance_to(player.global_position))
		await _shot(RAID + "92_allies_follow")
		print("[match] 主角瞬移出 260 米后 2 秒：最远的队友离主角 %dm" % int(far))
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-hitch"):
		player.set_realm(0, false)
		_hx_on = true
		if _warm:
			_hx_tag = "开机预热"
			await _boot_warm()
			print("[hx] 开机预热完：最长帧 %dms，用时 %dms" % [int(_hx_worst), Warm.last_ms])
		_hx_tag = "进图"
		await _enter_level("meadow")
		_raid_immortal()
		await _run_raid_hitch(level.raid)
		get_tree().quit()
		return
	await _enter_level("meadow")
	var rd = level.raid
	await _wait(1.0)
	await _shot(RAID + "00_spawn")
	await _raid_fps("出生点")
	rd._mob_root.visible = false
	await _raid_fps("出生点（藏起怪和修士，仅场景）")
	rd._mob_root.visible = true

	_raid_immortal()
	if OS.get_cmdline_user_args().has("--raid-zoo"):
		await _run_raid_zoo(rd)
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-yuanying"):
		rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
		await _raid_goto(Vector2(150.0, 130.0), 0.0)
		await _wait(1.0)
		if OS.get_cmdline_user_args().has("--yy-trib"):
			# 真实流程：结丹 → 起元婴雷劫（自动点击）→ 雷劫收尾接结婴过场 → 解冻怪物、交还界面和操作
			player.set_realm(2, false)
			rd._mob_root.process_mode = Node.PROCESS_MODE_INHERIT
			await _wait(0.5)
			rd.gm_tribulation(3)
			await _wait_until(func() -> bool: return rd.trib_active(), 4.0)
			if rd.trib_active():
				rd._trib.demo_auto = 1.0
			await _run_yuanying_demo(RAID + "t_", true)
			await _wait(0.5)
			print("[yy] 雷劫 + 过场之后：雷劫状态已清=%s 怪物恢复=%s 界面恢复=%s 等级 Lv.%d" % [not rd._in_trib, rd._mob_root.process_mode == Node.PROCESS_MODE_INHERIT, rd.hud.visible, rd.lv])
			get_tree().quit()
			return
		await _run_yuanying_demo(RAID)
		return
	if OS.get_cmdline_user_args().has("--raid-walk"):
		# 诊断：从出生点朝四个方向各走 4 秒，每半秒打印位置 / 脚下和前方的地面高度 / 速度
		rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
		cam.focus_yaw = false     # 近战镜头会自动转向附近的敌人，走直线测试时关掉
		for yw: float in [level.spawn_yaw(), level.spawn_yaw() + PI * 0.5]:
			await _raid_goto(Vector2.ZERO, yw)
			await _wait(0.5)
			Input.action_press("move_forward")
			for i in 8:
				await _wait(0.5)
				var pp := player.global_position
				var f := cam.flat_forward()
				print("[walk] 朝向 %.2f t=%.1f 位置 (%.1f, %.1f, %.1f) 脚下 %.1f 前方 2m %.1f 4m %.1f 速度 %.1f 状态 %d 着地 %s" % [yw, 0.5 * float(i + 1), pp.x, pp.y, pp.z,
						level.ground(pp.x, pp.z), level.ground(pp.x + f.x * 2.0, pp.z + f.z * 2.0), level.ground(pp.x + f.x * 4.0, pp.z + f.z * 4.0),
						player.velocity.length(), int(player.st), player.is_on_floor()])
			Input.action_release("move_forward")
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-vista"):
		await _run_raid_vista(rd)
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-quake"):
		await _run_raid_quake(rd)
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-vfxcost"):
		await _run_raid_vfxcost(rd)
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-surge"):
		await _run_raid_surge(rd)
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-fight") or OS.get_cmdline_user_args().has("--raid-fly"):
		if OS.get_cmdline_user_args().has("--raid-fight"):
			await _run_raid_fight(rd)
		if OS.get_cmdline_user_args().has("--raid-fly"):
			await _run_raid_fly(rd)
		print("[fight] 渲染器 %s  3D 分辨率 %.2f  窗口 %s  留住的着色器组合 %d 种（看过 %d 个材质）" % [RenderingServer.get_current_rendering_method(), get_viewport().scaling_3d_scale, str(get_window().size), _keep.size(), keep_seen])
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-terrain"):
		# 只测地形：外圈的起伏和远景雾 → 筑基走到高崖前自动升上去 → 化神飞进山体破开通道
		rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
		rd._mob_root.visible = false
		var w = level.world
		# 找一处高崖：沿北（黄枫谷）扫，找相邻 6 米内高差 ≥ 12 米的地方
		var cliff := Vector3.ZERO
		var found_c := false
		for zi in range(-520, -1300, -6):
			for xi in range(-240, 240, 12):
				var h0: float = w.height(float(xi), float(zi))
				var h1: float = w.height(float(xi), float(zi) - 8.0)
				var h2: float = w.height(float(xi), float(zi) - 30.0)
				if not found_c and h1 - h0 >= 6.0 and h2 - h0 >= 20.0:
					found_c = true
					cliff = Vector3(float(xi), h0, float(zi))
		var hi := 0.0
		for zi in range(-450, -1400, -10):
			for xi in range(-300, 300, 20):
				hi = maxf(hi, w.height(float(xi), float(zi)))
		print("[raid] 黄枫谷最高处 %.0f 米；找到高崖=%s 位置 %s" % [hi, found_c, cliff])
		await _raid_goto(Vector2(0.0, -700.0), 0.0, 0.0)
		player.toggle_flight()
		await _wait(1.0)
		player.global_position.y += 60.0
		cam.snap(0.3, -0.25, 12.0)
		await _wait(3.0)
		await _shot(RAID + "70_mountains")
		await _raid_fps("黄枫谷山地（高空）")
		player.force_ground()
		if found_c:
			# 筑基：朝崖壁走
			player.set_realm(1, false)
			await _raid_goto(Vector2(cliff.x, cliff.z + 6.0), 0.0)
			var y0 := player.global_position.y
			Input.action_press("move_forward")
			await _wait(1.2)
			await _shot(RAID + "71_climb")
			await _wait(3.0)
			Input.action_release("move_forward")
			print("[raid] 筑基朝高崖走 4.2 秒：高度 %.1f -> %.1f，往前走了 %.1f 米，状态 %s" % [y0, player.global_position.y,
					cliff.z + 6.0 - player.global_position.z, "地面" if player.st == Player.St.GROUND else "非地面"])
			# 化神：升空后朝山体里飞
			player.set_realm(4, false)
			await _raid_goto(Vector2(cliff.x, cliff.z + 14.0), 0.0)
			player.take_air()
			await _wait(1.0)
			var y1 := player.global_position.y
			var z1 := player.global_position.z
			Input.action_press("move_forward")
			await _wait(1.4)
			await _shot(RAID + "72_dig")
			await _wait(1.6)
			Input.action_release("move_forward")
			await _wait(0.8)
			cam.snap(PI, -0.35, 16.0)
			await _wait(1.0)
			await _shot(RAID + "73_trench")
			print("[raid] 化神飞进山体 3 秒：往前飞了 %.1f 米，高度 %.1f -> %.1f，破开 %d 格，仍在空战=%s" % [z1 - player.global_position.z, y1,
					player.global_position.y, level.dug_total, player.st == Player.St.AIR])
		get_tree().quit()
		return
	if OS.get_cmdline_user_args().has("--raid-trib"):
		# 只测大世界里的雷劫：灌一大笔经验 → 小境界连升、卡在瓶颈 → 起雷劫（自动点击）→ 突破
		await _wait(3.0)
		var lv_a: int = rd.lv
		rd.add_exp(1.0e9)
		print("[raid] 灌经验：Lv.%d -> Lv.%d 经验条 %d%% 待渡劫境界 %s" % [lv_a, rd.lv, int(rd.exp_ratio() * 100.0),
				Realm.LIST[rd._trib_to]["name"] if rd._trib_to >= 0 else "无"])
		await _wait_until(func() -> bool: return rd.trib_active(), 3.0)
		rd._trib.demo_auto = 1.0
		await _wait(1.6)
		await _shot(RAID + "60_trib_intro")
		await _wait(3.0)
		await _shot(RAID + "61_trib_play")
		print("[raid] 雷劫中：怪物定住=%s 界面隐藏=%s 主角停止处理=%s" % [rd._mob_root.process_mode == Node.PROCESS_MODE_DISABLED, not rd.hud.visible,
				player.process_mode == Node.PROCESS_MODE_DISABLED])
		await _wait_until(func() -> bool: return not rd._in_trib, 25.0)
		await _wait(0.6)
		await _shot(RAID + "62_trib_done")
		print("[raid] 雷劫后：Lv.%d %s期 经验条 %d%% 气血 %d 怪物恢复=%s 界面恢复=%s" % [rd.lv, player.realm["name"], int(rd.exp_ratio() * 100.0),
				int(player.melee.hp), rd._mob_root.process_mode == Node.PROCESS_MODE_INHERIT, rd.hud.visible])
		# 保底经验：化神以上在草原杀 1 级怪
		var x0: float = rd.xp
		rd.add_exp(rd.kill_exp(1, 1.0))
		print("[raid] 保底经验：Lv.%d 杀 1 级小怪 +%.1f（升级需要 %.0f，占 %.1f%%）" % [rd.lv, rd.xp - x0, RaidData.xp_need(rd.lv),
				(rd.xp - x0) / RaidData.xp_need(rd.lv) * 100.0])
		get_tree().quit()
		return
	# 0a. 上台阶：沿 +x 找高一格 / 高两格 / 高三格以上的相邻两格，各走过去一次（一二格该上去，三格该被挡住）
	rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
	for want: int in [1, 2, 3]:
		var found := false
		for ix in range(8, 400):
			for iz in range(-30, 30, 3):
				var xa := float(ix) * 2.0 + 1.0
				var zc := float(iz) * 2.0 + 1.0
				var ha: float = level.ground(xa, zc)
				var hb: float = level.ground(xa + 2.0, zc)
				var dh := int(round(hb - ha))
				if not found and (dh == want or (want == 3 and dh >= 3)) and absf(level.ground(xa - 2.0, zc) - ha) < 0.1:
					found = true
					player.force_ground()
					player.velocity = Vector3.ZERO
					player.global_position = Vector3(xa - 1.5, ha + 0.05, zc)
					cam.snap(-PI * 0.5, -0.18, 9.0)
					await _wait(0.4)
					Input.action_press("move_forward")
					await _wait(0.6)
					Input.action_release("move_forward")
					await _wait(0.2)
					var pp := player.global_position
					print("[raid] 台阶高 %d 格：走之前 x=%.1f y=%.1f，走之后 x=%.1f y=%.1f（台阶在 x=%.1f，上面高度 %.1f）→ %s" % [dh, xa - 1.5, ha, pp.x, pp.y,
							xa + 1.0, hb, "上去了" if pp.y > ha + 0.5 else ("被挡住" if pp.x < xa + 1.2 else "没上去")])
			if found:
				break
	rd._mob_root.process_mode = Node.PROCESS_MODE_INHERIT
	if OS.get_cmdline_user_args().has("--raid-step"):
		get_tree().quit()
		return
	await _raid_goto(Vector2.ZERO, level.spawn_yaw())
	# 0. 走路上下台阶：朝一个方向走 6 秒，看高度有没有跟着地形变、有没有被一格高的台阶卡住
	var w0 := player.global_position
	var ups := 0
	var downs := 0
	var last_y := w0.y
	rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED   # 走路测试期间怪和修士先定住，免得被打断
	cam.focus_yaw = false     # 近战镜头会自动转向附近的敌人，主角跟着绕圈；走直线测试时关掉
	rd._mob_root.visible = false
	player.force_ground()
	await _wait(0.5)
	w0 = player.global_position
	last_y = w0.y
	Input.action_press("move_forward")
	for i in 60:
		await _wait(0.1)
		var dy := player.global_position.y - last_y
		if dy > 0.5:
			ups += 1
		elif dy < -0.5:
			downs += 1
		last_y = player.global_position.y
	Input.action_release("move_forward")
	rd._mob_root.process_mode = Node.PROCESS_MODE_INHERIT
	rd._mob_root.visible = true
	var w1 := player.global_position
	print("[raid] 走 6 秒：水平走了 %.1fm 上台阶 %d 次 下台阶 %d 次 脚下差 %.2f 着地=%s 状态=%s" % [Vector2(w1.x - w0.x, w1.z - w0.z).length(), ups, downs,
			w1.y - level.ground(w1.x, w1.z), player.is_on_floor(), "地面" if player.st == Player.St.GROUND else "非地面"])
	await _shot(RAID + "00b_walk")
	# 掉头走回去（来时下坡，回去就是上台阶）
	rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
	cam.snap(level.spawn_yaw() + PI, -0.18, 9.0)
	ups = 0
	last_y = player.global_position.y
	var w2 := player.global_position
	Input.action_press("move_forward")
	for i in 60:
		await _wait(0.1)
		if player.global_position.y - last_y > 0.5:
			ups += 1
		last_y = player.global_position.y
	Input.action_release("move_forward")
	rd._mob_root.process_mode = Node.PROCESS_MODE_INHERIT
	var w3 := player.global_position
	print("[raid] 掉头走 6 秒：水平走了 %.1fm 上台阶 %d 次 高度 %.1f -> %.1f 脚下差 %.2f 状态=%s" % [Vector2(w3.x - w2.x, w3.z - w2.z).length(), ups, w2.y, w3.y,
			w3.y - level.ground(w3.x, w3.z), "地面" if player.st == Player.St.GROUND else "非地面"])
	# 1. 什么都不做站 8 秒：怪和修士应该自己冒出来、打起来
	player.melee.hp = 100.0
	await _wait(8.0)
	_raid_census("原地等 8 秒后")
	await _shot(RAID + "01_alive")
	player.toggle_flight()
	await _wait(1.0)
	player.global_position.y += 22.0
	cam.snap(level.spawn_yaw() + 0.6, -0.45, 14.0)
	await _wait(1.0)
	await _shot(RAID + "02_wide")
	player.force_ground()

	# 2. 找最近的一只小怪：空战连击打它，看等级换算后的伤害，再清场捡掉落
	var mob: Variant = null
	for m: Variant in rd._mobs:
		if is_instance_valid(m) and not m.boss and (mob == null or m.global_position.distance_to(player.global_position) < mob.global_position.distance_to(player.global_position)):
			mob = m
	if mob != null and is_instance_valid(mob):
		var mp: Vector3 = mob.global_position
		await _raid_goto(Vector2(mp.x, mp.z + 6.0), 0.0)
		await _wait(0.6)
		await _shot(RAID + "03_mob")
		player.take_air()
		await _wait(0.7)
		var hp0: float = mob.hp if is_instance_valid(mob) else 0.0
		for i in 5:
			if not is_instance_valid(mob):
				break
			player.air.press_attack()
			await _wait(0.32)
		await _shot(RAID + "04_mob_fight")
		print("[raid] 空战连击打 %s：血 %d -> %s（主角 Lv.%d）" % [mob.display_name if is_instance_valid(mob) else "小怪", int(hp0),
				str(int(mob.hp)) if is_instance_valid(mob) else "已击杀", rd.lv])
	var lv0: int = rd.lv
	for m: Variant in rd._mobs.duplicate():
		if is_instance_valid(m):
			m.receive_hit(player, {"dmg": 99999.0, "dir": Vector3.FORWARD})
	await _wait(0.4)
	print("[raid] 清怪后：击杀 %d 地面掉落 %d 修为 Lv.%d -> Lv.%d（%d%%）主角气血 %d" % [rd.kills, rd._pickups.size(), lv0, rd.lv,
			int(rd.exp_ratio() * 100.0), int(player.melee.hp)])
	for pk: Variant in rd._pickups.duplicate():
		if is_instance_valid(pk):
			player.force_ground()
			player.global_position = pk.global_position + Vector3(0.6, 0.1, 0.0)
			await _wait(1.4 if pk.is_chest() else 0.7)
	print("[raid] 拾取后：背包 %d 件 价值 %d" % [rd.bag.size(), rd.bag_value()])

	cam.focus_yaw = true
	# 3. 四个区域各看一眼（风格、帧率、有没有怪和修士）
	for i in range(1, 5):
		var d: Vector2 = RaidData.REGIONS[i]["dir"]
		player.melee.hp = 100.0
		await _raid_goto(d.rotated(0.18) * 900.0, atan2(-d.x, -d.y))
		await _wait(6.0)
		_raid_census(str(RaidData.REGIONS[i]["name"]))
		await _shot(RAID + "1%d_region" % i)
		player.toggle_flight()
		await _wait(1.0)
		player.global_position.y += 16.0
		Input.action_press("move_forward")
		await _raid_fps("%s 飞行" % RaidData.REGIONS[i]["name"])
		Input.action_release("move_forward")
		await _shot(RAID + "1%d_region_fly" % i)
		player.force_ground()

	# 4. 巢穴 Boss：血色禁地的墨蛟
	player.melee.hp = 100.0
	var bpos: Vector3 = rd._bosses[2]["pos"]
	await _raid_goto(Vector2(bpos.x - 24.0, bpos.z), -PI * 0.5)
	await _wait(2.0)
	await _shot(RAID + "20_boss")
	var boss: Node3D = rd._bosses[2]["node"]
	print("[raid] 巢穴 Boss：%s 血 %d 状态 %s" % [("%s Lv.%d" % [boss.display_name, boss.lv]) if is_instance_valid(boss) else "未生成",
			int(boss.hp) if is_instance_valid(boss) else 0, boss.state_name() if is_instance_valid(boss) else ""])
	await _wait(3.0)
	await _shot(RAID + "21_boss_attack")
	print("[raid] 挨 Boss 打 3 秒后：主角气血 %d" % int(player.melee.hp))
	var c0: float = rd.coeff()
	if is_instance_valid(boss):
		boss.receive_hit(player, {"dmg": 9999999.0, "dir": Vector3.RIGHT})
	await _wait(0.6)
	await _shot(RAID + "22_boss_chest")
	print("[raid] 击败巢穴 Boss：难度系数 %.2f -> %.2f，主角 Lv.%d %s期" % [c0, rd.coeff(), rd.lv, player.realm["name"]])

	# 5. 天地异动：游荡 Boss 找上门
	player.melee.hp = 100.0
	var ev: Node3D = rd.boss_event()
	await _wait(2.5)
	await _shot(RAID + "23_boss_event")
	if is_instance_valid(ev):
		print("[raid] 游荡 Boss：%s Lv.%d 血 %d 距离 %dm" % [ev.display_name, ev.lv, int(ev.hp), int(ev.global_position.distance_to(player.global_position))])
		ev.receive_hit(player, {"dmg": 9999999.0, "dir": Vector3.RIGHT})
	await _wait(0.5)

	# 6. 其他修士：回草原，看他们自己刷怪；再击败一个开箱
	player.melee.hp = 100.0
	await _raid_goto(Vector2(120.0, 60.0), 0.0)
	await _wait(12.0)
	_raid_census("草原等 12 秒后")
	var rv: Variant = null
	for f: Variant in rd._rivals:
		if is_instance_valid(f) and (rv == null or (f._prey != null and rv._prey == null)):
			rv = f
	if rv != null and is_instance_valid(rv):
		var rp: Vector3 = rv.global_position
		player.melee.hp = 100.0
		await _raid_goto(Vector2(rp.x, rp.z + 11.0), 0.0)
		await _wait(0.8)
		await _shot(RAID + "30_rival")
		print("[raid] 修士 %s：%s 状态 %s 主角气血 %d" % [rv.display_name if is_instance_valid(rv) else "?", "打怪中" if is_instance_valid(rv) and rv._prey != null else "游荡",
				rv.state_name() if is_instance_valid(rv) else "", int(player.melee.hp)])
		if is_instance_valid(rv):
			var cp: Vector3 = rv.global_position
			rv.air_hit(player, {"dmg": 9999999.0, "dir": Vector3.FORWARD, "contact": rv.center()})
			await _wait(0.6)
			player.force_ground()
			player.global_position = Vector3(cp.x + 1.5, level.ground(cp.x, cp.z) + 0.1, cp.z)
			await _wait(0.6)
			await _shot(RAID + "31_rival_chest")
			await _wait(1.2)
	print("[raid] 开箱后：背包 %d 件 价值 %d" % [rd.bag.size(), rd.bag_value()])

	# 7. 背包：打开、服一颗丹药
	rd.hud.toggle_bag()
	await _wait(0.4)
	await _shot(RAID + "40_bag")
	var ex0: float = rd.exp_ratio()
	var l0: int = rd.lv
	for i in rd.bag.size():
		if rd.bag[i]["kind"] == "pill":
			rd.use_item(i)
			break
	await _wait(0.3)
	print("[raid] 服丹：Lv.%d %d%% -> Lv.%d %d%%（%s期）背包 %d 件" % [l0, int(ex0 * 100.0), rd.lv, int(rd.exp_ratio() * 100.0),
			player.realm["name"], rd.bag.size()])
	rd.hud.toggle_bag()

	# 8. 撤离：先看一座废阵，再去亮着的那座读条
	player.melee.hp = 100.0
	var dead_e: Dictionary = {}
	var live_e: Dictionary = {}
	for e: Dictionary in rd._extracts:
		if bool(e["active"]) and live_e.is_empty():
			live_e = e
		elif not bool(e["active"]) and dead_e.is_empty():
			dead_e = e
	var dp: Vector3 = dead_e["pos"]
	await _raid_goto(Vector2(dp.x, dp.z + 22.0), 0.0)
	await _wait(1.0)
	await _shot(RAID + "50_extract_dead")
	var lp: Vector3 = live_e["pos"]
	await _raid_goto(Vector2(lp.x, lp.z + 22.0), 0.0)
	await _wait(1.0)
	await _shot(RAID + "51_extract_live")
	rd._mob_root.process_mode = Node.PROCESS_MODE_DISABLED
	player.global_position = Vector3(lp.x, level.ground(lp.x, lp.z) + 0.6, lp.z)
	await _wait(3.0)
	await _shot(RAID + "52_extracting")
	print("[raid] 撤离读条 %.0f%%" % (float(rd.extract_k) * 100.0))
	await _wait_until(func() -> bool: return not rd.running, 6.0)
	await _wait(0.8)
	await _shot(RAID + "53_result")
	await _wait_until(func() -> bool: return level == null, 10.0)
	await _wait(1.0)
	print("[raid] 回到大厅=%s" % (level == null))
	get_tree().quit()
