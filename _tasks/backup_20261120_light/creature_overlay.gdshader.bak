shader_type spatial;
// 生物模型的叠加层（material_overlay）：受击闪白 + 精英 / Boss / 高品阶掉落的轮廓泛光。
// 只加亮、不改原贴图；不用的时候脚本会把叠加层摘掉，不多一遍绘制。
render_mode unshaded, blend_add, depth_draw_never, shadows_disabled;

uniform vec3 tint : source_color = vec3(1.0, 0.6, 0.2);
uniform float rim = 0.0;      // 轮廓泛光强度
uniform float flash = 0.0;    // 受击闪白

void fragment() {
	float f = pow(1.0 - clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0), 3.2);
	float pulse = 0.8 + 0.2 * sin(TIME * 3.0);
	ALBEDO = tint * (f * rim * pulse + rim * 0.04) + vec3(flash * 0.85);
}
