+## 真人对打：近身的灵力（觉醒中不耗）。不够返回 false
+func _pvp_pay(mp: float) -> bool:
+	if awake_t > 0.0:
+		return true
+	if player.mp < mp:
+		return false
+	player.mp = maxf(player.mp - mp, 0.0)
