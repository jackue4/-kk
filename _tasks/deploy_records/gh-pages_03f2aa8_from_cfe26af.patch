+## 真人对打：起手这一招开始了 —— 从动身 / 现身到判定不足 PVP_OPEN_T 的，差多少就先摆着架势按住多少。返回要按住多久
+func _open_take(hit_t: float) -> float:
+	if not _opener:
+		return 0.0
+	_opener = false
+	if not _pvp(target):
+		return 0.0
+	var hold := maxf(Moves.PVP_OPEN_T - (_now() - _open_at) - hit_t, 0.0)
