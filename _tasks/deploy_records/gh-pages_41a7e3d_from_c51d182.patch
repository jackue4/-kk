+static func _stack_key(it: Dictionary) -> String:
+	if it.is_empty():
+		return ""
+	return "%s|%s|%d|%s|%d" % [str(it.get("kind", "")), str(it.get("name", "")), int(it.get("tier", 0)), str(it.get("fx", "")), int(it.get("amt", 0))]
+
+
+## 把一列东西叠起来：[[这一叠第一件的下标, 件数], ...]，按第一次出现的先后排
+static func _stacks(list: Array) -> Array:
+	var out: Array = []
+	var at := {}
+	for i in list.size():
+		var key := _stack_key(list[i])
+		if at.has(key):
+			var st: Array = out[int(at[key])]
+			st[1] = int(st[1]) + 1
+		else:
+			at[key] = out.size()
+			out.append([i, 1])
+	return out
+
+
