+## n 相对模型根的变换（不含模型根自己的）
+static func _rel_xf(n: Node, root: Node) -> Transform3D:
+	var xf := Transform3D.IDENTITY
+	var q: Node = n
+	while q != null and q != root:
+		if q is Node3D:
+			xf = (q as Node3D).transform * xf
+		q = q.get_parent()
+	return xf
