+## AI 角色该用哪个样式（返回空 = 方块小人）：AI_SKINS 里按名字定一个。用名字的 md5 取模，不用随机数 ——
+## 联机时主人机器上的 AI 道友和别人机器上的木偶只同步了名字，这样两边算出来是同一个样子。
+## `--block-hero` / `--block-ai`：AI 全用方块小人（对照 / 回归）；`--ai-skin=moyan|bage|evelyn|block`：全用指定的一种（自检 / 拍图）
+static func ai_key(seed_text: String) -> String:
+	var args := OS.get_cmdline_user_args()
+	if args.has("--block-hero") or args.has("--block-ai"):
+		return ""
+	var k := str(AI_SKINS[int((seed_text + AI_SALT).md5_buffer()[0]) % AI_SKINS.size()])
+	for a in args:
+		if a.begins_with("--ai-skin="):
+			k = a.substr(10)
+	return k if SKINS.has(k) and not profile(k).is_empty() else ""
+
+
+static func _scene(skin: String) -> PackedScene:
+	if not _scenes.has(skin):
+		var path := str((SKINS.get(skin, {}) as Dictionary).get("scene", ""))
+		_scenes[skin] = (load(path) as PackedScene) if path != "" and ResourceLoader.exists(path) else null
+	return _scenes[skin]
+
+
+## 开机预热用（warmup.gd）：把 AI 会用到的几个皮肤各摆一个出来（只是模型 + 这里的材质，不带骨架驱动），
+## 这样模型 / 贴图在载入界面里就读进来、传给显卡了，第一个 AI 道友 / 陪练出场时不用现读
+static func warm_nodes() -> Array:
+	var out: Array = []
+	for k: String in AI_SKINS:
+		if k == "" or profile(k).is_empty():
+			continue
+		var model := _scene(k).instantiate() as Node3D
+		for ap: AnimationPlayer in model.find_children("*", "AnimationPlayer", true, false):
+			ap.get_parent().remove_child(ap)
+			ap.free()
+		var by_tex := {}
+		for mi: MeshInstance3D in model.find_children("*", "MeshInstance3D", true, false):
+			if mi.mesh == null:
+				continue
+			mi.extra_cull_margin = 60.0
+			for s in mi.mesh.get_surface_count():
+				var src := mi.mesh.surface_get_material(s) as BaseMaterial3D
+				var tex: Texture2D = src.albedo_texture if src != null else null
+				if not by_tex.has(tex):
+					var m := ShaderMaterial.new()
+					m.shader = BODY_SH
+					m.set_shader_parameter("albedo_tex", tex)
+					by_tex[tex] = m
+				mi.set_surface_override_material(s, by_tex[tex])
+		out.append(model)
+	return out
+
