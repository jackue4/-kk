+extends Node3D
+## 主角的皮肤模型（2026-11-23）：把方块人换成资源库「01_主角动画皮肤」里带骨骼的模型（现在是「阿拉灯」）。
+##
+## 只换画面上的那个人，招式一点不动：voxel_hero.gd 的十五个关节节点照旧建、照旧被 animate() / fighter_rig.gd /
+## 空战姿势驱动，只是不再出方块网格；这里每帧把模型的骨骼摆到这些关节上（位置 = 关节位置，朝向 = 关节朝向 × 对齐）。
+## 所以近战 / 空战的姿势、兵器挂点（手上的 holder）、剑尖 / 拳脚的命中点、镜头、判定都和方块人时一样，
+## 模型自带的那 162 段动画一段也用不上（_tasks/hero_skin/strip_glb.py 里已全删）。
+##
+## 比例：模型是大头短身，四肢长度和方块人不一样。关节的位置和四肢长度换成模型自己的（profile() 从静止姿势里量），
+## 这样手、脚、肩都正好长在模型身上（剑握在手里而不是悬在一边）。量出来的数由 voxel_hero.gd 摆到关节节点上、
+## 同时给 fighter_rig.gd 算屈膝 / 够剑用。
+## 对齐：方块人「站直」= 手臂、腿都竖直垂下；模型静止时手臂是斜张着的（A 字），所以每段肢体先转到竖直再跟关节走。
+##
+## 另外几样和方块人对应的东西：受击闪白 / 化光（同名参数的着色器 hero_skin.gdshader）、觉醒描边 / PvP 锁定描边
+## （法线磨平的影子网格，开着才有）、挨打溅的碎块颜色、眨眼、头发和腰间挂饰随速度往后飘。
+## 故意不写 class_name：用 preload 引用。
+
+const BODY_SH := preload("res://shaders/hero_skin.gdshader")
+const LINE_SH := preload("res://shaders/hero_skin_outline.gdshader")
+
+const C_WHITE := Color(0.96, 0.95, 0.92)
+const C_PURPLE := Color(0.5, 0.3, 0.74)
+const C_GOLD := Color(0.94, 0.76, 0.26)
+const C_SKIN := Color(0.98, 0.84, 0.72)
+const C_HAIR := Color(0.93, 0.88, 0.68)
+const CUBE := 0.06            # 碎裂方块的小格边长（米，缩放前）；voxel_shatter 再两格并一块
+
+## 主角（本机 / 联机里别人的主角 / 左上角头像）用哪个皮肤
+const PLAYER_SKIN := "aladeng"
+
+## 皮肤表。成对的骨骼不分左右写（转换出来的名字左右是反的），哪根在 +X 一侧哪根就跟右边的关节。
+##   scale  模型整体缩放（阿拉灯原始脚到头顶 1.55 米、算上羽饰 1.91 米；放大到头顶和方块人差不多高，约 1.75 米）
+##   palm   手腕到掌心（米，缩放前）：兵器握在这里
+##   sway   随速度往后飘的骨骼链：[骨骼名…, 跟哪个关节（head / lower）, 幅度]
+##   chips  挨打溅出来的碎块颜色（按身上的占比）
+##   cubes  陨落碎裂（voxel_shatter.gd）时各关节拆成的方块：[x0, y0, z0, x1, y1, z1, 颜色]（米，缩放前，相对关节；左右件共用）。
+##          方块人是拿自己的方块拆的，皮肤模型没有方块，照体型给每个关节估几块
+const SKINS := {
+	"aladeng": {
+		"scene": "res://assets/hero/aladeng.glb",
+		"blink": "res://assets/hero/aladeng_face_blink.png",
+		"scale": 1.12,
+		"pelvis": "Bip01 Pelvis", "spine": "Bip01 Spine", "head": "Head",
+		"arm": ["Bip01 L UpperArm", "Bip01 R UpperArm"],
+		"fore": ["Bip01 L Forearm", "Bip01 R Forearm"],
+		"hand": ["Bip01 L Hand", "Bip01 R Hand"],
+		"leg": ["Bip01 L Thigh", "Bip01 R Thigh"],
+		"shin": ["Bip01 L Calf", "Bip01 R Calf"],
+		"foot": ["Bip01 L Foot", "Bip01 R Foot"],
+		"palm": 0.05,
+		"face": "face", "face_bone": "faceBone",
+		"sway": [
+			[["140161_hair01", "140161_hair02", "140161_hair03"], "head", 1.0],
+			[["140161_A01", "140161_A02", "140161_A03", "140161_A04"], "lower", 0.6],
+		],
+		"chips": [C_WHITE, C_WHITE, C_PURPLE, C_PURPLE, C_GOLD, C_GOLD, C_SKIN, C_HAIR],
+		"cubes": {
+			"head": [[-0.27, 0.02, -0.26, 0.27, 0.34, 0.26, C_SKIN], [-0.3, 0.02, 0.08, 0.3, 0.34, 0.3, C_HAIR],
+					[-0.31, 0.3, -0.28, 0.31, 0.66, 0.3, C_HAIR], [0.22, 0.5, -0.12, 0.34, 0.92, 0.0, C_PURPLE]],
+			"upper": [[-0.17, 0.0, -0.11, 0.17, 0.3, 0.11, C_WHITE], [-0.24, 0.17, -0.12, 0.24, 0.28, 0.15, C_PURPLE]],
+			"lower": [[-0.22, -0.2, -0.17, 0.22, 0.02, 0.17, C_WHITE], [-0.21, 0.02, -0.16, 0.21, 0.09, 0.16, C_GOLD]],
+			"leg": [[-0.1, -0.21, -0.11, 0.1, 0.0, 0.11, C_WHITE]],
+			"shin": [[-0.09, -0.16, -0.1, 0.09, 0.0, 0.1, C_WHITE], [-0.09, -0.22, -0.1, 0.09, -0.16, 0.1, C_GOLD]],
+			"foot": [[-0.07, -0.065, -0.14, 0.07, 0.0, 0.07, Color(0.32, 0.22, 0.14)]],
+			"arm": [[-0.06, -0.23, -0.06, 0.06, 0.0, 0.06, C_SKIN], [-0.07, -0.16, -0.07, 0.07, -0.09, 0.07, C_PURPLE]],
+			"fore": [[-0.055, -0.145, -0.055, 0.055, 0.0, 0.055, C_SKIN]],
+			"hand": [[-0.05, -0.09, -0.05, 0.05, 0.0, 0.05, C_SKIN]],
+		},
+	},
+}
+
+static var _prof := {}        # 皮肤名 → 量好的比例（空表 = 这个皮肤用不了）
+static var _smooth := {}      # 网格 → 法线磨平的副本（描边用）
+
+var hero: Node3D              # voxel_hero.gd
+var key := ""
+var _sk: Skeleton3D
+var _inv := Transform3D.IDENTITY      # 角色空间 → 骨架空间
+# 跟着关节走的骨骼（父在前）：骨骼下标 / 关节节点 / 对齐后的静止朝向 / 上一级在表里的下标 / 上一级到它父骨骼之间那几根不动骨骼的静止变换
+var _mb := PackedInt32Array()
+var _mn: Array[Node3D] = []
+var _ma: Array[Basis] = []
+var _mp := PackedInt32Array()
+var _mk: Array[Transform3D] = []
+var _gh: Array[Transform3D] = []
+var _gb: Array[Transform3D] = []
+# 飘动的骨骼：骨骼下标 / 静止的本地旋转 / 父骨骼的静止朝向（角色空间）/ 幅度 / 在链上第几节
+var _sway: Array = []
+var _mats: Array[ShaderMaterial] = []
+var _meshes: Array[MeshInstance3D] = []
+var _face_mat: ShaderMaterial
+var _face_tex: Texture2D
+var _blink_tex: Texture2D
+var _blink := 0.0             # 离下一次眨眼还有多久；眨着的时候是负的
+var _ghosts: Array[MeshInstance3D] = []
+var _line: ShaderMaterial
+var _t := 0.0
+var _flow := 0.0
+
+
+## 主角该用哪个皮肤：`--block-hero` 时返回空（还用方块人，对照 / 回归用）；模型文件不在也返回空
+static func player_key() -> String:
+	if OS.get_cmdline_user_args().has("--block-hero"):
+		return ""
+	return PLAYER_SKIN if not profile(PLAYER_SKIN).is_empty() else ""
+
+
+static func _chain(n: Node3D, top: Node3D) -> Transform3D:
+	var xf := Transform3D.IDENTITY
+	var c := n
+	while c != null:
+		xf = c.transform * xf
+		if c == top:
+			break
+		c = c.get_parent() as Node3D
+	return xf
+
+
+static func _skeleton(root: Node) -> Skeleton3D:
+	var found: Array = root.find_children("*", "Skeleton3D", true, false)
+	return (found[0] as Skeleton3D) if not found.is_empty() else null
+
+
+## 成对骨骼里在 +X 一侧的那根（right = false 取另一根）
+static func _side(sk: Skeleton3D, xf: Transform3D, names: Array, right: bool) -> int:
+	var a := sk.find_bone(str(names[0]))
+	var b := sk.find_bone(str(names[1]))
+	var a_right := (xf * sk.get_bone_global_rest(a)).origin.x > (xf * sk.get_bone_global_rest(b)).origin.x
+	return a if a_right == right else b
+
+
+## 从模型的静止姿势里量出方块骨架要用的比例（米，角色空间：脚底在原点、面朝 -Z）。一个皮肤量一次。
+##   hip_y 髋高（腿伸直踩地时） · hip_z · hip_x 髋关节离中线 · thigh / shank 大腿、小腿骨长 · ankle 踝高
+##   waist 腰相对髋 · neck 头的转轴相对腰 · sh 右肩相对腰 · upper / fore 上臂、前臂长 · palm 腕到掌心
+##   face 脸的中心（头像取景用）
+static func profile(skin: String) -> Dictionary:
+	if _prof.has(skin):
+		return _prof[skin]
+	var p := {}
+	_prof[skin] = p
+	if not SKINS.has(skin):
+		return p
+	var def: Dictionary = SKINS[skin]
+	if not ResourceLoader.exists(str(def["scene"])):
+		push_warning("hero_skin: 没有模型 " + str(def["scene"]))
+		return p
+	var ps := load(str(def["scene"])) as PackedScene
+	var root: Node3D = null
+	if ps != null:
+		root = ps.instantiate() as Node3D
+	var sk: Skeleton3D = null
+	if root != null:
+		sk = _skeleton(root)
+	if sk == null:
+		push_warning("hero_skin: 模型里没有骨架 " + str(def["scene"]))
+		if root != null:
+			root.free()
+		return p
+	var k := float(def["scale"])
+	var xf := Transform3D(Basis.IDENTITY.scaled(Vector3.ONE * k), Vector3.ZERO) * _chain(sk, root)
+	var at := func(b: int) -> Vector3:
+		return (xf * sk.get_bone_global_rest(b)).origin
+	var pel: Vector3 = at.call(sk.find_bone(str(def["pelvis"])))
+	var spn: Vector3 = at.call(sk.find_bone(str(def["spine"])))
+	var hd: Vector3 = at.call(sk.find_bone(str(def["head"])))
+	var thigh := 0.0
+	var shank := 0.0
+	var ankle := 0.0
+	var hip_x := 0.0
+	var upper := 0.0
+	var fore := 0.0
+	var sh := Vector3.ZERO
+	for right: bool in [true, false]:
+		var hj: Vector3 = at.call(_side(sk, xf, def["leg"], right))
+		var kn: Vector3 = at.call(_side(sk, xf, def["shin"], right))
+		var an: Vector3 = at.call(_side(sk, xf, def["foot"], right))
+		thigh += hj.distance_to(kn) * 0.5
+		shank += kn.distance_to(an) * 0.5
+		ankle += an.y * 0.5
+		hip_x += absf(hj.x) * 0.5
+		var s0: Vector3 = at.call(_side(sk, xf, def["arm"], right))
+		var el: Vector3 = at.call(_side(sk, xf, def["fore"], right))
+		var wr: Vector3 = at.call(_side(sk, xf, def["hand"], right))
+		upper += s0.distance_to(el) * 0.5
+		fore += el.distance_to(wr) * 0.5
+		sh += Vector3(absf(s0.x), s0.y, s0.z) * 0.5
+	p["scale"] = k
+	p["hip_y"] = ankle + thigh + shank
+	p["hip_z"] = pel.z
+	p["hip_x"] = hip_x
+	p["thigh"] = thigh
+	p["shank"] = shank
+	p["ankle"] = ankle
+	p["waist"] = Vector3(0.0, spn.y - pel.y, spn.z - pel.z)
+	p["neck"] = Vector3(0.0, hd.y - spn.y, hd.z - spn.z)
+	p["sh"] = Vector3(sh.x, sh.y - spn.y, sh.z - spn.z)
+	p["upper"] = upper
+	p["fore"] = fore
+	p["palm"] = float(def["palm"]) * k
+	var fb := sk.find_bone(str(def.get("face_bone", "")))
+	var face: Vector3 = hd + Vector3(0.0, 0.3 * k, 0.0)
+	if fb >= 0:
+		face = at.call(fb)
+	p["face"] = face
+	root.free()
+	return p
+
+
+## 接到一个方块骨架上（voxel_hero.gd 的 _init 里调，这时它还没进树）：建模型、对好骨骼、把关节挪到模型的比例上
+func attach(h: Node3D, skin: String) -> bool:
+	var p := profile(skin)
+	if p.is_empty():
+		return false
+	hero = h
+	key = skin
+	var def: Dictionary = SKINS[skin]
+	var k := float(p["scale"])
+	var model := (load(str(def["scene"])) as PackedScene).instantiate() as Node3D
+	model.scale = Vector3.ONE * k
+	add_child(model)
+	_sk = _skeleton(model)
+	var xf := _chain(_sk, model)
+	_inv = xf.affine_inverse()
+
+	# 关节挪到模型的比例上（都是相对父关节的位置；站直 = 四肢竖直垂下）
+	var thigh := float(p["thigh"])
+	var shank := float(p["shank"])
+	var sh: Vector3 = p["sh"]
+	h.lower.position = Vector3(0.0, float(p["hip_y"]), float(p["hip_z"]))
+	h.upper.position = p["waist"]
+	h.head.position = p["neck"]
+	for right: bool in [true, false]:
+		var sx := 1.0 if right else -1.0
+		var leg: Node3D = h.leg_r if right else h.leg_l
+		var shin: Node3D = h.shin_r if right else h.shin_l
+		var foot: Node3D = h.foot_r if right else h.foot_l
+		var arm: Node3D = h.arm_r if right else h.arm_l
+		var fr: Node3D = h.fore_r if right else h.fore_l
+		var hand: Node3D = h.hand_r if right else h.hand_l
+		leg.position = Vector3(float(p["hip_x"]) * sx, 0.0, 0.0)
+		shin.position = Vector3(0.0, -thigh, 0.0)
+		foot.position = Vector3(0.0, -shank, 0.0)
+		arm.position = Vector3(sh.x * sx, sh.y, sh.z)
+		fr.position = Vector3(0.0, -float(p["upper"]), 0.0)
+		hand.position = Vector3(0.0, -float(p["fore"]), 0.0)
+
+	# 四肢长度交给这副骨架（fighter_rig.gd 算屈膝 / 掌心 / 够剑用）
+	var palm_d := float(p["palm"])
+	h.hip_y = float(p["hip_y"])
+	h.thigh_len = thigh
+	h.shank_len = shank + float(p["ankle"])
+	h.leg_len = thigh + shank + float(p["ankle"])
+	h.arm_len = float(p["upper"]) + float(p["fore"]) + palm_d
+	h.palm = Vector3(0.0, -palm_d, 0.0)
+	h.shoulder = Vector3(sh.x, float(p["hip_y"]) + (p["waist"] as Vector3).y + sh.y, float(p["hip_z"]) + (p["waist"] as Vector3).z + sh.z)
+
+	# 骨骼 ← 关节。躯干、头、脚保持模型静止时的朝向；四肢每一段从静止方向转到竖直朝下
+	var i_low := _bind(_sk.find_bone(str(def["pelvis"])), h.lower, -1, xf, Vector3.ZERO)
+	var i_up := _bind(_sk.find_bone(str(def["spine"])), h.upper, i_low, xf, Vector3.ZERO)
+	_bind(_sk.find_bone(str(def["head"])), h.head, i_up, xf, Vector3.ZERO)
+	for right: bool in [true, false]:
+		var b_arm := _side(_sk, xf, def["arm"], right)
+		var b_fore := _side(_sk, xf, def["fore"], right)
+		var b_hand := _side(_sk, xf, def["hand"], right)
+		var d_up := _dir(xf, b_arm, b_fore)
+		var d_fore := _dir(xf, b_fore, b_hand)
+		var i_arm := _bind(b_arm, h.arm_r if right else h.arm_l, i_up, xf, d_up)
+		var i_fore := _bind(b_fore, h.fore_r if right else h.fore_l, i_arm, xf, d_fore)
+		_bind(b_hand, h.hand_r if right else h.hand_l, i_fore, xf, d_fore)
+		var b_leg := _side(_sk, xf, def["leg"], right)
+		var b_shin := _side(_sk, xf, def["shin"], right)
+		var b_foot := _side(_sk, xf, def["foot"], right)
+		var i_leg := _bind(b_leg, h.leg_r if right else h.leg_l, i_low, xf, _dir(xf, b_leg, b_shin))
+		var i_shin := _bind(b_shin, h.shin_r if right else h.shin_l, i_leg, xf, _dir(xf, b_shin, b_foot))
+		_bind(b_foot, h.foot_r if right else h.foot_l, i_shin, xf, Vector3.ZERO)
+	_gh.resize(_mb.size())
+	_gb.resize(_mb.size())
+
+	# 陨落碎裂用的小格（Vfx.shatter 按关节上的 vox_cells 拆块）
+	var cubes: Dictionary = def.get("cubes", {})
+	var parts := {"head": [h.head], "upper": [h.upper], "lower": [h.lower], "leg": [h.leg_l, h.leg_r], "shin": [h.shin_l, h.shin_r],
+			"foot": [h.foot_l, h.foot_r], "arm": [h.arm_l, h.arm_r], "fore": [h.fore_l, h.fore_r], "hand": [h.hand_l, h.hand_r]}
+	for part: String in cubes:
+		var cells := {}
+		for bx: Array in cubes[part]:
+			for x in range(floori(float(bx[0]) / CUBE + 0.25), maxi(ceili(float(bx[3]) / CUBE - 0.25), floori(float(bx[0]) / CUBE + 0.25) + 1)):
+				for y in range(floori(float(bx[1]) / CUBE + 0.25), maxi(ceili(float(bx[4]) / CUBE - 0.25), floori(float(bx[1]) / CUBE + 0.25) + 1)):
+					for z in range(floori(float(bx[2]) / CUBE + 0.25), maxi(ceili(float(bx[5]) / CUBE - 0.25), floori(float(bx[2]) / CUBE + 0.25) + 1)):
+						cells[Vector3i(x, y, z)] = bx[6]
+		for node: Node3D in parts.get(part, []):
+			node.set_meta("vox_cells", cells)
+			node.set_meta("vox_unit", CUBE * k)
+			node.set_meta("vox_pivot", Vector3.ZERO)
+
+	# 飘动的骨骼链（头发 / 腰间挂饰）
+	for row: Array in def.get("sway", []):
+		var names: Array = row[0]
+		for j in names.size():
+			var b := _sk.find_bone(str(names[j]))
+			if b < 0:
+				continue
+			var par := _sk.get_bone_parent(b)
+			var pg := (xf * _sk.get_bone_global_rest(par)).basis.orthonormalized() if par >= 0 else Basis.IDENTITY
+			_sway.append([b, _sk.get_bone_rest(b).basis.get_rotation_quaternion(), pg, float(row[2]), j, names.size()])
+
+	# 材质：同一张贴图一份，都是这个人自己的（受击闪白 / 化光各管各的）
+	var by_tex := {}
+	for mi: MeshInstance3D in model.find_children("*", "MeshInstance3D", true, false):
+		if mi.mesh == null:
+			continue
+		_meshes.append(mi)
+		mi.extra_cull_margin = 60.0     # 模型节点上有 0.01 的缩放，这是模型自己的单位（厘米）
+		_smooth_mesh(mi.mesh)           # 描边用的磨平副本趁载入先算好（按网格缓存，整局只算一次），别等觉醒 / 被锁定那一下才算
+		for s in mi.mesh.get_surface_count():
+			var src := mi.mesh.surface_get_material(s) as BaseMaterial3D
+			var tex: Texture2D = src.albedo_texture if src != null else null
+			if not by_tex.has(tex):
+				var m := ShaderMaterial.new()
+				m.shader = BODY_SH
+				m.set_shader_parameter("albedo_tex", tex)
+				by_tex[tex] = m
+				_mats.append(m)
+			mi.set_surface_override_material(s, by_tex[tex])
+			if mi.name == str(def.get("face", "")):
+				_face_mat = by_tex[tex]
+				_face_tex = tex
+	var bp := str(def.get("blink", ""))
+	if _face_mat != null and bp != "" and ResourceLoader.exists(bp):
+		_blink_tex = load(bp) as Texture2D
+	_blink = randf_range(1.5, 4.5)
+	process_priority = 5      # 在角色脚本（摆姿势的）之后、镜头和刀光拖尾之前
+	sync()
+	return true
+
+
+func _dir(xf: Transform3D, from: int, to: int) -> Vector3:
+	return ((xf * _sk.get_bone_global_rest(to)).origin - (xf * _sk.get_bone_global_rest(from)).origin).normalized()
+
+
+## 登记一根跟着关节走的骨骼。rest_dir：这段肢体静止时的方向（零向量 = 不用对齐），对齐 = 沿最短的弧转到竖直朝下。
+## 骨骼的位置每帧取关节的位置，所以对齐只能是「转到关节站直时的方向」，不能另加张开角（要张开得在关节上张）
+func _bind(b: int, node: Node3D, parent_i: int, xf: Transform3D, rest_dir: Vector3) -> int:
+	var rest := (xf * _sk.get_bone_global_rest(b)).basis
+	var align := Basis.IDENTITY
+	if rest_dir.length_squared() > 0.5:
+		var axis := rest_dir.cross(Vector3.DOWN)
+		if axis.length_squared() > 1e-10:
+			align = Basis(axis.normalized(), rest_dir.angle_to(Vector3.DOWN))
+	# 这根骨骼的父骨骼相对「上一级跟随骨骼」的静止变换（中间隔着的锁骨、脊柱第二节、脖子不动）
+	var k := Transform3D.IDENTITY
+	var par := _sk.get_bone_parent(b)
+	var stop := int(_mb[parent_i]) if parent_i >= 0 else -1
+	while par >= 0 and par != stop:
+		k = _sk.get_bone_rest(par) * k
+		par = _sk.get_bone_parent(par)
+	_mb.append(b)
+	_mn.append(node)
+	_ma.append(align * rest)
+	_mp.append(parent_i)
+	_mk.append(k)
+	return _mb.size() - 1
+
+
+func _process(dt: float) -> void:
+	_t += dt
+	if _blink_tex != null:
+		_blink -= dt
+		if _blink <= 0.0 and _blink + dt > 0.0:
+			_face_mat.set_shader_parameter("albedo_tex", _blink_tex)
+		elif _blink < -0.12:
+			_face_mat.set_shader_parameter("albedo_tex", _face_tex)
+			_blink = randf_range(2.2, 5.5)
+	if hero != null:
+		_flow = lerpf(_flow, clampf(float(hero.get("_stream")), 0.0, 1.3), 1.0 - exp(-10.0 * dt))
+	sync()
+
+
+## 把骨骼摆到关节上。每帧在所有摆姿势的脚本之后做一次（process_priority）
+func sync() -> void:
+	if _sk == null:
+		return
+	for i in _mb.size():
+		var p := int(_mp[i])
+		var th: Transform3D = _mn[i].transform if p < 0 else _gh[p] * _mn[i].transform
+		_gh[i] = th
+		var gb := _inv * Transform3D(th.basis * _ma[i], th.origin)
+		_gb[i] = gb
+		var loc := (_mk[i] if p < 0 else _gb[p] * _mk[i]).affine_inverse() * gb
+		var b := int(_mb[i])
+		_sk.set_bone_pose_position(b, loc.origin)
+		_sk.set_bone_pose_rotation(b, loc.basis.get_rotation_quaternion())
+	# 头发 / 挂饰：速度越快越往后扬，平时轻轻晃
+	var s := _flow
+	for e: Array in _sway:
+		var amp: float = e[3]
+		var j: int = e[4]
+		var n: int = e[5]
+		var back := -(0.03 + s * 0.85) * amp / float(n) * (1.0 + 0.35 * float(j))
+		var q := Quaternion(Vector3.RIGHT, back + sin(_t * (4.2 + 0.7 * float(j)) - 0.9 * float(j)) * (0.02 + 0.07 * s) * amp) \
+				* Quaternion(Vector3.BACK, sin(_t * 2.7 + 1.3 * float(j)) * 0.04 * (0.4 + s) * amp)
+		var pg: Basis = e[2]
+		_sk.set_bone_pose_rotation(int(e[0]), (pg.inverse() * Basis(q) * pg).get_rotation_quaternion() * (e[1] as Quaternion))
+
+
+# ---------- 和方块人对应的几个接口（voxel_hero.gd 转过来） ----------
+
+func set_flash(v: float) -> void:
+	for m in _mats:
+		m.set_shader_parameter("flash", v)
+
+
+func set_glow(v: float, color: Color) -> void:
+	for m in _mats:
+		m.set_shader_parameter("glow", v)
+		m.set_shader_parameter("glow_color", color)
+
+
+## 描边（k 0~1，0 = 关）。开着的时候身体那几件网格各多一份「影子」（法线磨平、只画背面、往外撑一圈），关了就撤掉
+func set_line(k: float, color: Color, width := 0.026, whiten := 0.25, flicker := 1.0) -> void:
+	if k <= 0.001:
+		for g in _ghosts:
+			if is_instance_valid(g):
+				g.queue_free()
+		_ghosts.clear()
+		return
+	if _line == null:
+		_line = ShaderMaterial.new()
+		_line.shader = LINE_SH
+	_line.set_shader_parameter("power", k)
+	_line.set_shader_parameter("line_color", color)
+	_line.set_shader_parameter("width", width)
+	_line.set_shader_parameter("whiten", whiten)
+	_line.set_shader_parameter("flicker", flicker)
+	if not _ghosts.is_empty():
+		return
+	for mi in _meshes:
+		var g := MeshInstance3D.new()
+		g.mesh = _smooth_mesh(mi.mesh)
+		g.material_override = _line
+		g.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+		g.extra_cull_margin = mi.extra_cull_margin
+		g.set_meta("shenshi_ghost", true)      # 神识描边（shen_shi.gd）找网格时跳过这一份
+		_sk.add_child(g)
+		g.skin = mi.skin
+		g.skeleton = NodePath("..")
+		_ghosts.append(g)
+
+
+func line_on() -> bool:
+	return not _ghosts.is_empty()
+
+
+func chip_colors() -> Array:
+	return SKINS[key]["chips"]
+
+
+## 法线磨平的网格副本（同 shen_shi.gd 的 smooth_mesh）：同一位置上的几个顶点法线取平均，撑出去的壳是连着的；骨骼权重原样带着
+static func _smooth_mesh(src: Mesh) -> Mesh:
+	var id := src.get_instance_id()
+	if _smooth.has(id):
+		return _smooth[id]
+	var am := ArrayMesh.new()
+	for si in src.get_surface_count():
+		var arr: Array = src.surface_get_arrays(si)
+		var verts: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
+		var nv: Variant = arr[Mesh.ARRAY_NORMAL]
+		if nv is PackedVector3Array and (nv as PackedVector3Array).size() == verts.size():
+			var norms: PackedVector3Array = nv
+			var acc := {}
+			for i in verts.size():
+				acc[verts[i]] = (acc.get(verts[i], Vector3.ZERO) as Vector3) + norms[i]
+			for i in verts.size():
+				var n: Vector3 = acc[verts[i]]
+				if n.length_squared() > 1e-8:
+					norms[i] = n.normalized()
+			arr[Mesh.ARRAY_NORMAL] = norms
+		arr[Mesh.ARRAY_TANGENT] = null
+		var flags := 0
+		if src is ArrayMesh:
+			flags = (src as ArrayMesh).surface_get_format(si) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS
+		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr, [], {}, flags)
+	_smooth[id] = am
+	return am
