+// 主角皮肤模型（scripts/hero_skin.gd，2026-11-23）：带骨骼的贴图网格。
+// 受击闪白 / 化光这两个参数和方块人（block.gdshader）同名同义，voxel_hero.gd 的 set_flash / set_glow 两边一起设。
+// floor_glow：按贴图本来的颜色自带一点底光（和怪的模型一个做法）—— 脸背光、站在影子里也不会黑成一团。
+shader_type spatial;
+
+uniform sampler2D albedo_tex : source_color, filter_linear_mipmap, repeat_enable;
+uniform float rough : hint_range(0.0, 1.0) = 0.8;
+uniform float floor_glow : hint_range(0.0, 1.0) = 0.16;
+uniform float flash : hint_range(0.0, 1.0) = 0.0;
+uniform float glow : hint_range(0.0, 1.0) = 0.0;
+uniform vec3 glow_color : source_color = vec3(0.4, 0.7, 1.0);
+
+void fragment() {
+	vec3 base = texture(albedo_tex, UV).rgb;
+	ALBEDO = mix(base, vec3(1.0), flash * 0.6);
+	ALBEDO = mix(ALBEDO, mix(glow_color, vec3(1.0), 0.35), glow * 0.85);
+	EMISSION = base * floor_glow * (1.0 - glow) + vec3(1.0, 0.95, 0.9) * flash * 0.25 + glow_color * glow * 1.6;
+	ROUGHNESS = rough;
+	SPECULAR = 0.25;
+}
--- /dev/null
+++ b/shaders/hero_skin_outline.gdshader
@@ -0,0 +1,32 @@
+// 主角皮肤模型的描边（scripts/hero_skin.gd 的 set_line，2026-11-23）：觉醒描边 / PvP 锁定描边在皮肤模型上的那一遍。
+// 参数和方块人的 block_outline.gdshader 一一对应（线色 / 线宽 / 淡入 / 泛白 / 闪动），区别只在往哪个方向撑：
+// 方块人按方块角的方向，这里是带骨骼的网格，沿法线撑 —— 用的是法线磨平过的网格副本（面与面的接缝不裂开），骨骼照样带着它动。
+// 线宽在视空间里按米算（模型节点上有 0.01 的缩放，不能在模型空间里加）。
+shader_type spatial;
+render_mode unshaded, cull_front, shadows_disabled, fog_disabled;
+
+uniform vec3 line_color : source_color = vec3(0.5, 0.9, 1.0);
+uniform float width = 0.026;
+uniform float power = 1.0;
+uniform float push = 0.16;
+uniform float whiten = 0.25;
+uniform float flicker = 1.0;
+
+#if CURRENT_RENDERER == RENDERER_COMPATIBILITY
+const float ENERGY = 1.0;
+#else
+const float ENERGY = 1.5;
+#endif
+
+void vertex() {
+	vec4 vp = MODELVIEW_MATRIX * vec4(VERTEX, 1.0);
+	float dist = length(vp.xyz);
+	float w = width * power * clamp(dist / 7.0, 1.0, 3.5) * mix(1.0, 0.88 + 0.12 * sin(TIME * 7.0), flicker);
+	vp.xyz += normalize((MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz) * w;
+	vp.xyz += normalize(vp.xyz) * push;
+	POSITION = PROJECTION_MATRIX * vp;
+}
+
+void fragment() {
+	ALBEDO = mix(line_color, vec3(1.0), whiten) * mix(1.0, 0.9 + 0.1 * sin(TIME * 7.0), flicker) * ENERGY;
+}
