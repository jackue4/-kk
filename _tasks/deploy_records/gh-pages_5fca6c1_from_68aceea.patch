diff -ruN '--exclude=*.uid' mini_before/shaders/realm_halo_blade.gdshader mini_after/shaders/realm_halo_blade.gdshader
--- mini_before/shaders/realm_halo_blade.gdshader	1970-01-01 08:00:00.000000000 +0800
+++ mini_after/shaders/realm_halo_blade.gdshader	2026-11-23 23:26:44.165508100 +0800
@@ -0,0 +1,203 @@
+// 境界光环特效 · 片（scripts/realm_halo.gd）。一个光环上所有的「片」—— 莲瓣、羽毛、火苗、晶簇、符纸、金符、宝石、星芒、
+// 冠上的花苞、流苏 —— 都是同一个 MultiMesh 里的方片，各自的形状在这里按 style 画（不采贴图，放多大都是清楚的）。
+// 每片自己的数据：COLOR = 颜色（rgb）和浓淡（a）；INSTANCE_CUSTOM = (style, 相位 0~1, 摆动幅度（弧度）, 参数)。
+// 片的局部坐标：x 横向 -1~1，y 从根（-1）到尖（+1）。展开时按相位一片片长出来；摆动绕着根。
+//   0 莲瓣（半透明、亮边、叶脉）  1 莲瓣线稿（只有发光的轮廓）  2 羽毛  3 火苗  4 晶簇  5 符纸  6 菱形金符
+//   7 宝石  8 星芒（会闪）  9 花苞（实心，冠饰用）  10 流苏  11 尖角（龙角 / 龙吻）  12 光团
+shader_type spatial;
+render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;
+
+#include "res://shaders/realm_halo_inc.gdshaderinc"
+
+uniform vec3 rim_col = vec3(1.0, 0.86, 0.52);      // 描边 / 高光的颜色（这一档的金）
+uniform float reveal = 1.0;
+uniform float rear = 1.0;
+
+varying vec4 v_inst;
+varying vec4 v_tint;
+
+void vertex() {
+	v_inst = INSTANCE_CUSTOM;
+	v_tint = COLOR;
+	float ph = INSTANCE_CUSTOM.g;
+	float grow = smoothstep(ph * 0.55, ph * 0.55 + 0.45, reveal);
+	int st = int(INSTANCE_CUSTOM.r + 0.5);
+	vec2 q = VERTEX.xy;
+	if (st == 8) {
+		q *= grow * (0.5 + 0.5 * sin(TIME * (1.6 + ph * 2.6) + ph * 40.0));
+	} else {
+		q.y += 0.5;
+		q *= vec2(mix(0.5, 1.0, grow), grow);
+		float ang = INSTANCE_CUSTOM.b * sin(TIME * 1.3 + ph * 6.2831);
+		q = vec2(q.x * cos(ang) - q.y * sin(ang), q.x * sin(ang) + q.y * cos(ang));
+		q.y -= 0.5;
+	}
+	VERTEX.xy = q;
+	vec3 vp = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	vec3 vn = normalize((MODELVIEW_MATRIX * vec4(0.0, 0.0, 1.0, 0.0)).xyz);
+	POSITION = halo_clip(vp, vn, PROJECTION_MATRIX);
+}
+
+// 中间鼓、两头尖的轮廓：t = 0 根、1 尖；a、b 越小那一头越钝。归一到最宽处 = 1
+float prof(float t, float a, float b) {
+	float n = pow(a / (a + b), a) * pow(b / (a + b), b);
+	return pow(max(t, 0.0001), a) * pow(max(1.0 - t, 0.0001), b) / n;
+}
+
+void fragment() {
+	vec2 q = vec2(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0) / 0.9;       // 四周留一点边给柔光
+	float t = clamp(q.y * 0.5 + 0.5, 0.0, 1.0);
+	int st = int(v_inst.r + 0.5);
+	float par = v_inst.a;
+	vec3 tint = v_tint.rgb;
+	float in_y = step(abs(q.y), 1.0);
+	// 每种形状给出：c 本色、cov 形状盖住的范围、op 多实（1 = 不透，0 = 纯光）、g 形状外面的一圈柔光、
+	// lum 自己发多少光（0 = 半透明的地方颜色也跟着淡，像琉璃；1 = 再透也是满亮度，像火）。
+	// 颜色是「盖」上去的（亮边盖在本色上，不是加上去），不然几层一叠就冲成白的了
+	vec3 c = tint;
+	float cov = 0.0;
+	float op = 0.0;
+	float g = 0.0;
+	float lum = 0.35;
+	vec3 gc = tint;
+	if (st == 0 || st == 1 || st == 9) {
+		float half = 0.86 * prof(t, 0.42, 0.72);
+		float d = (half - abs(q.x)) * in_y;
+		cov = smoothstep(0.0, 0.05, d);
+		float rim = smoothstep(st == 9 ? 0.12 : 0.16, 0.03, d);
+		g = exp(-max(-d, 0.0) * 12.0) * (1.0 - cov) * in_y;
+		if (st == 0) {
+			float vein = exp(-pow(q.x / 0.035, 2.0)) * smoothstep(0.03, 0.3, t) * (1.0 - 0.6 * t);
+			float side = pow(max(sin(abs(q.x) / max(half, 0.02) * 7.8), 0.0), 10.0) * 0.5 * smoothstep(0.15, 0.5, t);
+			float ink = clamp(rim + vein * 0.7 + side, 0.0, 1.0);
+			c = mix(tint * (0.6 + 0.4 * t), rim_col, ink);
+			op = mix(0.3 + 0.62 * par, 0.97, ink);
+			g *= 0.3;
+		} else if (st == 1) {
+			// 线稿：一圈轮廓 + 中间一道叶脉，线是实的
+			float vein = exp(-pow(q.x / 0.04, 2.0)) * smoothstep(0.08, 0.35, t) * (1.0 - t);
+			c = rim_col;
+			cov *= max(rim, vein * 0.7);
+			op = 0.9;
+			lum = 1.0;
+			g *= 0.5;
+			gc = rim_col;
+		} else {
+			// 实心花苞：左上受光、右下暗一点，中间一道棱
+			float lit = 0.76 + 0.24 * smoothstep(0.5, -0.5, q.x * 0.8 - q.y * 0.3);
+			float ridge = exp(-pow(q.x / 0.05, 2.0)) * 0.45;
+			c = mix(tint * lit, rim_col, clamp(rim * 0.85 + ridge, 0.0, 1.0));
+			op = 0.96;
+			g *= 0.3;
+			gc = rim_col;
+		}
+	} else if (st == 2) {
+		float half = 0.8 * prof(t, 0.3, 1.05);
+		float d = (half - abs(q.x)) * in_y;
+		cov = smoothstep(0.0, 0.05, d);
+		float spine = exp(-pow(q.x / 0.045, 2.0)) * (1.0 - 0.4 * t);
+		float barb = (0.5 + 0.5 * sin(abs(q.x) * 16.0 - q.y * 22.0)) * 0.2;
+		float rim = smoothstep(0.1, 0.015, d);
+		float ink = clamp(spine * 0.9 + rim * 0.7, 0.0, 1.0);
+		c = mix(tint * (0.66 + 0.34 * (1.0 - t) + barb), rim_col, ink);
+		op = mix(0.25 + 0.65 * par, 0.95, ink);
+		g = exp(-max(-d, 0.0) * 11.0) * (1.0 - cov) * in_y * 0.35;
+	} else if (st == 3) {
+		float wob = 0.1 * sin(q.y * 5.0 - TIME * 5.5 + v_inst.g * 30.0) * t;
+		float half = 0.62 * prof(t, 0.45, 1.3) * (0.92 + 0.08 * sin(TIME * 7.0 + v_inst.g * 17.0));
+		float d = (half - abs(q.x - wob)) * in_y;
+		cov = smoothstep(0.0, 0.08, d);
+		float core = smoothstep(0.1, 0.4, d) * smoothstep(0.8, 0.15, t);
+		c = mix(mix(tint, rim_col, core), vec3(1.0, 0.97, 0.8), core * core * 0.45);
+		cov *= 0.8 + 0.2 * core;
+		op = 0.3 + 0.5 * par;
+		lum = 0.75;
+		g = exp(-max(-d, 0.0) * 8.0) * (1.0 - cov) * in_y * 0.45;
+	} else if (st == 4) {
+		float half = 0.62 * min(min(t / 0.3, 1.0), (1.0 - t) / 0.42);
+		float d = (half - abs(q.x)) * in_y;
+		cov = smoothstep(0.0, 0.045, d);
+		float rim = smoothstep(0.1, 0.015, d);
+		float facet = q.x < 0.0 ? 1.0 : 0.66;
+		float ridge = exp(-pow(q.x / 0.03, 2.0)) * 0.8;
+		float gl = pow(max(1.0 - abs(t - 0.62) * 3.0, 0.0), 3.0) * 0.6;
+		c = mix(tint * facet * (0.6 + 0.4 * t), rim_col, clamp(rim * 0.75 + ridge, 0.0, 1.0));
+		c = mix(c, vec3(1.0), gl);
+		op = 0.5 + 0.4 * par;
+		g = exp(-max(-d, 0.0) * 12.0) * (1.0 - cov) * in_y * 0.4;
+	} else if (st == 5) {
+		vec2 b = abs(q) - vec2(0.56, 0.9);
+		float d = -max(b.x, b.y);
+		cov = smoothstep(0.0, 0.04, d);
+		float border = smoothstep(0.15, 0.1, d) * smoothstep(0.02, 0.06, d);
+		// 符纸上的字：几道横画，长短按相位掷；中间一竖
+		float row = floor((q.y + 0.75) / 0.25);
+		float fy = fract((q.y + 0.75) / 0.25) - 0.5;
+		float len = 0.14 + 0.26 * halo_hash(row * 3.7 + v_inst.g * 91.0);
+		float glyph = step(abs(q.y), 0.72) * step(abs(q.x), len) * exp(-pow(fy / 0.16, 2.0));
+		float stem = step(abs(q.y), 0.66) * exp(-pow(q.x / 0.035, 2.0)) * 0.7;
+		float ink = clamp(border + glyph * 0.9 + stem, 0.0, 1.0);
+		c = mix(tint * 0.75, rim_col, ink);
+		cov *= max(ink, 0.3);
+		op = 0.25 * par;
+		lum = 1.0;
+		g = exp(-max(-d, 0.0) * 10.0) * (1.0 - cov) * 0.3;
+	} else if (st == 6 || st == 7) {
+		float d = 1.0 - (abs(q.x) / 0.72 + abs(q.y) / 1.0);
+		cov = smoothstep(0.0, 0.035, d);
+		g = exp(-max(-d, 0.0) * 9.0) * (1.0 - cov);
+		if (st == 6) {
+			float border = smoothstep(0.18, 0.12, d);
+			float inner = exp(-pow((d - 0.36) / 0.035, 2.0));
+			float knot = smoothstep(0.035, 0.0, abs(1.0 - (abs(q.x) / 0.2 + abs(q.y) / 0.28)) * 0.2);
+			float cross = (exp(-pow(q.x / 0.03, 2.0)) + exp(-pow(q.y / 0.04, 2.0))) * step(0.36, d) * 0.6;
+			float lit = 0.55 + 0.35 * smoothstep(-1.0, 1.0, -q.x + q.y);
+			c = mix(tint * lit, rim_col, clamp(border + inner * 0.9 + knot + cross, 0.0, 1.0));
+			op = 0.7 * par;
+			g *= 0.4;
+			gc = rim_col;
+		} else {
+			float facet = 0.55 + 0.45 * smoothstep(0.3, -0.3, q.x - q.y * 0.6);
+			float border = smoothstep(0.16, 0.06, d);
+			c = mix(tint * facet, rim_col, border * 0.8);
+			op = 0.92;
+			// 宝石上的一点星芒（形状外面也有）
+			float star = (exp(-abs(q.x) * 14.0) * exp(-abs(q.y) * 2.6) + exp(-abs(q.y) * 14.0) * exp(-abs(q.x) * 2.6)) * (0.6 + 0.4 * sin(TIME * 2.4 + v_inst.g * 30.0));
+			c = mix(c, vec3(1.0), clamp(star, 0.0, 1.0) * cov);
+			g = g * 0.5 + star * (1.0 - cov) * 0.7;
+			gc = mix(tint, vec3(1.0), 0.5);
+		}
+	} else if (st == 8) {
+		float star = exp(-abs(q.x) * 16.0) * exp(-abs(q.y) * 2.4) + exp(-abs(q.y) * 16.0) * exp(-abs(q.x) * 2.4);
+		g = clamp(star + exp(-dot(q, q) * 26.0), 0.0, 1.0);
+		gc = mix(tint, vec3(1.0), 0.4);
+	} else if (st == 10) {
+		float line = exp(-pow(q.x / 0.06, 2.0)) * step(-0.55, q.y) * in_y;
+		float bead = smoothstep(0.2, 0.12, length((q - vec2(0.0, 0.82)) * vec2(1.0, 0.55)));
+		float ty = clamp((-0.55 - q.y) / 0.45, 0.0, 1.0);
+		float fringe = step(q.y, -0.55) * in_y * smoothstep(0.26 * (1.0 - ty * 0.7), 0.0, abs(q.x)) * (0.6 + 0.4 * sin(q.x * 40.0));
+		cov = clamp(line + bead + fringe, 0.0, 1.0);
+		lum = 1.0;
+		c = mix(tint, rim_col, clamp(line + bead, 0.0, 1.0));
+		op = clamp(bead * 0.9 + fringe * 0.6 * par + line * 0.5, 0.0, 1.0);
+	} else if (st == 11) {
+		float half = 0.85 * (1.0 - t) * (0.9 + 0.1 * t);
+		float d = (half - abs(q.x)) * in_y;
+		cov = smoothstep(0.0, 0.05, d);
+		float rim = smoothstep(0.12, 0.02, d);
+		float lit = 0.78 + 0.22 * smoothstep(0.4, -0.4, q.x);
+		c = mix(tint * lit, rim_col, rim * 0.8);
+		op = 0.94 * par;
+		g = exp(-max(-d, 0.0) * 12.0) * (1.0 - cov) * in_y * 0.3;
+	} else {
+		float r = length(q);
+		float core = exp(-r * r * 7.0);
+		g = clamp(core + exp(-r * 3.0) * 0.4, 0.0, 1.0) * (0.88 + 0.12 * sin(TIME * 2.2 + v_inst.g * 20.0)) * smoothstep(1.0, 0.8, r);
+		gc = mix(tint, vec3(1.0), core * 0.6);
+	}
+	float k = power * v_tint.a * mix(1.0, rear, float(FRONT_FACING));
+	vec3 p = (c * cov * mix(op, 1.0, lum) + gc * g * 0.55) * k;
+	float a = cov * op * k;
+	ALBEDO = halo_albedo(p, a);
+	ALPHA = a;
+}
diff -ruN '--exclude=*.uid' mini_before/shaders/realm_halo_disc.gdshader mini_after/shaders/realm_halo_disc.gdshader
--- mini_before/shaders/realm_halo_disc.gdshader	1970-01-01 08:00:00.000000000 +0800
+++ mini_after/shaders/realm_halo_disc.gdshader	2026-11-23 23:26:44.136503800 +0800
@@ -0,0 +1,101 @@
+// 境界光环特效 · 圆面（scripts/realm_halo.gd）。画在一张方片上，kind：
+//   0 光核：中间一团柔光 + 一圈缓缓转的光芒（各档环心的光）
+//   1 星门：深紫的夜空、旋臂、星点、亮核，整体慢慢转（化神）
+//   2 元婴：一团光里蜷着的小人影，随呼吸明暗（元婴）
+//   3 灵胎：半透明的一颗大珠子，边上实、中间透，里面有缓缓转的流纹（元婴的环心）
+// 都不采贴图、不用噪声，手机上也便宜；而且只在觉醒那十几秒里画。
+shader_type spatial;
+render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;
+
+#include "res://shaders/realm_halo_inc.gdshaderinc"
+
+uniform int kind = 0;
+uniform vec3 col_a = vec3(1.0, 0.9, 0.7);      // 主色
+uniform vec3 col_b = vec3(1.0);               // 亮处 / 核心的颜色
+uniform float rays = 12.0;                    // 光芒条数（0 = 没有）
+uniform float reveal = 1.0;
+uniform float rear = 1.0;                     // 从背面（镜头在人身后）看时的强度：圆面正好挡着人，背面要淡
+uniform float seed = 0.0;
+
+float sd_ellipse(vec2 p, vec2 c, vec2 r) {
+	vec2 q = (p - c) / r;
+	return (length(q) - 1.0) * min(r.x, r.y);
+}
+
+float smin(float a, float b, float k) {
+	float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
+	return mix(b, a, h) - k * h * (1.0 - h);
+}
+
+void vertex() {
+	vec3 vp = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	vec3 vn = normalize((MODELVIEW_MATRIX * vec4(0.0, 0.0, 1.0, 0.0)).xyz);
+	POSITION = halo_clip(vp, vn, PROJECTION_MATRIX);
+}
+
+void fragment() {
+	vec2 q = vec2(UV.x * 2.0 - 1.0, 1.0 - UV.y * 2.0);
+	float r = length(q);
+	float th = atan(q.x, q.y);
+	vec3 p = vec3(0.0);
+	float a = 0.0;
+	if (kind == 0) {
+		float core = exp(-r * r * 9.0);
+		float haze = exp(-r * 2.6) * 0.5;
+		float ray = 0.0;
+		if (rays > 0.5) {
+			float s = sin(th * rays + TIME * 0.35 + seed);
+			float s2 = sin(th * (rays * 0.5 + 1.0) - TIME * 0.22);
+			ray = pow(max(s, 0.0), 6.0) * (0.6 + 0.4 * s2) * exp(-r * 2.2) * smoothstep(0.05, 0.3, r);
+		}
+		float pulse = 0.88 + 0.12 * sin(TIME * 1.9 + seed);
+		p = (col_b * core + col_a * (haze + ray * 0.9)) * pulse * smoothstep(1.0, 0.75, r);
+	} else if (kind == 1) {
+		float inside = smoothstep(1.0, 0.93, r);
+		float sp = th + TIME * 0.22;
+		// 两条对数螺旋的旋臂
+		float arm = 0.5 + 0.5 * sin(2.0 * sp + 7.5 * log(r + 0.06));
+		float arms = pow(arm, 3.0) * exp(-r * 2.4) * smoothstep(0.02, 0.2, r);
+		float dust = (0.5 + 0.5 * sin(5.0 * sp - 11.0 * r)) * exp(-r * 1.6) * 0.25;
+		float core = exp(-r * r * 60.0) + exp(-r * 7.0) * 0.6;
+		// 星点：跟着慢转的格子
+		float ca = cos(TIME * 0.05);
+		float sa = sin(TIME * 0.05);
+		vec2 sq = vec2(q.x * ca - q.y * sa, q.x * sa + q.y * ca) * 13.0;
+		vec2 cell = floor(sq);
+		vec2 f = fract(sq) - 0.5;
+		float h = halo_hash2(cell + seed);
+		vec2 off = vec2(halo_hash2(cell + 3.1), halo_hash2(cell + 7.7)) - 0.5;
+		float star = step(0.78, h) * exp(-dot(f - off * 0.6, f - off * 0.6) * 90.0) * (0.55 + 0.45 * sin(TIME * (1.5 + h * 3.0) + h * 30.0));
+		float rim = exp(-pow((r - 0.93) / 0.07, 2.0));
+		vec3 sky = mix(vec3(0.16, 0.08, 0.38), vec3(0.46, 0.26, 0.74), smoothstep(0.9, 0.1, r));
+		p = (sky * 0.75 + col_a * (arms * 1.3 + dust) + col_b * (core + star * 1.4)) * inside + col_a * rim * 0.8;
+		a = inside * 0.86;
+	} else if (kind == 3) {
+		float inside = smoothstep(1.0, 0.97, r);
+		float edge = pow(r, 2.5);
+		float swirl = 0.5 + 0.5 * sin(th * 3.0 + r * 7.0 - TIME * 0.5 + seed);
+		float hl = exp(-dot(q - vec2(-0.38, 0.46), q - vec2(-0.38, 0.46)) * 10.0);      // 左上一点高光
+		a = inside * mix(0.42, 0.7, edge);
+		p = (mix(col_a * 0.8, col_a, edge) * a + col_b * (swirl * 0.07 * (1.0 - edge) + hl * 0.16)) * inside;
+	} else {
+		// 蜷着的小人：头、身子、腿、手几个椭圆软软地并起来
+		float d = sd_ellipse(q, vec2(-0.2, 0.3), vec2(0.29, 0.29));                    // 头（脸朝左）
+		d = smin(d, sd_ellipse(q, vec2(0.17, 0.0), vec2(0.26, 0.4)), 0.1);            // 弓着的背
+		d = smin(d, sd_ellipse(q, vec2(-0.06, -0.35), vec2(0.3, 0.16)), 0.1);         // 蜷上来的腿
+		d = smin(d, sd_ellipse(q, vec2(-0.13, -0.05), vec2(0.15, 0.075)), 0.06);      // 抱在胸前的手
+		float breathe = 0.9 + 0.1 * sin(TIME * 1.6 + seed);
+		float body = smoothstep(0.02, -0.03, d);
+		float glow = exp(-max(d, 0.0) * 7.0) * 0.55;
+		float shade = 0.86 + 0.14 * smoothstep(-0.25, 0.0, d);          // 边上亮、里面柔
+		float orb = smoothstep(0.98, 0.7, r);
+		float orb_rim = exp(-pow((r - 0.9) / 0.05, 2.0)) * 0.7;
+		p = (col_b * body * shade + col_a * (glow * 0.6 + orb * 0.12 + orb_rim * 0.8)) * breathe;
+		a = body * 0.9 + orb * 0.3;
+		p *= smoothstep(1.0, 0.95, r);
+		a *= smoothstep(1.0, 0.95, r);
+	}
+	float k = power * smoothstep(0.0, 0.6, reveal) * mix(1.0, rear, float(FRONT_FACING));
+	ALBEDO = halo_albedo(p * k, a * k);
+	ALPHA = a * k;
+}
diff -ruN '--exclude=*.uid' mini_before/shaders/realm_halo_inc.gdshaderinc mini_after/shaders/realm_halo_inc.gdshaderinc
--- mini_before/shaders/realm_halo_inc.gdshaderinc	1970-01-01 08:00:00.000000000 +0800
+++ mini_after/shaders/realm_halo_inc.gdshaderinc	2026-11-23 23:26:44.083373500 +0800
@@ -0,0 +1,43 @@
+// 境界光环特效（scripts/realm_halo.gd）三个着色器共用的出口。
+// 都用预乘混合：屏幕 = 颜色 + (1 − 遮挡度) × 背景 —— 实心的金 / 玉 / 晶体给遮挡度，柔光遮挡度给 0（纯加亮），一遍画完。
+// 颜色都按「显示出来的颜色」写。兼容渲染器（网页 / 手机）就在显示色空间里混合，原样给；
+// Forward+ 在线性空间里混合，直接转线性的话柔光会弱很多，按「背后是中等亮度的背景」换算成线性空间里等效的加数
+// （2026-11-23 实测过，标定工具留底在 _tasks/realm_halo/v1_sprite/blend_calib.gd.txt）。
+uniform float power = 1.0;        // 整体强度（觉醒的淡入淡出）
+uniform float rear_push = 0.0;    // 镜头在人身后时，把深度往远处推这么多米（0 = 不推）
+
+// 光环立在人的背后，游戏里镜头也在人身后 —— 光环夹在镜头和人中间，会盖在人身上。
+// 所以镜头在光环背面那一侧时，只把「深度」沿视线往远处推到人的后面（屏幕上的位置、大小都不变）：
+// 人照常画在它前面，和原画一样是「人在前、环在后」；从正面 / 侧面看时不推，就是它本来的位置。
+vec4 halo_clip(vec3 view_pos, vec3 view_n, mat4 proj) {
+	vec4 clip = proj * vec4(view_pos, 1.0);
+	if (rear_push > 0.0) {
+		float len = max(length(view_pos), 0.01);
+		float facing = dot(view_n, -view_pos / len);
+		float d = rear_push * smoothstep(0.0, 0.2, facing);
+		vec4 far = proj * vec4(view_pos * ((len + d) / len), 1.0);
+		clip.z = far.z / far.w * clip.w;
+	}
+	return clip;
+}
+
+vec3 halo_lin(vec3 c) {
+	return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c));
+}
+
+vec3 halo_albedo(vec3 p, float a) {
+#if CURRENT_RENDERER == RENDERER_COMPATIBILITY
+	return p;
+#else
+	vec3 under = vec3(0.4) * (1.0 - a);
+	return max(halo_lin(p + under) - halo_lin(vec3(0.4)) * (1.0 - a), vec3(0.0));
+#endif
+}
+
+float halo_hash(float n) {
+	return fract(sin(n * 127.1) * 43758.5453);
+}
+
+float halo_hash2(vec2 p) {
+	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
+}
diff -ruN '--exclude=*.uid' mini_before/shaders/realm_halo_ring.gdshader mini_after/shaders/realm_halo_ring.gdshader
--- mini_before/shaders/realm_halo_ring.gdshader	1970-01-01 08:00:00.000000000 +0800
+++ mini_after/shaders/realm_halo_ring.gdshader	2026-11-23 23:26:44.109458200 +0800
@@ -0,0 +1,105 @@
+// 境界光环特效 · 环带（scripts/realm_halo.gd）。画在环形网格上：UV.x = 沿环一圈 0~1（0 在正上方），UV.y = 从内沿到外沿 0~1。
+// 所以不用逐像素算极坐标，只有环带那一圈像素要画。style：
+//   0 光线：一道细亮线 + 两侧柔光，上面有流光在跑（炼气的白环、绕身的光轨）
+//   1 实环：两道亮边夹着环身，环身上刻着交织的绳纹（筑基的玉环、结丹 / 炼虚 / 合体的金环、元婴的紫金环）
+//   2 符文圈：内外两道细线，中间一格一格的符文在亮（大乘）
+//   3 断环：一段一段的弧刃，一头宽一头尖（化神的碎环）
+//   4 云气：一缕缕流动的雾（炼气绕身的云气）
+shader_type spatial;
+render_mode unshaded, blend_premul_alpha, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;
+
+#include "res://shaders/realm_halo_inc.gdshaderinc"
+
+uniform int style = 0;
+uniform vec3 col_a = vec3(1.0);           // 环身 / 线的颜色
+uniform vec3 col_b = vec3(1.0, 0.85, 0.5);   // 亮边 / 花纹的颜色
+uniform float count = 24.0;               // 花纹 / 符文 / 弧刃的个数
+uniform float flow = 0.3;                 // 流光跑多快（圈 / 秒）
+uniform float solid = 0.0;                // 环身多实（0 = 纯光）
+uniform float reveal = 1.0;               // 展开：从正上方往两边画出来
+uniform float rear = 1.0;                 // 从背面（镜头在人身后）看时的强度
+uniform float seed = 0.0;
+
+void vertex() {
+	vec3 vp = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	vec3 vn = normalize((MODELVIEW_MATRIX * vec4(0.0, 0.0, 1.0, 0.0)).xyz);
+	POSITION = halo_clip(vp, vn, PROJECTION_MATRIX);
+}
+
+void fragment() {
+	float u = UV.x;
+	float v = UV.y;
+	float dv = abs(v - 0.5) * 2.0;        // 0 环带中线，1 边沿
+	// c 本色、cov 盖住的范围、op 多实、g 额外加的光（流光）。亮边是盖在环身上的，不是加上去的
+	vec3 c = col_a;
+	float cov = 0.0;
+	float op = 0.0;
+	float g = 0.0;
+	float shine = pow(max(sin((u - TIME * flow) * 6.2831 * 2.0 + seed), 0.0), 10.0);      // 沿环跑的两段流光
+	if (style == 0) {
+		float line = exp(-pow(dv / 0.18, 2.0));
+		float haze = exp(-dv * 3.0) * 0.3;
+		float breathe = 0.85 + 0.15 * sin(TIME * 1.7 + u * 12.566);
+		c = mix(col_a, col_b, line * 0.6);
+		cov = clamp(line * breathe + haze, 0.0, 1.0);
+		op = line * solid;
+		g = shine * line * 0.8;
+	} else if (style == 1) {
+		cov = smoothstep(1.0, 0.86, dv);
+		float edge = smoothstep(0.6, 0.76, dv);
+		// 绳纹：两股正弦线交织
+		float w = sin(u * 6.2831 * count);
+		float s1 = exp(-pow((v - 0.5 - 0.17 * w) / 0.07, 2.0));
+		float s2 = exp(-pow((v - 0.5 + 0.17 * w) / 0.07, 2.0));
+		float knot = max(s1, s2) * smoothstep(0.62, 0.5, dv);
+		float lit = 0.7 + 0.3 * (1.0 - v);          // 外沿暗一点、内沿亮一点，有点厚度
+		c = mix(col_a * lit, col_b, clamp(edge + knot * 0.75, 0.0, 1.0));
+		c = mix(c, vec3(1.0), shine * 0.55);
+		op = solid;
+	} else if (style == 2) {
+		float rails = exp(-pow((dv - 0.9) / 0.06, 2.0));
+		float cell = floor(u * count);
+		vec2 f = vec2(fract(u * count), v);
+		float glyph = 0.0;
+		for (int i = 0; i < 4; i++) {
+			float h1 = halo_hash(cell * 7.13 + float(i) * 1.7 + seed);
+			float h2 = halo_hash(cell * 3.71 + float(i) * 5.3 + seed);
+			float h3 = halo_hash(cell * 9.17 + float(i) * 2.9 + seed);
+			vec2 cc = vec2(0.28 + 0.44 * h1, 0.3 + 0.4 * h2);
+			vec2 d = abs(f - cc);
+			// 横画或竖画
+			float bar = h3 > 0.5 ? step(d.x, 0.2) * exp(-pow(d.y / 0.04, 2.0)) : step(d.y, 0.17) * exp(-pow(d.x / 0.055, 2.0));
+			glyph = max(glyph, bar);
+		}
+		glyph *= step(0.12, f.x) * step(f.x, 0.88);
+		float blink = 0.65 + 0.35 * sin(TIME * 2.3 + cell * 1.9);
+		c = mix(col_a, col_b, rails);
+		cov = clamp(rails + glyph * blink, 0.0, 1.0);
+		op = solid;
+		g = shine * rails * 0.6;
+	} else if (style == 3) {
+		float fu = fract(u * count + seed);
+		float body_u = smoothstep(0.0, 0.05, fu) * smoothstep(0.86, 0.8, fu);
+		float half = mix(0.22, 1.0, pow(1.0 - fu / 0.86, 0.8));       // 一头宽一头尖
+		cov = body_u * smoothstep(half, half - 0.1, dv);
+		float edge = smoothstep(half - 0.34, half - 0.16, dv);
+		float facet = 0.62 + 0.38 * step(0.5, v);                     // 晶体的两个面一明一暗
+		float pat = 0.5 + 0.5 * sin(fu * 60.0);
+		c = mix(col_a * facet * (0.8 + 0.2 * pat), col_b, edge);
+		c = mix(c, vec3(1.0), shine * 0.5);
+		op = solid;
+	} else {
+		float band = exp(-pow(dv / 0.55, 2.0));
+		float wisp = 0.5 + 0.5 * sin((u * count - TIME * flow * 6.0) * 6.2831 + v * 5.0 + seed);
+		float wisp2 = 0.5 + 0.5 * sin((u * (count * 0.5 + 1.0) + TIME * flow * 3.0) * 6.2831 - v * 3.0);
+		cov = band * wisp * wisp * (0.35 + 0.65 * wisp2);
+	}
+	// 展开：u = 0 在正上方，往两边画
+	float side = min(u, 1.0 - u) * 2.0;
+	float shown = smoothstep(reveal * 1.08, reveal * 1.08 - 0.08, side);
+	float k = power * shown * mix(1.0, rear, float(FRONT_FACING));
+	vec3 p = (c * cov + col_b * g) * k;
+	float a = cov * op * k;
+	ALBEDO = halo_albedo(p, a);
+	ALPHA = a;
+}
